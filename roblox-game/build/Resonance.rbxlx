      <Item class="Script" referent="21">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Точка входа сервера: строит стадион и запускает все системы.

local RunService = game:GetService("RunService")
local StarterPlayer = game:GetService("StarterPlayer")

local Server = script.Parent

local Physics = require(Server.Physics)
local Net = require(Server.Net)
local FieldBuilder = require(Server.FieldBuilder)
local Actors = require(Server.Actors)
local Ball = require(Server.BallService)
local Match = require(Server.MatchService)
local PlayerService = require(Server.PlayerService)
local Actions = require(Server.ActionService)
local Bots = require(Server.BotService)

-- Камера и прыжок.
StarterPlayer.CameraMaxZoomDistance = 40
StarterPlayer.CameraMinZoomDistance = 6
StarterPlayer.EnableMouseLockOption = true

Physics.init()
FieldBuilder.ensureTeams()
FieldBuilder.build()
Ball.init()
PlayerService.init()
Actions.init()
Bots.init()
Match.init()

-- Одна ошибка в кадре не должна останавливать игру; повторяющиеся сообщения не спамим.
local lastWarning = {}
local function guarded(name: string, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		local now = os.clock()
		if not lastWarning[name] or now - lastWarning[name] > 5 then
			lastWarning[name] = now
			warn(string.format("[%s] %s", name, tostring(err)))
		end
	end
end

RunService.Heartbeat:Connect(function(dt)
	-- Порядок важен: сначала состояние игроков, затем мяч (он отпускает исчезнувшего владельца),
	-- и только потом боты и отборы, которые смотрят, у кого мяч.
	guarded("Actors", Actors.step, dt)
	guarded("Ball", Ball.step, dt)
	guarded("Bots", Bots.step, dt)
	guarded("Actions", Actions.step)
end)

print(string.format("[%s] server started, RemoteEvents: %s", "Resonance", Net.Action:GetFullName()))
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">MatchService</string>
          <string name="Source"><![CDATA[-- Ход матча: розыгрыш с центра -> игра -> гол -> розыгрыш ... -> финальный свисток -> новый матч.
-- Состояние для интерфейса лежит в атрибутах ReplicatedStorage.MatchState.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local F = require(Shared.FieldSpec)
local Actors = require(script.Parent.Actors)
local Ball = require(script.Parent.BallService)
local FieldBuilder = require(script.Parent.FieldBuilder)
local Net = require(script.Parent.Net)

local MATCH = Config.Match
local RES = Config.Resonance

local Match = {}

Match.phase = "Waiting" -- Waiting | Kickoff | Playing | Goal | FullTime
Match.score = { Home = 0, Away = 0 }
Match.timeLeft = MATCH.Duration

local state = Instance.new("Folder")
state.Name = "MatchState"

local pendingGoal = nil

-- Расстановка: { доля половины поля от своих ворот, доля половины ширины }.
local SLOTS = {
	{ 0.8, 0 },
	{ 0.62, -0.4 },
	{ 0.62, 0.4 },
	{ 0.42, -0.2 },
	{ 0.42, 0.2 },
	{ 0.52, 0 },
	{ 0.3, -0.5 },
	{ 0.3, 0.5 },
	{ 0.2, 0 },
}

local function formatTime(seconds: number): string
	local whole = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", whole // 60, whole % 60)
end

local function replicate()
	state:SetAttribute("Home", Match.score.Home)
	state:SetAttribute("Away", Match.score.Away)
	state:SetAttribute("TimeLeft", math.max(0, math.ceil(Match.timeLeft)))
	local scoreText = string.format("%d : %d", Match.score.Home, Match.score.Away)
	local timeText = formatTime(Match.timeLeft)
	for _, label in ipairs(FieldBuilder.scoreLabels) do
		label.Text = scoreText
	end
	for _, label in ipairs(FieldBuilder.timeLabels) do
		label.Text = timeText
	end
end

local function setPhase(phase: string)
	Match.phase = phase
	Actors.live = phase == "Playing"
	state:SetAttribute("Phase", phase)
end

function Match.isLive(): boolean
	return Match.phase == "Playing"
end

local function actorName(actor): string
	if not actor then
		return ""
	end
	if actor.player then
		return actor.player.DisplayName
	end
	return actor.character.Name
end

local function ballSpot(): Vector3
	return F.Origin + Vector3.new(0, Config.Ball.Radius + 0.05, 0)
end

-- Поставить актёра на позицию. index — номер в команде, isKicker — разыгрывает мяч с центра.
function Match.place(actor, index: number, isKicker: boolean)
	local position
	if actor.isKeeper then
		position = F.fromOwnGoal(actor.side, 5, 0)
	elseif isKicker then
		position = F.fromOwnGoal(actor.side, F.HalfLength - 3.4, 0)
	else
		local slot = SLOTS[((index - 1) % #SLOTS) + 1]
		position = F.fromOwnGoal(actor.side, slot[1] * F.HalfLength, slot[2] * F.HalfWidth)
	end
	Actors.teleport(actor, position, F.attackDir(actor.side))
end

-- Игрок появился посреди матча.
function Match.placeLate(actor)
	local index = #Actors.teamList(actor.team, false) + 1
	Match.place(actor, index, false)
	Actors.setFrozen(actor, Match.phase == "Kickoff")
end

local function sortedTeam(team: string)
	local list = Actors.teamList(team, false)
	table.sort(list, function(a, b)
		return actorName(a) < actorName(b)
	end)
	return list
end

local function placeEveryone(kickoffTeam: string)
	for _, team in ipairs({ "Home", "Away" }) do
		for index, actor in ipairs(sortedTeam(team)) do
			-- У разыгрывающей команды первый игрок встаёт к мячу, остальные сдвигаются на слот назад.
			local isKicker = team == kickoffTeam and index == 1
			Match.place(actor, team == kickoffTeam and index - 1 or index, isKicker)
		end
	end
	for _, actor in pairs(Actors.byCharacter) do
		if actor.isKeeper and actor.alive then
			Match.place(actor, 1, false)
		end
		if actor.alive then
			Actors.setFrozen(actor, true)
		end
	end
end

local function unfreezeEveryone()
	for _, actor in pairs(Actors.byCharacter) do
		Actors.setFrozen(actor, false)
	end
end

local function kickoff(kickoffTeam: string)
	setPhase("Kickoff")
	Ball.active = false
	Ball.reset(ballSpot(), true)
	placeEveryone(kickoffTeam)
	replicate()

	for n = MATCH.KickoffCountdown, 1, -1 do
		state:SetAttribute("Countdown", n)
		Net.fx("Countdown", { n = n, team = kickoffTeam })
		task.wait(1)
	end
	state:SetAttribute("Countdown", 0)

	unfreezeEveryone()
	Ball.setFrozen(false)
	Ball.active = true
	setPhase("Playing")
	Net.fx("Whistle", { kind = "Kickoff" })
end

-- Игра идёт, пока не забьют или не кончится время.
local function playUntilStop()
	pendingGoal = nil
	while Match.timeLeft > 0 do
		local dt = task.wait(0.1)
		if pendingGoal then
			return pendingGoal
		end
		if #Players:GetPlayers() == 0 then
			return "empty"
		end
		Match.timeLeft = math.max(0, Match.timeLeft - dt)
		replicate()
	end
	return pendingGoal
end

local function goalSequence(goal)
	setPhase("Goal")
	Match.score[goal.team] += 1
	replicate()

	local scorer, assist = goal.scorer, goal.assist
	if scorer then
		Actors.addResonance(scorer, RES.Goal)
	end
	if assist then
		Actors.addResonance(assist, RES.Assist)
	end

	Net.fx("Goal", {
		team = goal.team,
		side = goal.side,
		character = scorer and scorer.character or nil,
		scorerName = actorName(scorer),
		assistName = actorName(assist),
		styleId = scorer and scorer.style.id or nil,
		home = Match.score.Home,
		away = Match.score.Away,
		position = Ball.position(),
	})
	task.wait(MATCH.GoalPause)
end

local function fullTime()
	setPhase("FullTime")
	Ball.active = false
	local home, away = Match.score.Home, Match.score.Away
	local winner = "Draw"
	if home > away then
		winner = "Home"
	elseif away > home then
		winner = "Away"
	end
	Net.fx("FullTime", { home = home, away = away, winner = winner })
	task.wait(MATCH.FullTimePause)
end

local function runForever()
	while true do
		setPhase("Waiting")
		Ball.active = false
		Ball.reset(ballSpot(), true)
		Match.score.Home, Match.score.Away = 0, 0
		Match.timeLeft = MATCH.Duration
		replicate()
		while #Players:GetPlayers() == 0 do
			task.wait(0.5)
		end
		task.wait(1.5) -- дать персонажу загрузиться

		local kickoffTeam = math.random() < 0.5 and "Home" or "Away"
		local abandoned = false
		while Match.timeLeft > 0 do
			kickoff(kickoffTeam)
			local result = playUntilStop()
			if result == "empty" then
				abandoned = true
				break
			elseif result then
				goalSequence(result)
				kickoffTeam = result.team == "Home" and "Away" or "Home"
			end
		end
		if not abandoned then
			fullTime()
		end
	end
end

function Match.init()
	state:SetAttribute("Phase", Match.phase)
	state:SetAttribute("Countdown", 0)
	replicate()
	state.Parent = ReplicatedStorage

	Ball.Goal:Connect(function(scoringTeam, scorer, assist, side)
		if Match.phase == "Playing" then
			pendingGoal = { team = scoringTeam, scorer = scorer, assist = assist, side = side }
		end
	end)

	task.spawn(runForever)
end

return Match
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[-- Создаёт RemoteEvent'ы и даёт короткие функции для отправки эффектов клиентам.
--   Action: клиент -> сервер (удар, пас, подкат, способность...)
--   Fx:     сервер -> клиенты (анимации, вспышки, баннеры)

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = {}

local folder = Instance.new("Folder")
folder.Name = "Remotes"

local action = Instance.new("RemoteEvent")
action.Name = "Action"
action.Parent = folder

local fx = Instance.new("RemoteEvent")
fx.Name = "Fx"
fx.Parent = folder

folder.Parent = ReplicatedStorage

Net.Action = action
Net.Fx = fx

function Net.fx(name: string, payload: { [string]: any }?)
	fx:FireAllClients(name, payload or {})
end

function Net.fxTo(player: Player, name: string, payload: { [string]: any }?)
	fx:FireClient(player, name, payload or {})
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">Physics</string>
          <string name="Source"><![CDATA[-- Группы столкновений.
--   Ball       — мяч. Сквозь игроков проходит: приём и блок считает BallService.
--   Characters — все части персонажей.
--   BallOnly   — преграды способностей: останавливают только мяч.

local PhysicsService = game:GetService("PhysicsService")

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Config)

local Physics = {}

Physics.BALL = "Ball"
Physics.CHARACTERS = "Characters"
Physics.BALL_ONLY = "BallOnly"

function Physics.init()
	for _, name in ipairs({ Physics.BALL, Physics.CHARACTERS, Physics.BALL_ONLY }) do
		pcall(function()
			PhysicsService:RegisterCollisionGroup(name)
		end)
	end
	PhysicsService:CollisionGroupSetCollidable(Physics.BALL, Physics.CHARACTERS, false)
	PhysicsService:CollisionGroupSetCollidable(Physics.BALL_ONLY, Physics.CHARACTERS, false)
	PhysicsService:CollisionGroupSetCollidable(Physics.BALL_ONLY, "Default", false)
	PhysicsService:CollisionGroupSetCollidable(Physics.BALL_ONLY, Physics.BALL_ONLY, false)
	PhysicsService:CollisionGroupSetCollidable(Physics.BALL_ONLY, Physics.BALL, true)
	if Config.Player.PlayersCollide == false then
		PhysicsService:CollisionGroupSetCollidable(Physics.CHARACTERS, Physics.CHARACTERS, false)
	end
end

-- Переводит все части модели в группу персонажей (и новые тоже — аксессуары догружаются позже).
function Physics.tagCharacter(character: Model)
	local function apply(instance: Instance)
		if instance:IsA("BasePart") then
			(instance :: BasePart).CollisionGroup = Physics.CHARACTERS
		end
	end
	for _, descendant in ipairs(character:GetDescendants()) do
		apply(descendant)
	end
	character.DescendantAdded:Connect(apply)
end

return Physics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">PlayerService</string>
          <string name="Source"><![CDATA[-- Игроки: распределение по командам, регистрация персонажа как «актёра», командные метки.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Styles = require(Shared.Styles)
local Util = require(Shared.Util)
local Actors = require(script.Parent.Actors)
local FieldBuilder = require(script.Parent.FieldBuilder)
local Match = require(script.Parent.MatchService)
local Physics = require(script.Parent.Physics)

local PlayerService = {}

local teams = {} -- { Home = Team, Away = Team }
local dataByPlayer = {} -- то, что переживает респаун: стиль, резонанс, перезарядки

local function countTeam(key: string): number
	local count = 0
	for _, data in pairs(dataByPlayer) do
		if data.team == key then
			count += 1
		end
	end
	return count
end

-- Диск под ногами и табличка с именем в цвет команды.
local function addKit(actor, displayName: string)
	local team = Config.Teams[actor.team]
	local character = actor.character

	local ring = Instance.new("Part")
	ring.Name = "TeamRing"
	ring.Shape = Enum.PartType.Cylinder
	local ringSize = 5.2 * Config.Player.Scale
	ring.Size = Vector3.new(0.12, ringSize, ringSize)
	ring.Material = Enum.Material.Neon
	ring.Color = team.Color
	ring.Transparency = 0.55
	ring.CanCollide = false
	ring.CanTouch = false
	ring.CanQuery = false
	ring.Massless = true
	ring.CastShadow = false
	ring.CFrame = actor.root.CFrame * CFrame.new(0, -actor.groundOffset + 0.12, 0) * CFrame.Angles(0, 0, math.rad(90))
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = actor.root
	weld.Part1 = ring
	weld.Parent = ring
	ring.Parent = character

	local head = character:FindFirstChild("Head") :: BasePart?
	local tag = Instance.new("BillboardGui")
	tag.Name = "NameTag"
	tag.Size = UDim2.fromOffset(220, 44)
	tag.StudsOffset = Vector3.new(0, 2.7, 0)
	tag.MaxDistance = 240
	tag.LightInfluence = 0
	tag.Adornee = head or actor.root

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "PlayerName"
	nameLabel.BackgroundTransparency = 1
	nameLabel.Size = UDim2.new(1, 0, 0, 24)
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextSize = 18
	nameLabel.TextColor3 = team.Color:Lerp(Color3.new(1, 1, 1), 0.25)
	nameLabel.TextStrokeTransparency = 0.35
	nameLabel.Text = displayName
	nameLabel.Parent = tag

	local styleLabel = Instance.new("TextLabel")
	styleLabel.Name = "StyleName"
	styleLabel.BackgroundTransparency = 1
	styleLabel.Position = UDim2.fromOffset(0, 24)
	styleLabel.Size = UDim2.new(1, 0, 0, 18)
	styleLabel.Font = Enum.Font.GothamMedium
	styleLabel.TextSize = 13
	styleLabel.TextStrokeTransparency = 0.5
	styleLabel.Parent = tag

	local function refreshStyle()
		local style = Styles.get(character:GetAttribute("Style"))
		-- Служебные стили (базовый, вратарь) в табличке не пишем.
		styleLabel.Text = style.selectable == false and "" or Util.upper(style.name)
		styleLabel.TextColor3 = style.color
	end
	refreshStyle()
	character:GetAttributeChangedSignal("Style"):Connect(refreshStyle)

	tag.Parent = head or actor.root
end

PlayerService.addKit = addKit

local WANTED_RIG = Config.Avatar.RigType == "R15" and Enum.HumanoidRigType.R15 or Enum.HumanoidRigType.R6

-- Roblox создал персонажа не того типа (например R15, а игра рассчитана на R6):
-- собираем такого же персонажа — с вещами и цветами игрока — на нужном скелете и подменяем.
-- Возвращает true, если подмена удалась (тогда для нового персонажа сработает CharacterAdded).
local function replaceRig(player: Player, character: Model, humanoid: Humanoid): boolean
	local description: HumanoidDescription? = nil
	pcall(function()
		description = humanoid:GetAppliedDescription()
	end)
	local ok, result = pcall(function()
		return Players:CreateHumanoidModelFromDescription(description or Instance.new("HumanoidDescription"), WANTED_RIG)
	end)
	if not ok or typeof(result) ~= "Instance" then
		warn("[Players] could not rebuild the character as " .. Config.Avatar.RigType .. ": " .. tostring(result))
		return false
	end
	-- Создание модели занимает время: за это время игрок мог выйти или его персонаж мог смениться.
	if not dataByPlayer[player] or player.Character ~= character or not character.Parent then
		result:Destroy()
		return true
	end
	local model = result :: Model
	model.Name = player.Name
	model:PivotTo(character:GetPivot())
	player.Character = model
	model.Parent = Workspace
	character:Destroy()
	return true
end

local function onCharacter(player: Player, character: Model)
	local data = dataByPlayer[player]
	if not data then
		return
	end
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or not root then
		return
	end
	if not character.Parent then
		character.AncestryChanged:Wait()
	end
	task.wait(0.2) -- персонаж должен полностью собраться (HipHeight, аксессуары)
	if not dataByPlayer[player] or player.Character ~= character or not character.Parent then
		return -- игрок вышел или персонаж уже сменился
	end

	if Config.Avatar.ForceRig and humanoid.RigType ~= WANTED_RIG then
		-- Страховка от зацикливания: если пересборка идёт слишком часто, перестаём её делать для этого игрока.
		local now = os.clock()
		if now - (data.lastRebuild or 0) > 15 then
			data.rebuilds = 0
		end
		data.lastRebuild = now
		data.rebuilds = (data.rebuilds or 0) + 1
		if data.rebuilds <= 4 then
			if replaceRig(player, character, humanoid) then
				return
			end
		elseif data.rebuilds == 5 then
			warn("[Players] character rebuild disabled for " .. player.Name .. ": too many retries")
		end
	end

	-- Все персонажи уменьшены (Config.Player.Scale): поле кажется больше, а путь до ворот дольше.
	if Config.Player.Scale ~= 1 then
		character:ScaleTo(Config.Player.Scale)
	end
	Physics.tagCharacter(character)
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None

	local actor = Actors.register(character, { team = data.team, player = player, data = data })
	if not actor then
		return
	end
	addKit(actor, player.DisplayName)

	humanoid.Died:Connect(function()
		Actors.unregister(character)
		-- Обычно Roblox возрождает игрока сам. Если этого не случилось (персонаж был собран нами вручную),
		-- загружаем нового персонажа сами.
		task.delay(Players.RespawnTime + 1.5, function()
			if dataByPlayer[player] and player.Character == character then
				pcall(function()
					player:LoadCharacter()
				end)
			end
		end)
	end)
	character.AncestryChanged:Connect(function(_, parent)
		if not parent then
			Actors.unregister(character)
		end
	end)

	Match.placeLate(actor)
end

local function onPlayer(player: Player)
	local key = countTeam("Home") <= countTeam("Away") and "Home" or "Away"
	local data = {
		team = key,
		styleId = Styles.default,
		resonance = 0,
		cooldowns = {},
	}
	dataByPlayer[player] = data

	player.Neutral = false
	player.Team = teams[key]
	player:SetAttribute("TeamKey", key)
	player:SetAttribute("Style", data.styleId)
	player:SetAttribute("Stamina", Config.Player.MaxStamina)
	player:SetAttribute("MaxStamina", Config.Player.MaxStamina)
	player:SetAttribute("Resonance", 0)

	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end
end

function PlayerService.init()
	teams = FieldBuilder.ensureTeams()
	Players.RespawnTime = 2

	Players.PlayerAdded:Connect(onPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayer, player)
	end

	Players.PlayerRemoving:Connect(function(player)
		if player.Character then
			Actors.unregister(player.Character)
		end
		dataByPlayer[player] = nil
	end)
end

return PlayerService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="26">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">40</float>
      <float name="CameraMinZoomDistance">6</float>
      <token name="GameSettingsAvatar">0</token>
    </Properties>
    <Item class="StarterPlayerScripts" referent="27">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="28">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">BallVisuals</string>
            <string name="Source"><![CDATA[-- Всё, что делает мяч красивым на клиенте: шлейф, вращение при ведении, вспышки при отскоках, метка над мячом
-- и полупрозрачные круги на газоне вокруг игрока с мячом.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local FieldSpec = require(Shared.FieldSpec)
local Fx = require(script.Parent.Fx)
local State = require(script.Parent.State)

local BallVisuals = {}

local R = Config.Ball.Radius
local WHITE = Color3.fromRGB(245, 247, 255)

local ball: BasePart? = nil
local anchor: Part? = nil -- невращающаяся точка в центре мяча: на ней висят шлейф и свет
local trail: Trail? = nil
local glow: PointLight? = nil
local marker: BillboardGui? = nil

local rings = {} -- круги вокруг игрока с мячом: от внешнего к внутреннему
local RINGS = {
	-- радиус, прозрачность, цвет
	{ 10.5, 0.82, Color3.fromRGB(200, 236, 200) },
	{ 7.2, 0.78, Color3.fromRGB(176, 220, 176) },
	{ 4, 0.7, Color3.fromRGB(150, 200, 150) },
}
local trailMode: any = nil -- false = обычный шлейф, Color3 = цветной шлейф способности
local rollAngle = 0
local dribblePhase = 0
local previousVelocity = Vector3.zero
local lastBounce = 0

local function build(part: BasePart)
	ball = part

	local holder = Instance.new("Part")
	holder.Name = "BallAnchor"
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanTouch = false
	holder.CanQuery = false
	holder.Transparency = 1
	holder.Size = Vector3.new(0.2, 0.2, 0.2)
	holder.CFrame = CFrame.new(part.Position)
	holder.Parent = Workspace
	anchor = holder

	local top = Instance.new("Attachment")
	top.Position = Vector3.new(0, R * 0.85, 0)
	top.Parent = holder
	local bottom = Instance.new("Attachment")
	bottom.Position = Vector3.new(0, -R * 0.85, 0)
	bottom.Parent = holder

	local ribbon = Instance.new("Trail")
	ribbon.Attachment0 = top
	ribbon.Attachment1 = bottom
	ribbon.FaceCamera = true
	ribbon.Lifetime = 0.3
	ribbon.MinLength = 0.05
	ribbon.LightEmission = 0.7
	ribbon.Color = ColorSequence.new(WHITE)
	ribbon.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })
	ribbon.Enabled = false
	ribbon.Parent = holder
	trail = ribbon

	local light = Instance.new("PointLight")
	light.Range = 18
	light.Brightness = 0
	light.Shadows = false
	light.Parent = holder
	glow = light

	-- Метка над мячом, чтобы не терять его на большом поле.
	local gui = Instance.new("BillboardGui")
	gui.Name = "BallMarker"
	gui.Size = UDim2.fromOffset(22, 22)
	gui.StudsOffset = Vector3.new(0, 4.5, 0)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Adornee = holder
	local diamond = Instance.new("Frame")
	diamond.AnchorPoint = Vector2.new(0.5, 0.5)
	diamond.Position = UDim2.fromScale(0.5, 0.5)
	diamond.Size = UDim2.fromScale(0.62, 0.62)
	diamond.Rotation = 45
	diamond.BackgroundColor3 = Color3.fromRGB(255, 232, 110)
	diamond.BorderSizePixel = 0
	diamond.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.fromRGB(20, 20, 26)
	stroke.Parent = diamond
	gui.Parent = holder
	marker = gui

	for index, spec in ipairs(RINGS) do
		local disc = Instance.new("Part")
		disc.Name = "BallRing"
		disc.Shape = Enum.PartType.Cylinder
		disc.Anchored = true
		disc.CanCollide = false
		disc.CanTouch = false
		disc.CanQuery = false
		disc.CastShadow = false
		disc.Material = Enum.Material.SmoothPlastic
		disc.Color = spec[3]
		disc.Size = Vector3.new(0.05, spec[1] * 2, spec[1] * 2)
		disc.Transparency = 1
		disc:SetAttribute("Alpha", spec[2])
		disc:SetAttribute("Lift", 0.05 + index * 0.02) -- чуть разная высота, чтобы круги не мерцали
		disc.Parent = Workspace
		rings[index] = disc
	end
end

-- Круги лежат на газоне под тем, у кого мяч; без владельца — скрыты.
local function updateRings(part: BasePart)
	local joint = part:FindFirstChild("BallJoint")
	local carrier = joint and joint:IsA("Motor6D") and joint.Part0 or nil
	local groundY = FieldSpec.Origin.Y
	for _, disc in ipairs(rings) do
		if carrier then
			local p = carrier.Position
			disc.CFrame = CFrame.new(p.X, groundY + disc:GetAttribute("Lift"), p.Z) * CFrame.Angles(0, 0, math.rad(90))
			disc.Transparency = disc:GetAttribute("Alpha")
		elseif disc.Transparency < 1 then
			disc.Transparency = 1
		end
	end
end

local function updateTrail(part: BasePart, held: boolean, speed: number)
	local ribbon, light = trail, glow
	if not ribbon or not light then
		return
	end
	local fxUntil = part:GetAttribute("FxUntil")
	local fxColor = part:GetAttribute("FxColor")
	local special = type(fxUntil) == "number" and State.now() < fxUntil and typeof(fxColor) == "Color3"

	ribbon.Enabled = not held and (special or speed > 45)

	-- Свойства шлейфа меняем только при смене режима, а не каждый кадр.
	local mode = special and fxColor or false
	if mode == trailMode then
		return
	end
	trailMode = mode
	if special then
		ribbon.Color = ColorSequence.new(fxColor, WHITE)
		ribbon.Lifetime = 0.55
		ribbon.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.7), NumberSequenceKeypoint.new(1, 0.3) })
		light.Color = fxColor
		light.Brightness = 3
	else
		ribbon.Color = ColorSequence.new(WHITE)
		ribbon.Lifetime = 0.28
		ribbon.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.2) })
		light.Brightness = 0
	end
end

local function onRender()
	local part = ball
	local holder = anchor
	if not part or not part.Parent or not holder then
		return
	end
	local position = part.Position
	holder.CFrame = CFrame.new(position)

	local held = part:GetAttribute("Held") == true
	updateRings(part)
	local velocity = part.AssemblyLinearVelocity
	local speed = velocity.Magnitude
	updateTrail(part, held, speed)

	-- Метка видна, когда мяч далеко и ни у кого.
	local gui = marker
	local camera = Workspace.CurrentCamera
	if gui and camera then
		gui.Enabled = not held and (camera.CFrame.Position - position).Magnitude > 55
	end

	-- Вспышка при резком отскоке (штанга, борт, газон).
	if not held then
		local change = (velocity - previousVelocity).Magnitude
		local now = os.clock()
		if change > 45 and previousVelocity.Magnitude > 40 and now - lastBounce > 0.12 then
			lastBounce = now
			Fx.sound("Bounce", position, { volume = math.clamp(change / 120, 0.4, 1.5) })
			Fx.disc(Fx.ground(position), WHITE, { from = 1, to = 3 + change * 0.04, time = 0.22, transparency = 0.55 })
		end
	end
	previousVelocity = velocity
end

-- При ведении мяч катится и чуть «убегает» от ноги. Меняем только локальный Transform шва.
local function onStepped(dt: number)
	local part = ball
	if not part or not part.Parent then
		return
	end
	local joint = part:FindFirstChild("BallJoint")
	if not joint or not joint:IsA("Motor6D") then
		rollAngle = 0
		return
	end
	local carrier = joint.Part0
	if not carrier then
		return
	end
	local velocity = carrier.AssemblyLinearVelocity
	local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	rollAngle = (rollAngle + speed / R * dt) % (math.pi * 2)
	local push = 0
	if speed > 2 then
		dribblePhase += dt * (6 + speed * 0.22)
		push = (0.5 + 0.5 * math.sin(dribblePhase)) * math.clamp(speed / 28, 0.2, 1) * 0.9
	end
	joint.Transform = CFrame.new(0, 0, -push) * CFrame.Angles(-rollAngle, 0, 0)
end

function BallVisuals.start()
	task.spawn(function()
		local part = Workspace:WaitForChild("Ball") :: BasePart
		build(part)
		RunService.RenderStepped:Connect(onRender)
		RunService.Stepped:Connect(function(_, dt)
			onStepped(dt)
		end)
	end)
end

return BallVisuals
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Cinematics</string>
            <string name="Source"><![CDATA[-- Dynamic presentation: slanted splash banners (KICK OFF! / GOAL!), radial speed lines,
-- a cinematic goal camera with depth of field, and a wider field of view while sprinting.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage:WaitForChild("Shared").Config)
local Controls = require(script.Parent.Controls)
local FxEvents = require(script.Parent.FxEvents)
local State = require(script.Parent.State)

local Cinematics = {}

local player = Players.LocalPlayer
local gui: ScreenGui
local lines: Frame
local BASE_FOV = 70
local SPRINT_FOV = 82
local cinematicUntil = 0

local function tween(instance: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?, direction: Enum.EasingDirection?)
	local t =
		TweenService:Create(instance, TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), goal)
	t:Play()
	return t
end

---------------------------------------------------------------------------
-- Slanted splash banner
---------------------------------------------------------------------------

-- A tilted colour band sweeps in from the left with big italic text, holds, then sweeps out.
function Cinematics.splash(text: string, color: Color3, hold: number?)
	local band = Instance.new("Frame")
	band.Name = "Splash"
	band.AnchorPoint = Vector2.new(0.5, 0.5)
	band.Position = UDim2.fromScale(-0.6, 0.62)
	band.Size = UDim2.new(1.4, 0, 0, 120)
	band.Rotation = -7
	band.BackgroundColor3 = color
	band.BackgroundTransparency = 0.05
	band.BorderSizePixel = 0
	band.ZIndex = 20
	band.Parent = gui

	local edge = Instance.new("Frame")
	edge.AnchorPoint = Vector2.new(0, 1)
	edge.Position = UDim2.fromScale(0, 0)
	edge.Size = UDim2.new(1, 0, 0, 10)
	edge.BackgroundColor3 = Color3.new(1, 1, 1)
	edge.BorderSizePixel = 0
	edge.ZIndex = 20
	edge.Parent = band

	local label = Instance.new("TextLabel")
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.fromScale(0.5, 0.5)
	label.Size = UDim2.new(0.6, 0, 1.3, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.Text = text
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeColor3 = Color3.fromRGB(10, 14, 32)
	label.TextStrokeTransparency = 0
	label.Rotation = 0
	label.ZIndex = 21
	label.Parent = band

	tween(band, 0.22, { Position = UDim2.fromScale(0.5, 0.62) }, Enum.EasingStyle.Back)
	task.delay(0.22 + (hold or 1.1), function()
		tween(band, 0.25, { Position = UDim2.fromScale(1.7, 0.62) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(0.3, function()
			band:Destroy()
		end)
	end)
end

---------------------------------------------------------------------------
-- Radial speed lines
---------------------------------------------------------------------------

local LINE_COUNT = 36

local function buildLines()
	lines = Instance.new("Frame")
	lines.Name = "SpeedLines"
	lines.Size = UDim2.fromScale(1, 1)
	lines.BackgroundTransparency = 1
	lines.Visible = false
	lines.ZIndex = 15
	lines.Parent = gui
	for i = 1, LINE_COUNT do
		local angle = (i / LINE_COUNT) * 360
		local holder = Instance.new("Frame")
		holder.AnchorPoint = Vector2.new(0.5, 0.5)
		holder.Position = UDim2.fromScale(0.5, 0.5)
		holder.Size = UDim2.fromScale(2, 2)
		holder.Rotation = angle
		holder.BackgroundTransparency = 1
		holder.ZIndex = 15
		holder.Parent = lines
		local streak = Instance.new("Frame")
		streak.Name = "Streak"
		streak.AnchorPoint = Vector2.new(0, 0.5)
		streak.Position = UDim2.fromScale(0.62, 0.5)
		streak.Size = UDim2.new(0.4, 0, 0, 3)
		streak.BackgroundColor3 = Color3.new(1, 1, 1)
		streak.BackgroundTransparency = 0.35
		streak.BorderSizePixel = 0
		streak.ZIndex = 15
		streak.Parent = holder
	end
end

-- Show flickering speed lines around the screen edge for `duration` seconds.
function Cinematics.speedLines(duration: number)
	lines.Visible = true
	local started = os.clock()
	local connection
	connection = RunService.RenderStepped:Connect(function()
		local elapsed = os.clock() - started
		if elapsed >= duration then
			lines.Visible = false
			connection:Disconnect()
			return
		end
		local fade = math.clamp((duration - elapsed) / 0.3, 0, 1)
		for _, holder in ipairs(lines:GetChildren()) do
			local streak = holder:FindFirstChild("Streak") :: Frame?
			if streak then
				streak.Position = UDim2.fromScale(0.55 + math.random() * 0.12, 0.5)
				streak.BackgroundTransparency = 1 - (0.35 + math.random() * 0.45) * fade
			end
		end
	end)
end

---------------------------------------------------------------------------
-- Goal camera
---------------------------------------------------------------------------

local dof: DepthOfFieldEffect

-- Orbit the camera around the scorer with a shallow depth of field, then hand control back.
function Cinematics.goalCamera(character: Model?, duration: number)
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local camera = Workspace.CurrentCamera
	if not root or not camera then
		return
	end
	cinematicUntil = os.clock() + duration
	local previousType = camera.CameraType
	camera.CameraType = Enum.CameraType.Scriptable
	dof.Enabled = true
	local started = os.clock()
	local startAngle = math.random() * math.pi * 2
	local connection
	connection = RunService.RenderStepped:Connect(function()
		local t = os.clock() - started
		if t >= duration or not root.Parent then
			connection:Disconnect()
			dof.Enabled = false
			camera.CameraType = previousType
			camera.FieldOfView = BASE_FOV
			return
		end
		local angle = startAngle + t * 0.9
		local radius = 11 - t * 1.2
		local focus = root.Position + Vector3.new(0, 1.5, 0)
		local eye = focus + Vector3.new(math.cos(angle) * radius, 2.5 + t * 0.6, math.sin(angle) * radius)
		camera.CFrame = CFrame.lookAt(eye, focus)
		camera.FieldOfView = 55 + t * 4
		dof.FocusDistance = (eye - focus).Magnitude
	end)
end

---------------------------------------------------------------------------

function Cinematics.start()
	gui = Instance.new("ScreenGui")
	gui.Name = "Cinematics"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 20
	gui.Parent = player:WaitForChild("PlayerGui")
	buildLines()

	dof = Instance.new("DepthOfFieldEffect")
	dof.Name = "CinematicDOF"
	dof.FarIntensity = 0.6
	dof.NearIntensity = 0.3
	dof.InFocusRadius = 6
	dof.Enabled = false
	dof.Parent = Lighting

	local home, away = Config.Teams.Home, Config.Teams.Away

	FxEvents.on("Whistle", function()
		Cinematics.splash("KICK OFF!", Color3.fromRGB(32, 92, 220), 1.0)
	end)

	FxEvents.on("Goal", function(data)
		local team = Config.Teams[data.team]
		Cinematics.splash("GOAL!", team and team.Color or home.Color, 1.6)
		Cinematics.speedLines(1.8)
		Cinematics.goalCamera(data.character, 3.2)
	end)

	FxEvents.on("Kick", function(data)
		if data.kind == "Shot" and (data.power or 0) > 0.75 and data.character == player.Character then
			Cinematics.speedLines(0.35)
		end
	end)

	FxEvents.on("FullTime", function(data)
		local winner = Config.Teams[data.winner]
		Cinematics.splash("FULL TIME", winner and winner.Color or away.Color:Lerp(home.Color, 0.5), 2.5)
	end)

	-- Wider field of view while sprinting: the pitch rushes past.
	RunService.RenderStepped:Connect(function(dt)
		local camera = Workspace.CurrentCamera
		if not camera or os.clock() < cinematicUntil then
			return
		end
		local humanoid = State.humanoid()
		local moving = humanoid ~= nil and humanoid.MoveDirection.Magnitude > 0.1
		local target = (Controls.sprintHeld and moving) and SPRINT_FOV or BASE_FOV
		camera.FieldOfView += (target - camera.FieldOfView) * math.min(1, dt * 6)
	end)
end

return Cinematics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Controls</string>
            <string name="Source"><![CDATA[-- Управление. Клавиши задаются в Config.Controls; на телефоне появляются сенсорные кнопки.
-- Всё, что должно ощущаться мгновенно (рывок, анимация удара), клиент делает сам сразу,
-- а серверу отправляет запрос — тот проверит и выполнит «по-настоящему».

local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local FieldSpec = require(Shared.FieldSpec)
local Mover = require(Shared.Mover)
local Styles = require(Shared.Styles)
local Util = require(Shared.Util)
local ProcAnimator = require(script.Parent.ProcAnimator)
local State = require(script.Parent.State)

local SHOT, TACKLE, DASH, DRIBBLE = Config.Shot, Config.Tackle, Config.Dash, Config.Dribble
local CONTROLS = Config.Controls
local R = Config.Ball.Radius

local Controls = {}

Controls.charging = false
Controls.charge = 0 -- 0..1, для полоски в HUD
Controls.menuOpen = false -- HUD ставит true, пока открыто меню стилей
Controls.sprintHeld = false
Controls.onDenied = nil :: ((string, string) -> ())? -- HUD показывает, почему действие не сработало

local chargeStart = 0
local faceUntil = 0
local faceDir: Vector3? = nil
local autoRotateOff = false
local locks = {} -- защита от двойного срабатывания, пока сервер не подтвердил перезарядку
local dots = {} -- точки предпросмотра траектории

---------------------------------------------------------------------------
-- Прицеливание
---------------------------------------------------------------------------

local function cameraLook(): Vector3
	local camera = Workspace.CurrentCamera
	if camera then
		return camera.CFrame.LookVector
	end
	local root = State.root()
	return root and root.CFrame.LookVector or Vector3.new(0, 0, -1)
end

-- Куда смотрит камера, без наклона.
function Controls.aimFlat(): Vector3
	local root = State.root()
	return Util.flatUnit(cameraLook(), root and Util.flatUnit(root.CFrame.LookVector) or nil)
end

-- Направление удара: камера + базовый подъём. Смотришь выше — мяч летит выше.
function Controls.shotDirection(): Vector3
	local look = cameraLook()
	local pitch = math.deg(math.asin(math.clamp(look.Y, -1, 1)))
	local elevation = math.clamp(pitch + SHOT.BaseElevation, SHOT.MinElevation, SHOT.MaxElevation)
	return Util.withElevation(Controls.aimFlat(), elevation)
end

local function moveDirection(): Vector3
	local humanoid = State.humanoid()
	if humanoid and humanoid.MoveDirection.Magnitude > 0.1 then
		return Util.flatUnit(humanoid.MoveDirection)
	end
	return Vector3.zero
end

local function canAct(): boolean
	return State.isLive() and not State.isStunned() and not Controls.menuOpen and State.root() ~= nil
end

local function locked(key: string): boolean
	local untilTime = locks[key]
	return untilTime ~= nil and os.clock() < untilTime
end

local function lock(key: string, seconds: number)
	locks[key] = os.clock() + seconds
end

local function deny(key: string, reason: string)
	if Controls.onDenied then
		Controls.onDenied(key, reason)
	end
end

local function face(direction: Vector3, seconds: number)
	faceDir = Util.flatUnit(direction)
	faceUntil = os.clock() + seconds
end

---------------------------------------------------------------------------
-- Удар с зарядом
---------------------------------------------------------------------------

local function stopCharge(notifyServer: boolean)
	if not Controls.charging then
		return
	end
	Controls.charging = false
	Controls.charge = 0
	ProcAnimator.stop(State.character(), "ChargeHold")
	if notifyServer then
		State.send("Charge", false)
	end
end

local function beginCharge()
	if Controls.charging or not canAct() then
		return
	end
	if not State.hasBall() then
		return
	end
	Controls.charging = true
	Controls.charge = 0
	chargeStart = os.clock()
	ProcAnimator.play(State.character(), "ChargeHold")
	State.send("Charge", true)
end

local function releaseShot()
	if not Controls.charging then
		return
	end
	local charge = math.clamp((os.clock() - chargeStart) / SHOT.ChargeTime, 0, 1)
	local direction = Controls.shotDirection()
	local character = State.character()
	Controls.charging = false
	Controls.charge = 0
	ProcAnimator.stop(character, "ChargeHold")
	if State.hasBall() and canAct() then
		ProcAnimator.play(character, "Shoot")
		face(direction, 0.3)
		State.send("Shoot", direction, charge)
	else
		State.send("Charge", false)
	end
end

local function doPass(kind: string)
	if not canAct() or not State.hasBall() or locked("Pass") then
		return
	end
	lock("Pass", 0.25)
	stopCharge(false)
	local direction = Controls.aimFlat()
	ProcAnimator.play(State.character(), kind)
	face(direction, 0.25)
	State.send(kind, direction)
end

---------------------------------------------------------------------------
-- Подкат, дриблинг и рывок
---------------------------------------------------------------------------

local function doTackle()
	if not canAct() or locked("Tackle") or State.cooldown("Tackle") > 0 then
		return
	end
	if State.stamina() < TACKLE.Stamina then
		deny("Action", "NO STAMINA")
		return
	end
	local root = State.root()
	if not root then
		return
	end
	local direction = moveDirection()
	if direction.Magnitude < 0.1 then
		direction = Util.flatUnit(root.CFrame.LookVector)
	end
	lock("Tackle", 0.6)
	Mover.dash(root, direction, TACKLE.Speed, TACKLE.Duration * 0.9)
	ProcAnimator.play(State.character(), "Slide")
	face(direction, TACKLE.Duration)
	State.send("Tackle", direction)
end

-- Дриблинг: короткий резкий уход с мячом в сторону движения. В этот момент подкат не проходит.
local function doDribble()
	if not canAct() or locked("Dribble") or State.cooldown("Dribble") > 0 then
		return
	end
	if State.stamina() < DRIBBLE.Stamina then
		deny("Action", "NO STAMINA")
		return
	end
	local root = State.root()
	if not root then
		return
	end
	local direction = moveDirection()
	if direction.Magnitude < 0.1 then
		direction = Util.flatUnit(root.CFrame.LookVector)
	end
	lock("Dribble", 0.5)
	stopCharge(false)
	Mover.dash(root, direction, DRIBBLE.Speed, DRIBBLE.Duration)
	ProcAnimator.play(State.character(), "Dribble")
	State.send("Dribble", direction)
end

-- Одна клавиша: с мячом — дриблинг, без мяча — подкат.
local function doAction()
	if State.hasBall() then
		doDribble()
	else
		doTackle()
	end
end

local function doDash()
	if not canAct() or locked("Dash") or State.cooldown("Dash") > 0 then
		return
	end
	if State.stamina() < DASH.Stamina then
		deny("Dash", "NO STAMINA")
		return
	end
	local root = State.root()
	if not root then
		return
	end
	local direction = moveDirection()
	if direction.Magnitude < 0.1 then
		direction = Controls.aimFlat()
	end
	lock("Dash", 0.5)
	stopCharge(true)
	Mover.dash(root, direction, DASH.Speed, DASH.Duration)
	ProcAnimator.play(State.character(), "Dash")
	State.send("Dash", direction)
end

---------------------------------------------------------------------------
-- Способности стиля
---------------------------------------------------------------------------

-- То, что получает функция predict способности.
local me = {}

function me.dash(direction: Vector3, speed: number, duration: number)
	local root = State.root()
	if root then
		Mover.dash(root, direction, speed, duration)
	end
end

function me.blink(direction: Vector3, distance: number)
	local root = State.root()
	if root then
		Mover.blink(root, direction, distance)
	end
end

function me.anim(name: string)
	ProcAnimator.play(State.character(), name)
end

local function doAbility(slot: number)
	if not canAct() then
		return
	end
	local ability = State.style().abilities[slot]
	if not ability then
		return
	end
	local key = "A" .. slot
	if locked(key) or State.cooldown(key) > 0 then
		return
	end
	local hasBall = State.hasBall()
	if ability.needsBall and not hasBall then
		deny(key, "NEED THE BALL")
		return
	end
	if ability.needsNoBall and hasBall then
		deny(key, "ONLY WITHOUT THE BALL")
		return
	end
	if ability.ultimate and State.resonance() < Config.Resonance.Max then
		deny(key, "RESONANCE NOT FULL")
		return
	end

	lock(key, 0.7)
	stopCharge(false)
	local aim = Controls.aimFlat()
	local look = Controls.shotDirection()
	local move = moveDirection()
	if ability.predict then
		local ok, err = pcall(ability.predict, me, { aim = aim, aimLook = look, move = move, hasBall = hasBall })
		if not ok then
			warn("[Ability] predict: " .. tostring(err))
		end
	end
	if ability.needsBall then
		face(aim, 0.5)
	end
	State.send("Ability", slot, look, move)
end

---------------------------------------------------------------------------
-- Каждый кадр
---------------------------------------------------------------------------

local function hideDots()
	for _, dot in ipairs(dots) do
		dot.Transparency = 1
	end
end

-- Пунктир траектории, пока игрок держит удар.
local function updatePreview()
	if not Controls.charging then
		if #dots > 0 and dots[1].Transparency < 1 then
			hideDots()
		end
		return
	end
	local root, humanoid = State.root(), State.humanoid()
	if not root or not humanoid then
		return
	end
	if #dots == 0 then
		for i = 1, 12 do
			local dot = Instance.new("Part")
			dot.Name = "AimDot"
			dot.Shape = Enum.PartType.Ball
			dot.Size = Vector3.new(0.55, 0.55, 0.55)
			dot.Anchored = true
			dot.CanCollide = false
			dot.CanTouch = false
			dot.CanQuery = false
			dot.CastShadow = false
			dot.Material = Enum.Material.Neon
			dot.Transparency = 1
			dot.Parent = Workspace
			dots[i] = dot
		end
	end

	local style = State.style()
	local direction = Controls.shotDirection()
	local power = Util.lerp(SHOT.MinPower, SHOT.MaxPower, Controls.charge) * (style.stats.shot or 1)
	local gravity = Workspace.Gravity * Config.Ball.GravityScale
	local groundOffset = Util.groundOffset(root, humanoid)
	local start = root.Position - Vector3.new(0, groundOffset - R, 0) + Util.flatUnit(direction) * Config.Ball.HoldDistance
	local floor = FieldSpec.Origin.Y + R * 0.5
	local landed = false
	for i, dot in ipairs(dots) do
		local t = i * 0.065
		local point = start + direction * power * t - Vector3.new(0, 0.5 * gravity * t * t, 0)
		if landed or point.Y < floor then
			landed = true
			dot.Transparency = 1
		else
			dot.Color = style.color
			dot.CFrame = CFrame.new(point)
			dot.Transparency = 0.2 + i * 0.05
		end
	end
end

local function onRender()
	local humanoid, root = State.humanoid(), State.root()
	if not humanoid or not root then
		Controls.charging = false
		Controls.charge = 0
		hideDots()
		return
	end

	if Controls.charging then
		if not State.hasBall() or not canAct() then
			stopCharge(true)
		else
			Controls.charge = math.clamp((os.clock() - chargeStart) / SHOT.ChargeTime, 0, 1)
		end
	end

	-- Во время замаха и удара персонаж смотрит туда же, куда камера.
	local now = os.clock()
	if Controls.charging or now < faceUntil then
		humanoid.AutoRotate = false
		autoRotateOff = true
		local direction = Controls.charging and Controls.aimFlat() or (faceDir or Controls.aimFlat())
		local target = CFrame.lookAt(root.Position, root.Position + direction)
		root.CFrame = root.CFrame:Lerp(target, 0.35)
	elseif autoRotateOff then
		autoRotateOff = false
		humanoid.AutoRotate = true
	end

	updatePreview()
end

---------------------------------------------------------------------------
-- Привязка клавиш
---------------------------------------------------------------------------

local function toInputs(names: { string })
	local inputs = {}
	for _, name in ipairs(names) do
		local ok, key = pcall(function()
			return (Enum.KeyCode :: any)[name]
		end)
		if ok and key then
			table.insert(inputs, key)
		else
			local ok2, inputType = pcall(function()
				return (Enum.UserInputType :: any)[name]
			end)
			if ok2 and inputType then
				table.insert(inputs, inputType)
			end
		end
	end
	return inputs
end

local TOUCH_LAYOUT = {
	RS_Shoot = { "SHOOT", UDim2.fromScale(0.52, 0.5) },
	RS_Pass = { "PASS", UDim2.fromScale(0.26, 0.62) },
	RS_Lob = { "LOB", UDim2.fromScale(0.26, 0.36) },
	RS_Action = { "TACKLE/DRIBBLE", UDim2.fromScale(0.52, 0.24) },
	RS_Dash = { "DASH", UDim2.fromScale(0.78, 0.24) },
	RS_Sprint = { "SPRINT", UDim2.fromScale(0.02, 0.5) },
	RS_Ability1 = { "I", UDim2.fromScale(0.02, 0.1) },
	RS_Ability2 = { "II", UDim2.fromScale(0.26, 0.1) },
	RS_Ability3 = { "ULT", UDim2.fromScale(0.52, 0.0) },
}

local function bind(name: string, inputNames: { string }, handler)
	local touch = TOUCH_LAYOUT[name]
	ContextActionService:BindAction(name, handler, touch ~= nil, table.unpack(toInputs(inputNames)))
	if touch and UserInputService.TouchEnabled then
		pcall(function()
			ContextActionService:SetTitle(name, touch[1])
			ContextActionService:SetPosition(name, touch[2])
		end)
	end
end

local function onPress(fn: () -> ())
	return function(_, inputState: Enum.UserInputState)
		if inputState == Enum.UserInputState.Begin then
			fn()
		end
		return Enum.ContextActionResult.Pass
	end
end

-- Shift занят спринтом, поэтому стандартную блокировку камеры переносим на другую клавишу.
local function moveShiftLock()
	task.spawn(function()
		local scripts = State.player:WaitForChild("PlayerScripts", 10)
		local module = scripts and scripts:WaitForChild("PlayerModule", 10)
		local cameraModule = module and module:WaitForChild("CameraModule", 10)
		local mouseLock = cameraModule and cameraModule:WaitForChild("MouseLockController", 10)
		local bound = mouseLock and mouseLock:WaitForChild("BoundKeys", 10)
		if bound and bound:IsA("StringValue") then
			bound.Value = CONTROLS.ShiftLock
		end
	end)
end

function Controls.start()
	bind("RS_Shoot", CONTROLS.Shoot, function(_, inputState: Enum.UserInputState)
		if inputState == Enum.UserInputState.Begin then
			beginCharge()
		elseif inputState == Enum.UserInputState.End then
			releaseShot()
		elseif inputState == Enum.UserInputState.Cancel then
			stopCharge(true)
		end
		return Enum.ContextActionResult.Pass
	end)

	bind(
		"RS_Pass",
		CONTROLS.Pass,
		onPress(function()
			doPass("Pass")
		end)
	)
	bind(
		"RS_Lob",
		CONTROLS.Lob,
		onPress(function()
			doPass("Lob")
		end)
	)
	bind("RS_Action", CONTROLS.Action, onPress(doAction))
	bind("RS_Dash", CONTROLS.Dash, onPress(doDash))
	-- Способности есть только у стилей; пока стили отключены, клавиши Z/X/C свободны.
	if Styles.enabled then
		for slot = 1, 3 do
			bind(
				"RS_Ability" .. slot,
				(CONTROLS :: any)["Ability" .. slot],
				onPress(function()
					doAbility(slot)
				end)
			)
		end
	end

	-- Бег привязан с высоким приоритетом и «поглощает» клавишу: иначе Shift заодно
	-- переключал бы стандартную блокировку камеры Roblox.
	local function onSprint(_, inputState: Enum.UserInputState, input: InputObject)
		local isTouch = input and input.UserInputType == Enum.UserInputType.Touch
		if isTouch then
			-- На телефоне бег — переключатель.
			if inputState == Enum.UserInputState.Begin then
				Controls.sprintHeld = not Controls.sprintHeld
				State.send("Sprint", Controls.sprintHeld)
			end
		elseif inputState == Enum.UserInputState.Begin then
			Controls.sprintHeld = true
			State.send("Sprint", true)
		elseif inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then
			Controls.sprintHeld = false
			State.send("Sprint", false)
		end
		return Enum.ContextActionResult.Sink
	end
	ContextActionService:BindActionAtPriority(
		"RS_Sprint",
		onSprint,
		true,
		Enum.ContextActionPriority.High.Value,
		table.unpack(toInputs(CONTROLS.Sprint))
	)
	if UserInputService.TouchEnabled then
		pcall(function()
			ContextActionService:SetTitle("RS_Sprint", TOUCH_LAYOUT.RS_Sprint[1])
			ContextActionService:SetPosition("RS_Sprint", TOUCH_LAYOUT.RS_Sprint[2])
		end)
	end

	-- После респауна сервер создаёт персонажа заново: напоминаем, что бег зажат.
	State.player.CharacterAdded:Connect(function()
		Controls.charging = false
		autoRotateOff = false
		task.wait(1)
		if Controls.sprintHeld then
			State.send("Sprint", true)
		end
	end)

	RunService:BindToRenderStep("ResonanceControls", Enum.RenderPriority.Character.Value + 1, onRender)
	moveShiftLock()
end

return Controls
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Fx</string>
            <string name="Source"><![CDATA[-- Набор визуальных эффектов. Всё собирается из обычных деталей, частиц и лучей — без загруженных ассетов.
-- Этот же набор получают способности стилей (аргумент fx в функции client).

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local FieldSpec = require(Shared.FieldSpec)
local ProcAnimator = require(script.Parent.ProcAnimator)
local Sfx = require(script.Parent.Sfx)

local Fx = {}

local localPlayer = Players.LocalPlayer
local folder: Folder? = nil
local overlay: Frame? = nil
local shakes = {} -- { magnitude, duration, elapsed }

local function effects(): Folder
	if folder and folder.Parent then
		return folder
	end
	local created = Instance.new("Folder")
	created.Name = "LocalEffects"
	created.Parent = Workspace
	folder = created
	return created
end

local function newPart(
	shape: Enum.PartType,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material,
	transparency: number
): Part
	local part = Instance.new("Part")
	part.Name = "Fx"
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Shape = shape
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material
	part.Transparency = transparency
	part.Parent = effects()
	return part
end

local function tween(instance: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?)
	local info = TweenInfo.new(time, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local t = TweenService:Create(instance, info, goal)
	t:Play()
	return t
end

Fx.tween = tween

local FLAT = CFrame.Angles(0, 0, math.rad(90)) -- цилиндр «лёжа» -> диск на земле

---------------------------------------------------------------------------
-- Справочные функции
---------------------------------------------------------------------------

function Fx.ball(): BasePart?
	return Workspace:FindFirstChild("Ball") :: BasePart?
end

function Fx.rootOf(character: Model?): BasePart?
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function Fx.isLocal(character: Model?): boolean
	return character ~= nil and character == localPlayer.Character
end

-- Точка на газоне под заданной позицией.
function Fx.ground(position: Vector3): Vector3
	return Vector3.new(position.X, FieldSpec.Origin.Y + 0.15, position.Z)
end

function Fx.anim(character: Model?, name: string, options: { [string]: number }?)
	return ProcAnimator.play(character, name, options)
end

function Fx.sound(name: string, where: any, options: { [string]: number }?)
	Sfx.play(name, where, options)
end

-- Повторять fn каждые interval секунд в течение duration.
function Fx.every(duration: number, interval: number, fn: (number) -> ())
	task.spawn(function()
		local elapsed = 0
		while elapsed < duration do
			fn(elapsed)
			elapsed += task.wait(interval)
		end
	end)
end

-- Вызывать fn(dt, elapsed) каждый кадр в течение duration. fn может вернуть false, чтобы остановиться.
function Fx.loop(duration: number, fn: (number, number) -> any)
	local elapsed = 0
	local connection: RBXScriptConnection
	connection = RunService.RenderStepped:Connect(function(dt)
		elapsed += dt
		if elapsed >= duration or fn(dt, elapsed) == false then
			connection:Disconnect()
		end
	end)
	return connection
end

---------------------------------------------------------------------------
-- Простые формы
---------------------------------------------------------------------------

-- Расширяющаяся (или сжимающаяся) энергосфера. from/to — радиусы.
function Fx.sphere(position: Vector3, color: Color3, options: { [string]: any }?)
	local o = options or {}
	local from, to, time = o.from or 2, o.to or 12, o.time or 0.35
	local part = newPart(
		Enum.PartType.Ball,
		Vector3.new(from * 2, from * 2, from * 2),
		CFrame.new(position),
		color,
		o.material or Enum.Material.ForceField,
		o.transparency or 0
	)
	tween(part, time, { Size = Vector3.new(to * 2, to * 2, to * 2), Transparency = 1 })
	Debris:AddItem(part, time + 0.1)
end

-- Светящийся диск на земле.
function Fx.disc(position: Vector3, color: Color3, options: { [string]: any }?)
	local o = options or {}
	local from, to, time = o.from or 2, o.to or 14, o.time or 0.35
	local part = newPart(
		Enum.PartType.Cylinder,
		Vector3.new(0.15, from * 2, from * 2),
		CFrame.new(position) * FLAT,
		color,
		Enum.Material.Neon,
		o.transparency or 0.4
	)
	tween(part, time, { Size = Vector3.new(0.15, to * 2, to * 2), Transparency = 1 })
	Debris:AddItem(part, time + 0.1)
end

-- Столб света вверх.
function Fx.pillar(position: Vector3, color: Color3, options: { [string]: any }?)
	local o = options or {}
	local radius, height, time = o.radius or 2, o.height or 40, o.time or 0.5
	local part = newPart(
		Enum.PartType.Cylinder,
		Vector3.new(height, radius * 2, radius * 2),
		CFrame.new(position + Vector3.new(0, height / 2, 0)) * FLAT,
		color,
		Enum.Material.Neon,
		0.3
	)
	tween(part, time, { Size = Vector3.new(height, 0.2, 0.2), Transparency = 1 })
	Debris:AddItem(part, time + 0.1)
end

-- Разлёт частиц.
function Fx.burst(position: Vector3, color: Color3, options: { [string]: any }?)
	local o = options or {}
	local count, speed, life, size = o.count or 20, o.speed or 20, o.life or 0.5, o.size or 1.1
	local holder = newPart(Enum.PartType.Block, Vector3.new(0.2, 0.2, 0.2), CFrame.new(position), color, Enum.Material.SmoothPlastic, 1)

	local emitter = Instance.new("ParticleEmitter")
	emitter.Rate = 0
	emitter.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
	emitter.LightEmission = 0.8
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
	emitter.Lifetime = NumberRange.new(life * 0.6, life)
	emitter.Speed = NumberRange.new(speed * 0.5, speed)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.Drag = 3
	emitter.Parent = holder

	task.delay(0.03, function()
		if emitter.Parent then
			emitter:Emit(count)
		end
	end)
	Debris:AddItem(holder, life + 0.4)
end

-- Короткая вспышка света.
function Fx.light(position: Vector3, color: Color3, options: { [string]: any }?)
	local o = options or {}
	local time = o.time or 0.4
	local holder = newPart(Enum.PartType.Block, Vector3.new(0.2, 0.2, 0.2), CFrame.new(position), color, Enum.Material.SmoothPlastic, 1)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = o.range or 30
	light.Brightness = o.brightness or 4
	light.Shadows = false
	light.Parent = holder
	tween(light, time, { Brightness = 0 })
	Debris:AddItem(holder, time + 0.1)
end

-- Луч между двумя точками. a и b — Vector3 или BasePart (тогда луч следует за деталью).
function Fx.beam(a: any, b: any, color: Color3, options: { [string]: any }?)
	local o = options or {}
	local width, time = o.width or 1, o.time or 0.5
	local cleanup = {}

	local function attachmentFor(target: any): Attachment
		local attachment = Instance.new("Attachment")
		if typeof(target) == "Vector3" then
			local holder =
				newPart(Enum.PartType.Block, Vector3.new(0.2, 0.2, 0.2), CFrame.new(target), color, Enum.Material.SmoothPlastic, 1)
			attachment.Parent = holder
			table.insert(cleanup, holder)
		else
			attachment.Parent = target
			table.insert(cleanup, attachment)
		end
		return attachment
	end

	local a0, a1 = attachmentFor(a), attachmentFor(b)
	local beam = Instance.new("Beam")
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Width0 = width
	beam.Width1 = width * 0.4
	beam.Color = ColorSequence.new(color)
	beam.Transparency = NumberSequence.new(0.15)
	beam.LightEmission = 1
	beam.FaceCamera = true
	beam.Segments = 1
	beam.Parent = a0
	table.insert(cleanup, beam)

	task.delay(time, function()
		for _, item in ipairs(cleanup) do
			item:Destroy()
		end
	end)
end

---------------------------------------------------------------------------
-- Эффекты на персонаже
---------------------------------------------------------------------------

-- Светящийся силуэт персонажа, который остаётся на месте и гаснет.
function Fx.afterimage(character: Model?, color: Color3, options: { [string]: any }?)
	if not character or not character.Parent then
		return
	end
	local o = options or {}
	local time = o.time or 0.4
	local offset = o.offset or Vector3.zero
	local parent = effects()

	for _, descendant in ipairs(character:GetDescendants()) do
		if descendant:IsA("BasePart") and descendant.Transparency < 0.95 then
			local source = descendant :: BasePart
			local name = source.Name
			local isBody = source.Parent == character
			if name ~= "HumanoidRootPart" and name ~= "TeamRing" and (source:IsA("MeshPart") or isBody) then
				local ghost: BasePart
				if source:IsA("MeshPart") then
					local clone = source:Clone()
					for _, child in ipairs(clone:GetChildren()) do
						child:Destroy()
					end
					clone.TextureID = ""
					ghost = clone
				else
					-- Детали R6 — обычные блоки; голову рисуем кубиком поменьше (у неё сетка, а не форма детали).
					local block = Instance.new("Part")
					block.Size = name == "Head" and Vector3.new(1.25, 1.25, 1.25) or source.Size
					ghost = block
				end
				ghost.Name = "Afterimage"
				ghost.Anchored = true
				ghost.CanCollide = false
				ghost.CanTouch = false
				ghost.CanQuery = false
				ghost.CastShadow = false
				ghost.Massless = true
				ghost.Material = Enum.Material.Neon
				ghost.Color = color
				ghost.Transparency = o.transparency or 0.45
				ghost.CFrame = source.CFrame + offset
				ghost.Parent = parent
				tween(ghost, time, { Transparency = 1 }, Enum.EasingStyle.Linear)
				Debris:AddItem(ghost, time + 0.1)
			end
		end
	end
end

-- Цветной шлейф за корпусом персонажа.
function Fx.charTrail(character: Model?, color: Color3, duration: number)
	if not character then
		return
	end
	local torso = character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("Torso")
		or character:FindFirstChild("HumanoidRootPart")
	if not torso then
		return
	end
	local top = Instance.new("Attachment")
	top.Position = Vector3.new(0, 1, 0)
	top.Parent = torso
	local bottom = Instance.new("Attachment")
	bottom.Position = Vector3.new(0, -1.5, 0)
	bottom.Parent = torso

	local trail = Instance.new("Trail")
	trail.Attachment0 = top
	trail.Attachment1 = bottom
	trail.Color = ColorSequence.new(color)
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	trail.Lifetime = 0.35
	trail.LightEmission = 0.8
	trail.FaceCamera = true
	trail.MinLength = 0.05
	trail.Parent = torso

	task.delay(duration, function()
		if not trail.Parent then
			return -- персонажа уже нет (респаун, выход) — шлейф удалился вместе с ним
		end
		trail.Enabled = false
		Debris:AddItem(trail, 0.5)
		Debris:AddItem(top, 0.5)
		Debris:AddItem(bottom, 0.5)
	end)
end

-- Энергокупол, который ходит вместе с персонажем.
function Fx.aura(character: Model?, color: Color3, options: { [string]: any }?)
	local root = Fx.rootOf(character)
	if not root then
		return
	end
	local o = options or {}
	local radius, time = o.radius or 8, o.time or 5
	local part = newPart(Enum.PartType.Ball, Vector3.new(1, 1, 1), CFrame.new(root.Position), color, Enum.Material.ForceField, 0)
	tween(part, 0.35, { Size = Vector3.new(radius * 2, radius * 2, radius * 2) }, Enum.EasingStyle.Back)
	Fx.loop(time, function(_, elapsed)
		if not root.Parent or not part.Parent then
			part:Destroy()
			return false
		end
		part.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, elapsed * 1.5, 0)
		if time - elapsed < 0.4 then
			part.Transparency = 1 - (time - elapsed) / 0.4
		end
		return true
	end)
	Debris:AddItem(part, time + 0.1)
end

---------------------------------------------------------------------------
-- Эффекты в мире
---------------------------------------------------------------------------

-- Долгая зона (воронка): большая сфера с тёмным ядром.
function Fx.zone(position: Vector3, color: Color3, options: { [string]: any }?)
	local o = options or {}
	local radius, time = o.radius or 30, o.time or 4
	local shell = newPart(Enum.PartType.Ball, Vector3.new(2, 2, 2), CFrame.new(position), color, Enum.Material.ForceField, 0)
	local core =
		newPart(Enum.PartType.Ball, Vector3.new(1, 1, 1), CFrame.new(position), o.core or Color3.new(0, 0, 0), Enum.Material.Neon, 0.15)
	local floor =
		newPart(Enum.PartType.Cylinder, Vector3.new(0.12, 2, 2), CFrame.new(Fx.ground(position)) * FLAT, color, Enum.Material.Neon, 0.75)
	tween(shell, 0.4, { Size = Vector3.new(radius * 2, radius * 2, radius * 2) }, Enum.EasingStyle.Back)
	tween(core, 0.4, { Size = Vector3.new(7, 7, 7) }, Enum.EasingStyle.Back)
	tween(floor, 0.4, { Size = Vector3.new(0.12, radius * 2, radius * 2) })
	task.delay(math.max(0, time - 0.4), function()
		for _, part in ipairs({ shell, core, floor }) do
			if part.Parent then
				tween(part, 0.4, { Transparency = 1 })
			end
		end
	end)
	for _, part in ipairs({ shell, core, floor }) do
		Debris:AddItem(part, time + 0.1)
	end
end

-- Маленькие шарики, которые кружат вокруг детали (например, мяча).
function Fx.orbit(target: BasePart, color: Color3, options: { [string]: any }?)
	local o = options or {}
	local count, radius, time = o.count or 3, o.radius or 3, o.time or 1
	local orbs = {}
	for i = 1, count do
		orbs[i] = newPart(Enum.PartType.Ball, Vector3.new(0.9, 0.9, 0.9), target.CFrame, color, Enum.Material.Neon, 0.1)
		Debris:AddItem(orbs[i], time + 0.1)
	end
	Fx.loop(time, function(_, elapsed)
		if not target.Parent then
			return false
		end
		local center = target.Position
		for i, orb in ipairs(orbs) do
			local angle = elapsed * 14 + (i - 1) * (math.pi * 2 / count)
			local tilt = (i - 1) * 1.1
			local offset = CFrame.Angles(tilt, 0, tilt * 0.5) * Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
			orb.CFrame = CFrame.new(center + offset)
			orb.Transparency = 0.1 + 0.9 * math.clamp((elapsed - (time - 0.3)) / 0.3, 0, 1)
		end
		return true
	end)
end

-- Ложный мяч: летит по своей траектории и исчезает.
function Fx.ghostBall(position: Vector3, velocity: Vector3, color: Color3, options: { [string]: any }?)
	local o = options or {}
	local time = o.time or 0.5
	local accel = o.accel or Vector3.zero
	local size = Config.Ball.Radius * 2
	local part = newPart(Enum.PartType.Ball, Vector3.new(size, size, size), CFrame.new(position), color, Enum.Material.Neon, 0.25)
	local current, speed = position, velocity
	local floorY = FieldSpec.Origin.Y + Config.Ball.Radius
	Fx.loop(time, function(dt, elapsed)
		speed += accel * dt
		current += speed * dt
		if current.Y < floorY then
			current = Vector3.new(current.X, floorY, current.Z)
		end
		part.CFrame = CFrame.new(current)
		part.Transparency = 0.25 + 0.75 * math.clamp((elapsed - time * 0.6) / (time * 0.4), 0, 1)
		return true
	end)
	Debris:AddItem(part, time + 0.05)
end

---------------------------------------------------------------------------
-- Камера и экран
---------------------------------------------------------------------------

-- Тряска камеры; чем дальше источник, тем слабее.
function Fx.shake(position: Vector3?, magnitude: number, duration: number)
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local scale = 1
	if position then
		local distance = (camera.CFrame.Position - position).Magnitude
		scale = math.clamp(1 - distance / 170, 0, 1)
	end
	if scale <= 0 then
		return
	end
	table.insert(shakes, { magnitude = magnitude * scale, duration = duration, elapsed = 0 })
end

-- Цветная вспышка на весь экран.
function Fx.flash(color: Color3, alpha: number, time: number)
	if not overlay or not overlay.Parent then
		local gui = Instance.new("ScreenGui")
		gui.Name = "FxOverlay"
		gui.IgnoreGuiInset = true
		gui.ResetOnSpawn = false
		gui.DisplayOrder = 50
		local frame = Instance.new("Frame")
		frame.Size = UDim2.fromScale(1, 1)
		frame.BorderSizePixel = 0
		frame.BackgroundTransparency = 1
		frame.Active = false
		frame.Parent = gui
		gui.Parent = localPlayer:WaitForChild("PlayerGui")
		overlay = frame
	end
	local frame = overlay :: Frame
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = 1 - alpha
	tween(frame, time, { BackgroundTransparency = 1 })
end

function Fx.start()
	-- Тряска применяется после того, как стандартная камера посчитала свой кадр.
	RunService:BindToRenderStep("ResonanceShake", Enum.RenderPriority.Camera.Value + 1, function(dt)
		if #shakes == 0 then
			return
		end
		local camera = Workspace.CurrentCamera
		local total = 0
		for i = #shakes, 1, -1 do
			local shake = shakes[i]
			shake.elapsed += dt
			if shake.elapsed >= shake.duration then
				table.remove(shakes, i)
			else
				total += shake.magnitude * (1 - shake.elapsed / shake.duration)
			end
		end
		if camera and total > 0 then
			local amount = math.min(total, 3) * 0.012
			local rx = (math.random() * 2 - 1) * amount
			local ry = (math.random() * 2 - 1) * amount
			camera.CFrame *= CFrame.Angles(rx, ry, 0)
		end
	end)
end

return Fx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">FxEvents</string>
            <string name="Source"><![CDATA[-- Принимает события Fx от сервера и превращает их в анимации, эффекты и звуки.
-- Другие модули (HUD) могут подписаться через FxEvents.on(name, fn).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local FieldSpec = require(Shared.FieldSpec)
local Styles = require(Shared.Styles)
local Fx = require(script.Parent.Fx)
local ProcAnimator = require(script.Parent.ProcAnimator)
local State = require(script.Parent.State)

local FxEvents = {}

local listeners = {} -- [name] = { fn, ... }
local WHITE = Color3.fromRGB(245, 247, 255)

function FxEvents.on(name: string, fn: ({ [string]: any }) -> ())
	local list = listeners[name]
	if not list then
		list = {}
		listeners[name] = list
	end
	table.insert(list, fn)
end

local function styleColor(character: Model?): Color3
	if character then
		return Styles.get(character:GetAttribute("Style")).color
	end
	return WHITE
end

local function teamColor(teamKey: string?): Color3
	local team = teamKey and Config.Teams[teamKey]
	return team and team.Color or WHITE
end

---------------------------------------------------------------------------
-- Удары и борьба
---------------------------------------------------------------------------

-- Свою анимацию локальный игрок запускает сам в момент нажатия (Controls), поэтому здесь её пропускаем.

FxEvents.on("Charge", function(data)
	local character = data.character
	if not character or Fx.isLocal(character) then
		return
	end
	if data.on then
		ProcAnimator.play(character, "ChargeHold")
	else
		ProcAnimator.stop(character, "ChargeHold")
	end
end)

FxEvents.on("Kick", function(data)
	local character = data.character
	local position = data.position
	local power = data.power or 0
	if character and not Fx.isLocal(character) then
		ProcAnimator.stop(character, "ChargeHold")
		local name = data.kind == "Pass" and "Pass" or (data.kind == "Lob" and "Lob" or "Shoot")
		ProcAnimator.play(character, name)
	end
	if typeof(position) ~= "Vector3" then
		return
	end
	if data.kind == "Shot" then
		Fx.sound(power > 0.75 and "PowerKick" or "Kick", position, { pitch = 0.9 + power * 0.25 })
		Fx.disc(Fx.ground(position), WHITE, { from = 1.5, to = 5 + power * 9, time = 0.25 })
		if power > 0.75 then
			Fx.sphere(position, styleColor(character), { from = 1.5, to = 9, time = 0.25 })
			Fx.shake(position, 0.4, 0.2)
		end
	else
		Fx.sound("Pass", position)
		Fx.disc(Fx.ground(position), WHITE, { from = 1, to = 4, time = 0.2 })
	end
end)

FxEvents.on("Slide", function(data)
	local character = data.character
	local root = Fx.rootOf(character)
	if not root then
		return
	end
	if not Fx.isLocal(character) then
		ProcAnimator.play(character, "Slide")
	end
	Fx.sound("Slide", root)
	Fx.burst(Fx.ground(root.Position), Color3.fromRGB(190, 220, 170), { count = 14, speed = 14, life = 0.4, size = 0.9 })
end)

FxEvents.on("Dash", function(data)
	local character = data.character
	local root = Fx.rootOf(character)
	if not root then
		return
	end
	if not Fx.isLocal(character) then
		ProcAnimator.play(character, "Dash")
	end
	Fx.sound("Dash", root)
	Fx.burst(Fx.ground(root.Position), Color3.fromRGB(200, 226, 190), { count = 12, speed = 16, life = 0.35, size = 0.9 })
	Fx.charTrail(character, styleColor(character), 0.3)
end)

FxEvents.on("Dribble", function(data)
	local character = data.character
	local root = Fx.rootOf(character)
	if not root then
		return
	end
	if not Fx.isLocal(character) then
		ProcAnimator.play(character, "Dribble")
	end
	-- Послеобраз показывает, что в этот момент игрока не отобрать.
	local color = styleColor(character)
	Fx.sound("Dash", root, { pitch = 1.3, volume = 0.8 })
	Fx.afterimage(character, color, { time = 0.35 })
	task.delay(0.1, function()
		Fx.afterimage(character, color, { time = 0.35 })
	end)
end)

FxEvents.on("Stun", function(data)
	local character = data.character
	local root = Fx.rootOf(character)
	if not root then
		return
	end
	ProcAnimator.stop(character, "ChargeHold")
	ProcAnimator.play(character, "Stun")
	Fx.burst(root.Position + Vector3.new(0, 2, 0), Color3.fromRGB(255, 232, 120), { count = 12, speed = 12, life = 0.5 })
end)

FxEvents.on("Steal", function(data)
	if typeof(data.position) ~= "Vector3" then
		return
	end
	Fx.sound("Steal", data.position)
	Fx.sphere(data.position, styleColor(data.character), { from = 1.5, to = 9, time = 0.3 })
	Fx.burst(data.position, WHITE, { count = 26, speed = 30, life = 0.45 })
	Fx.shake(data.position, 0.6, 0.25)
end)

FxEvents.on("Dodge", function(data)
	local character = data.character
	local root = Fx.rootOf(character)
	if not root then
		return
	end
	Fx.afterimage(character, styleColor(character), { time = 0.45 })
	Fx.sound("Dash", root, { pitch = 1.4 })
end)

FxEvents.on("Block", function(data)
	if typeof(data.position) ~= "Vector3" then
		return
	end
	local strength = math.clamp((data.speed or 100) / 200, 0.3, 1.2)
	Fx.sound("Block", data.position)
	Fx.sphere(data.position, WHITE, { from = 1.5, to = 6 + strength * 8, time = 0.3 })
	Fx.burst(data.position, WHITE, { count = 20, speed = 26, life = 0.4 })
	Fx.shake(data.position, strength, 0.25)
end)

FxEvents.on("Save", function(data)
	if typeof(data.position) ~= "Vector3" then
		return
	end
	Fx.sound("Block", data.position, { pitch = 1.2 })
	Fx.sphere(data.position, styleColor(data.character), { from = 2, to = 10, time = 0.35 })
end)

FxEvents.on("KeeperDive", function(data)
	ProcAnimator.play(data.character, data.right and "DiveRight" or "DiveLeft")
end)

FxEvents.on("StyleChanged", function(data)
	local root = Fx.rootOf(data.character)
	if root then
		local style = Styles.get(data.style)
		Fx.sphere(root.Position, style.color, { from = 2, to = 12, time = 0.4 })
		Fx.burst(root.Position, style.color2 or style.color, { count = 30, speed = 22, life = 0.5 })
	end
end)

---------------------------------------------------------------------------
-- Матч
---------------------------------------------------------------------------

FxEvents.on("Countdown", function()
	Fx.sound("Tick", nil)
end)

FxEvents.on("Whistle", function()
	Fx.sound("Whistle", nil)
end)

FxEvents.on("FullTime", function()
	Fx.sound("Whistle", nil, { pitch = 0.8 })
	task.delay(0.35, function()
		Fx.sound("Whistle", nil, { pitch = 0.8 })
	end)
end)

FxEvents.on("Goal", function(data)
	local color = teamColor(data.team)
	Fx.sound("Goal", nil)
	Fx.flash(color, 0.3, 0.6)

	-- Салют за воротами, в которые забили.
	local side = data.side or 1
	local goal = FieldSpec.goalCenter(side)
	Fx.shake(goal, 1.4, 0.6)
	for i = 0, 5 do
		task.delay(i * 0.22, function()
			local z = (math.random() * 2 - 1) * FieldSpec.GoalWidth * 0.7
			local point = goal + Vector3.new(side * 6, 10 + math.random() * 14, z)
			Fx.burst(point, i % 2 == 0 and color or WHITE, { count = 46, speed = 46, life = 0.9, size = 1.5 })
			Fx.sphere(point, color, { from = 2, to = 16, time = 0.5 })
			Fx.light(point, color, { range = 40, time = 0.5 })
		end)
	end
	Fx.pillar(goal + Vector3.new(side * 4, 0, 0), color, { radius = 4, height = 70, time = 0.9 })

	local scorer = data.character
	if scorer and scorer.Parent then
		ProcAnimator.play(scorer, "Celebrate")
		local root = Fx.rootOf(scorer)
		if root then
			Fx.disc(Fx.ground(root.Position), color, { from = 2, to = 18, time = 0.6 })
		end
	end
end)

---------------------------------------------------------------------------
-- Способности стилей
---------------------------------------------------------------------------

FxEvents.on("Ability", function(data)
	local style = Styles.byId[data.style]
	local ability = style and style.abilities[data.slot]
	if not ability or not ability.client then
		return
	end
	local ok, err = pcall(ability.client, Fx, data)
	if not ok then
		warn(string.format("[Fx] %s.%s: %s", tostring(data.style), tostring(ability.id), tostring(err)))
	end
end)

function FxEvents.start()
	State.fx.OnClientEvent:Connect(function(name: string, data: any)
		local list = listeners[name]
		if not list then
			return
		end
		local payload = type(data) == "table" and data or {}
		for _, fn in ipairs(list) do
			local ok, err = pcall(fn, payload)
			if not ok then
				warn(string.format("[Fx] %s: %s", tostring(name), tostring(err)))
			end
		end
	end)
end

return FxEvents
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[-- Интерфейс: табло, баннеры, полоски сил/резонанса/удара, слоты способностей, подсказка, меню стилей.
-- Всё создаётся кодом.

local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Styles = require(Shared.Styles)
local Util = require(Shared.Util)
local Controls = require(script.Parent.Controls)
local FxEvents = require(script.Parent.FxEvents)
local Sfx = require(script.Parent.Sfx)
local State = require(script.Parent.State)

local Hud = {}

local PANEL = Color3.fromRGB(14, 16, 24)
local WHITE = Color3.fromRGB(245, 247, 255)
local MUTED = Color3.fromRGB(158, 164, 184)
local GOLD = Color3.fromRGB(255, 224, 120)
local RED = Color3.fromRGB(255, 92, 92)
local HOME, AWAY = Config.Teams.Home, Config.Teams.Away
local RES_MAX = Config.Resonance.Max
-- Пока в игре нет выбираемых стилей, меню стилей, способности и Резонанс не показываем.
local STYLES_ON = Styles.enabled
-- Без шкалы Резонанса полоски внизу на одну строку ниже.
local BARS_SHIFT = STYLES_ON and 0 or 22

local root: Frame
local rootScale: UIScale
local cache = {} -- последние выставленные тексты, чтобы не трогать интерфейс без нужды

---------------------------------------------------------------------------
-- Помощники
---------------------------------------------------------------------------

local function make(className: string, props: { [string]: any }, parent: Instance?): any
	local instance = Instance.new(className)
	for key, value in pairs(props) do
		(instance :: any)[key] = value
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

local function corner(parent: Instance, radius: number)
	make("UICorner", { CornerRadius = UDim.new(0, radius) }, parent)
end

local function border(parent: Instance, color: Color3, thickness: number, transparency: number?): UIStroke
	return make("UIStroke", {
		Color = color,
		Thickness = thickness,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

local function text(props: { [string]: any }, parent: Instance?): TextLabel
	local label = make("TextLabel", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		TextColor3 = WHITE,
		TextSize = 14,
		Text = "",
	}, nil)
	for key, value in pairs(props) do
		(label :: any)[key] = value
	end
	label.Parent = parent
	return label
end

local function tween(instance: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?)
	local t = TweenService:Create(instance, TweenInfo.new(time, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal)
	t:Play()
	return t
end

local function setText(label: TextLabel, value: string)
	if cache[label] ~= value then
		cache[label] = value
		label.Text = value
	end
end

local KEY_NAMES = {
	MouseButton1 = "LMB",
	MouseButton2 = "RMB",
	LeftShift = "Shift",
	LeftControl = "Ctrl",
	Space = "Space",
}

local function keyName(names: { string }): string
	local first = names[1] or "?"
	return KEY_NAMES[first] or first
end

local function formatTime(seconds: number): string
	local whole = math.max(0, math.floor(seconds + 0.5))
	return string.format("%d:%02d", whole // 60, whole % 60)
end

---------------------------------------------------------------------------
-- Табло
---------------------------------------------------------------------------

local homeScore: TextLabel, awayScore: TextLabel, clock: TextLabel, phaseLabel: TextLabel

-- Счёт сверху по центру без плашки: «HOME : 0   4:17   0 : AWAY».
local SCORE_FONT = Enum.Font.FredokaOne
local OUTLINE = Color3.fromRGB(10, 14, 32)

local function buildScoreboard()
	local board = make("Frame", {
		Name = "Scoreboard",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(520, 40),
		BackgroundTransparency = 1,
	}, root)

	local function label(props: { [string]: any }): TextLabel
		props.Font = SCORE_FONT
		props.TextStrokeTransparency = 0.15
		props.TextStrokeColor3 = OUTLINE
		props.Size = props.Size or UDim2.fromOffset(120, 40)
		return text(props, board)
	end

	label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(0.5, -84, 0, 0),
		Size = UDim2.fromOffset(160, 40),
		Text = HOME.Name .. " :",
		TextColor3 = HOME.Color:Lerp(WHITE, 0.25),
		TextSize = 26,
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	homeScore = label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(0.5, -50, 0, 0),
		Size = UDim2.fromOffset(30, 40),
		Text = "0",
		TextSize = 28,
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	clock = label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.fromOffset(90, 40),
		Text = "5:00",
		TextSize = 26,
	})
	awayScore = label({
		Position = UDim2.new(0.5, 50, 0, 0),
		Size = UDim2.fromOffset(30, 40),
		Text = "0",
		TextSize = 28,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	label({
		Position = UDim2.new(0.5, 84, 0, 0),
		Size = UDim2.fromOffset(160, 40),
		Text = ": " .. AWAY.Name,
		TextColor3 = AWAY.Color:Lerp(WHITE, 0.25),
		TextSize = 26,
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	phaseLabel = text({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 50),
		Size = UDim2.fromOffset(420, 20),
		Font = SCORE_FONT,
		TextColor3 = WHITE,
		TextSize = 15,
		TextStrokeTransparency = 0.3,
		TextStrokeColor3 = OUTLINE,
	}, root)
end

---------------------------------------------------------------------------
-- Баннер по центру
---------------------------------------------------------------------------

local bannerTitle: TextLabel, bannerSub: TextLabel, bannerScale: UIScale
local bannerToken = 0

local function buildBanner()
	local frame = make("Frame", {
		Name = "Banner",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.3),
		Size = UDim2.fromOffset(1000, 150),
		BackgroundTransparency = 1,
	}, root)
	bannerScale = make("UIScale", { Scale = 1 }, frame)
	bannerTitle = text({
		Size = UDim2.new(1, 0, 0, 96),
		Font = Enum.Font.GothamBlack,
		TextSize = 84,
		TextTransparency = 1,
		TextStrokeTransparency = 1,
		TextStrokeColor3 = Color3.fromRGB(8, 9, 14),
	}, frame)
	bannerSub = text({
		Position = UDim2.fromOffset(0, 100),
		Size = UDim2.new(1, 0, 0, 36),
		TextSize = 26,
		TextTransparency = 1,
		TextStrokeTransparency = 1,
		TextStrokeColor3 = Color3.fromRGB(8, 9, 14),
	}, frame)
end

function Hud.banner(title: string, subtitle: string?, color: Color3?, duration: number?)
	bannerToken += 1
	local token = bannerToken
	bannerTitle.Text = title
	bannerTitle.TextColor3 = color or WHITE
	bannerSub.Text = subtitle or ""
	bannerTitle.TextTransparency = 0
	bannerTitle.TextStrokeTransparency = 0.2
	bannerSub.TextTransparency = 0
	bannerSub.TextStrokeTransparency = 0.3
	bannerScale.Scale = 1.5
	tween(bannerScale, 0.28, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(duration or 1.5, function()
		if token ~= bannerToken then
			return
		end
		tween(bannerTitle, 0.35, { TextTransparency = 1, TextStrokeTransparency = 1 })
		tween(bannerSub, 0.35, { TextTransparency = 1, TextStrokeTransparency = 1 })
	end)
end

---------------------------------------------------------------------------
-- Полоски: удар, силы, резонанс
---------------------------------------------------------------------------

local chargeHolder: Frame, chargeFill: Frame
local staminaFill: Frame, resonanceFill: Frame, resonanceGlow: UIStroke
local ballLabel: TextLabel, hintLabel: TextLabel
local hintToken = 0

local function bar(parent: Instance, y: number, height: number, caption: string, color: Color3)
	local holder = make("Frame", {
		Position = UDim2.fromOffset(0, y),
		Size = UDim2.new(1, 0, 0, height),
		BackgroundColor3 = Color3.fromRGB(6, 7, 12),
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
	}, parent)
	corner(holder, height / 2)
	local fill = make("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
	}, holder)
	corner(fill, height / 2)
	text({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(0, -10, 0.5, 0),
		Size = UDim2.fromOffset(90, 14),
		Text = caption,
		TextColor3 = MUTED,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextStrokeTransparency = 0.6,
	}, holder)
	return holder, fill
end

local function buildBars()
	local cluster = make("Frame", {
		Name = "Bars",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UserInputService.TouchEnabled and UDim2.new(0.5, 0, 1, -24) or UDim2.new(0.5, 0, 1, -112 + BARS_SHIFT),
		Size = UDim2.fromOffset(340, 66),
		BackgroundTransparency = 1,
	}, root)

	chargeHolder, chargeFill = bar(cluster, 0, 12, "SHOT", GOLD)
	chargeHolder.Visible = false
	local _, stamina = bar(cluster, 26, 10, "STAMINA", WHITE)
	staminaFill = stamina
	local resonanceHolder, resonance = bar(cluster, 48, 12, "RESONANCE", WHITE)
	resonanceFill = resonance
	resonanceGlow = border(resonanceHolder, WHITE, 2, 1)
	resonanceHolder.Visible = STYLES_ON

	ballLabel = text({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UserInputService.TouchEnabled and UDim2.new(0.5, 0, 1, -104) or UDim2.new(0.5, 0, 1, -184 + BARS_SHIFT),
		Size = UDim2.fromOffset(300, 22),
		Text = "YOU HAVE THE BALL",
		TextColor3 = GOLD,
		TextSize = 15,
		TextStrokeTransparency = 0.4,
		Visible = false,
	}, root)

	hintLabel = text({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UserInputService.TouchEnabled and UDim2.new(0.5, 0, 1, -132) or UDim2.new(0.5, 0, 1, -212 + BARS_SHIFT),
		Size = UDim2.fromOffset(420, 24),
		TextColor3 = RED,
		TextSize = 17,
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	}, root)
end

function Hud.hint(message: string)
	hintToken += 1
	local token = hintToken
	hintLabel.Text = message
	hintLabel.TextTransparency = 0
	hintLabel.TextStrokeTransparency = 0.4
	task.delay(1.1, function()
		if token == hintToken then
			tween(hintLabel, 0.3, { TextTransparency = 1, TextStrokeTransparency = 1 })
		end
	end)
end

---------------------------------------------------------------------------
-- Слоты способностей
---------------------------------------------------------------------------

local slots = {} -- [key] = { frame, stroke, name, overlay, time, total }
-- "Action" — контекстная клавиша: без мяча подкат, с мячом дриблинг.
local slotOrder = STYLES_ON and { "Action", "Dash", "A1", "A2", "A3" } or { "Action", "Dash" }

local function buildSlots()
	local touch = UserInputService.TouchEnabled
	local holder = make("Frame", {
		Name = "Slots",
		-- На ПК — по центру внизу, под полоской сил; на телефоне — справа сверху, чтобы не мешать кнопкам.
		AnchorPoint = touch and Vector2.new(1, 0) or Vector2.new(0.5, 1),
		Position = touch and UDim2.new(1, -18, 0, 86) or UDim2.new(0.5, 0, 1, -10),
		Size = UDim2.fromOffset(#slotOrder * 78, 92),
		BackgroundTransparency = 1,
	}, root)
	make("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = touch and Enum.HorizontalAlignment.Right or Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, holder)

	local keys = {
		Action = keyName(Config.Controls.Action),
		Dash = keyName(Config.Controls.Dash),
		A1 = keyName(Config.Controls.Ability1),
		A2 = keyName(Config.Controls.Ability2),
		A3 = keyName(Config.Controls.Ability3),
	}

	for index, key in ipairs(slotOrder) do
		local cell = make("Frame", {
			Name = key,
			LayoutOrder = index,
			Size = UDim2.fromOffset(68, 92),
			BackgroundTransparency = 1,
		}, holder)
		local frame = make("Frame", {
			Size = UDim2.fromOffset(68, 68),
			BackgroundColor3 = PANEL,
			BackgroundTransparency = 0.15,
			BorderSizePixel = 0,
			ClipsDescendants = true,
		}, cell)
		corner(frame, 12)
		local stroke = border(frame, WHITE, 2, 0.5)
		text({
			Position = UDim2.fromOffset(8, 5),
			Size = UDim2.fromOffset(52, 18),
			Text = keys[key],
			TextSize = 15,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 3,
		}, frame)
		local overlay = make("Frame", {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.fromScale(1, 0),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.4,
			BorderSizePixel = 0,
			ZIndex = 2,
		}, frame)
		local timeLabel = text({
			Position = UDim2.fromOffset(0, 22),
			Size = UDim2.new(1, 0, 0, 30),
			Font = Enum.Font.GothamBlack,
			TextSize = 22,
			ZIndex = 3,
		}, frame)
		local nameLabel = text({
			Position = UDim2.fromOffset(-6, 70),
			Size = UDim2.fromOffset(80, 22),
			Font = Enum.Font.GothamMedium,
			TextColor3 = MUTED,
			TextSize = 10,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextStrokeTransparency = 0.6,
		}, cell)
		slots[key] = { frame = frame, stroke = stroke, name = nameLabel, overlay = overlay, time = timeLabel, total = 1 }
	end

	slots.Dash.name.Text = "DASH"
	slots.Dash.total = Config.Dash.Cooldown
	slots.Action.name.Text = "TACKLE"
	slots.Action.total = Config.Tackle.Cooldown
end

-- Подписи и цвета слотов под текущий стиль.
local shownStyle: string? = nil

local function refreshStyle()
	local style = State.style()
	if shownStyle == style.id then
		return
	end
	shownStyle = style.id
	for index = 1, STYLES_ON and 3 or 0 do
		local slot = slots["A" .. index]
		local ability = style.abilities[index]
		slot.name.Text = ability and Util.upper(ability.name) or "—"
		slot.total = ability and ability.cooldown or 1
		slot.stroke.Color = style.color
	end
	resonanceFill.BackgroundColor3 = style.color
	resonanceGlow.Color = style.color
end

local function flashSlot(key: string)
	local slot = slots[key]
	if not slot then
		return
	end
	local original = slot.stroke.Color
	slot.stroke.Color = RED
	slot.stroke.Transparency = 0
	task.delay(0.25, function()
		slot.stroke.Color = original
	end)
end

local function updateSlots(hasBall: boolean, resonance: number)
	local style = State.style()
	for _, key in ipairs(slotOrder) do
		local slot = slots[key]
		local cooldownKey = key
		if key == "Action" then
			-- Слот показывает то действие, которое сейчас сработает по этой клавише.
			cooldownKey = hasBall and "Dribble" or "Tackle"
			slot.total = hasBall and Config.Dribble.Cooldown or Config.Tackle.Cooldown
			setText(slot.name, hasBall and "DRIBBLE" or "TACKLE")
		end
		local remaining = State.cooldown(cooldownKey)
		local fraction = math.clamp(remaining / math.max(slot.total, 0.01), 0, 1)
		local label = ""
		if remaining >= 10 then
			label = tostring(math.floor(remaining))
		elseif remaining > 0 then
			label = string.format("%.1f", remaining)
		end
		local usable = remaining <= 0

		if key ~= "Action" and key ~= "Dash" then
			local ability = style.abilities[tonumber(string.sub(key, 2)) :: number]
			if not ability then
				usable = false
			else
				if ability.needsBall and not hasBall then
					usable = false
				end
				if ability.needsNoBall and hasBall then
					usable = false
				end
				if ability.ultimate and remaining <= 0 and resonance < RES_MAX then
					-- Ульта: слот заполняется по мере накопления резонанса.
					usable = false
					fraction = 1 - resonance / RES_MAX
					label = string.format("%d%%", math.floor(resonance / RES_MAX * 100))
				end
			end
		end

		slot.overlay.Size = UDim2.fromScale(1, fraction)
		setText(slot.time, label)
		slot.stroke.Transparency = usable and 0 or 0.65
		slot.frame.BackgroundTransparency = usable and 0.1 or 0.3
	end
end

---------------------------------------------------------------------------
-- Подсказка по управлению
---------------------------------------------------------------------------

local helpPanel: Frame, helpChip: TextLabel

local function buildHelp()
	local c = Config.Controls
	local lines = {
		{ "WASD / Space", "move, jump" },
		{ keyName(c.Sprint), "sprint (uses stamina)" },
		{ keyName(c.Shoot) .. " (hold)", "shoot: hold longer, kick harder" },
		{ keyName(c.Action), "tackle; with the ball: dribble" },
		{ keyName(c.Pass), "pass to a teammate" },
		{ keyName(c.Lob), "lob" },
		{ keyName(c.Dash), "dash" },
	}
	if STYLES_ON then
		table.insert(lines, { keyName(c.Ability1) .. "  " .. keyName(c.Ability2), "style abilities" })
		table.insert(lines, { keyName(c.Ability3), "ultimate (full Resonance)" })
		table.insert(lines, { keyName(c.StyleMenu), "change style" })
	end
	table.insert(lines, { c.ShiftLock == "LeftControl" and "Ctrl" or c.ShiftLock, "lock camera" })

	helpPanel = make("Frame", {
		Name = "Help",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 18, 1, -24),
		Size = UDim2.fromOffset(340, 46 + #lines * 20),
		BackgroundColor3 = PANEL,
		BackgroundTransparency = 0.18,
		BorderSizePixel = 0,
	}, root)
	corner(helpPanel, 12)
	border(helpPanel, WHITE, 1, 0.88)
	text({
		Position = UDim2.fromOffset(14, 10),
		Size = UDim2.new(1, -28, 0, 18),
		Text = "CONTROLS   [" .. keyName(c.Help) .. " to hide]",
		TextColor3 = GOLD,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, helpPanel)
	for index, line in ipairs(lines) do
		local y = 34 + (index - 1) * 20
		text({
			Position = UDim2.fromOffset(14, y),
			Size = UDim2.fromOffset(110, 18),
			Text = line[1],
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, helpPanel)
		text({
			Position = UDim2.fromOffset(128, y),
			Size = UDim2.new(1, -140, 0, 18),
			Font = Enum.Font.GothamMedium,
			Text = line[2],
			TextColor3 = MUTED,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, helpPanel)
	end

	helpChip = text({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 18, 1, -24),
		Size = UDim2.fromOffset(190, 26),
		BackgroundColor3 = PANEL,
		BackgroundTransparency = 0.25,
		Text = keyName(c.Help) .. ": controls",
		TextColor3 = MUTED,
		TextSize = 12,
		Visible = false,
	}, root)
	corner(helpChip, 8)
end

local function setHelp(visible: boolean)
	helpPanel.Visible = visible
	helpChip.Visible = not visible
end

---------------------------------------------------------------------------
-- Меню стилей
---------------------------------------------------------------------------

local menu: TextButton, styleButton: TextButton
local cards = {} -- [styleId] = { stroke, button }

local function setMenu(open: boolean)
	menu.Visible = open
	Controls.menuOpen = open
	if open then
		local current = State.style().id
		for id, card in pairs(cards) do
			local selected = id == current
			card.stroke.Transparency = selected and 0 or 0.7
			card.stroke.Thickness = selected and 3 or 1
			card.button.Text = selected and "SELECTED" or "SELECT"
		end
	end
end

local function chooseStyle(style)
	Sfx.play("Click", nil)
	if style.id ~= State.style().id then
		State.send("SelectStyle", style.id)
		Hud.banner(Util.upper(style.name), style.tagline, style.color, 1.6)
	end
	setMenu(false)
end

local function buildStyleCard(style, parent: Instance, order: number)
	local card = make("Frame", {
		Name = style.id,
		LayoutOrder = order,
		Size = UDim2.fromOffset(214, 396),
		BackgroundColor3 = Color3.fromRGB(22, 25, 36),
		BorderSizePixel = 0,
	}, parent)
	corner(card, 14)
	local stroke = border(card, style.color, 1, 0.7)

	local header = make("Frame", {
		Size = UDim2.new(1, 0, 0, 8),
		BackgroundColor3 = style.color,
		BorderSizePixel = 0,
	}, card)
	corner(header, 4)

	text({
		Position = UDim2.fromOffset(14, 18),
		Size = UDim2.new(1, -28, 0, 28),
		Font = Enum.Font.GothamBlack,
		Text = Util.upper(style.name),
		TextColor3 = style.color,
		TextSize = 24,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, card)
	text({
		Position = UDim2.fromOffset(14, 46),
		Size = UDim2.new(1, -28, 0, 16),
		Text = Util.upper(style.role or ""),
		TextColor3 = MUTED,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, card)
	text({
		Position = UDim2.fromOffset(14, 66),
		Size = UDim2.new(1, -28, 0, 30),
		Font = Enum.Font.GothamMedium,
		Text = '"' .. (style.tagline or "") .. '"',
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
	}, card)
	text({
		Position = UDim2.fromOffset(14, 98),
		Size = UDim2.new(1, -28, 0, 58),
		Font = Enum.Font.Gotham,
		Text = style.description or "",
		TextColor3 = MUTED,
		TextSize = 11,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
	}, card)

	local keys = {
		keyName(Config.Controls.Ability1),
		keyName(Config.Controls.Ability2),
		keyName(Config.Controls.Ability3),
	}
	for index = 1, 3 do
		local ability = style.abilities[index]
		if ability then
			local y = 160 + (index - 1) * 62
			text({
				Position = UDim2.fromOffset(14, y),
				Size = UDim2.new(1, -28, 0, 16),
				Text = string.format("[%s] %s", keys[index], ability.name),
				TextColor3 = ability.ultimate and GOLD or WHITE,
				TextSize = 13,
				TextXAlignment = Enum.TextXAlignment.Left,
			}, card)
			text({
				Position = UDim2.fromOffset(14, y + 17),
				Size = UDim2.new(1, -28, 0, 42),
				Font = Enum.Font.Gotham,
				Text = ability.desc or "",
				TextColor3 = MUTED,
				TextSize = 10,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
			}, card)
		end
	end

	local button = make("TextButton", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -12),
		Size = UDim2.new(1, -28, 0, 34),
		BackgroundColor3 = style.color,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBlack,
		Text = "SELECT",
		TextColor3 = Color3.fromRGB(14, 16, 24),
		TextSize = 14,
		AutoButtonColor = true,
	}, card)
	corner(button, 9)
	button.Activated:Connect(function()
		chooseStyle(style)
	end)

	cards[style.id] = { stroke = stroke, button = button }
end

local function buildStyleMenu()
	styleButton = make("TextButton", {
		Name = "StyleButton",
		Position = UDim2.fromOffset(18, 62),
		Size = UDim2.fromOffset(190, 34),
		BackgroundColor3 = PANEL,
		BackgroundTransparency = 0.15,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Text = "STYLE",
		TextColor3 = WHITE,
		TextSize = 13,
	}, root)
	corner(styleButton, 10)
	border(styleButton, WHITE, 1, 0.8)

	-- Modal = true освобождает курсор, даже если камера закреплена.
	menu = make("TextButton", {
		Name = "StyleMenu",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		Modal = true,
		Visible = false,
		ZIndex = 10,
	}, root)

	local count = #Styles.list
	local width = math.min(980, count * 228 + 40)
	local panel = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(width, 500),
		BackgroundColor3 = PANEL,
		BorderSizePixel = 0,
		ZIndex = 10,
	}, menu)
	corner(panel, 18)
	border(panel, WHITE, 1, 0.85)

	text({
		Position = UDim2.fromOffset(24, 16),
		Size = UDim2.new(1, -100, 0, 30),
		Font = Enum.Font.GothamBlack,
		Text = "CHOOSE YOUR STYLE",
		TextSize = 24,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 10,
	}, panel)

	local close = make("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 14),
		Size = UDim2.fromOffset(34, 34),
		BackgroundColor3 = Color3.fromRGB(34, 38, 52),
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Text = "X",
		TextColor3 = WHITE,
		TextSize = 16,
		ZIndex = 10,
	}, panel)
	corner(close, 9)
	close.Activated:Connect(function()
		setMenu(false)
	end)

	local list = make("ScrollingFrame", {
		Position = UDim2.fromOffset(20, 60),
		Size = UDim2.new(1, -40, 1, -76),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		ScrollingDirection = Enum.ScrollingDirection.X,
		ScrollBarThickness = 6,
		ZIndex = 10,
	}, panel)
	make("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 14),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, list)
	make("UIPadding", { PaddingLeft = UDim.new(0, 2), PaddingTop = UDim.new(0, 4) }, list)

	for index, style in ipairs(Styles.list) do
		buildStyleCard(style, list, index)
	end
	-- Всё внутри меню должно рисоваться поверх остального HUD.
	for _, descendant in ipairs(list:GetDescendants()) do
		if descendant:IsA("GuiObject") then
			descendant.ZIndex = 11
		end
	end

	styleButton.Activated:Connect(function()
		setMenu(not menu.Visible)
	end)
end

---------------------------------------------------------------------------
-- Обновление
---------------------------------------------------------------------------

local PHASE_TEXT = {
	Waiting = "WAITING FOR PLAYERS",
	Kickoff = "KICKOFF",
	Playing = "",
	Goal = "GOAL",
	FullTime = "FULL TIME: NEXT MATCH SOON",
}

local function updateScale()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local size = camera.ViewportSize
	local scale = math.clamp(math.min(size.X / 1280, size.Y / 720), 0.55, 1.3)
	if math.abs(rootScale.Scale - scale) > 0.01 then
		rootScale.Scale = scale
		-- Корневой кадр «растягиваем обратно», чтобы после масштаба он снова занимал весь экран.
		root.Size = UDim2.fromScale(1 / scale, 1 / scale)
	end
end

local function onRender()
	updateScale()
	refreshStyle()

	local match = State.match
	setText(homeScore, tostring(match:GetAttribute("Home") or 0))
	setText(awayScore, tostring(match:GetAttribute("Away") or 0))
	setText(clock, formatTime(match:GetAttribute("TimeLeft") or 0))
	setText(phaseLabel, PHASE_TEXT[State.phase()] or "")

	if STYLES_ON then
		local style = State.style()
		setText(styleButton, string.format("STYLE: %s  [%s]", Util.upper(style.name), keyName(Config.Controls.StyleMenu)))
	end

	-- Силы.
	local maxStamina = State.player:GetAttribute("MaxStamina") or Config.Player.MaxStamina
	local stamina = math.clamp(State.stamina() / math.max(maxStamina, 1), 0, 1)
	staminaFill.Size = staminaFill.Size:Lerp(UDim2.fromScale(stamina, 1), 0.3)
	staminaFill.BackgroundColor3 = stamina < 0.15 and RED or WHITE

	-- Резонанс.
	local resonance = State.resonance()
	local full = resonance >= RES_MAX
	resonanceFill.Size = resonanceFill.Size:Lerp(UDim2.fromScale(math.clamp(resonance / RES_MAX, 0, 1), 1), 0.3)
	resonanceGlow.Transparency = full and (0.25 + 0.35 * math.sin(os.clock() * 7)) or 1

	-- Заряд удара.
	chargeHolder.Visible = Controls.charging
	if Controls.charging then
		chargeFill.Size = UDim2.fromScale(Controls.charge, 1)
		chargeFill.BackgroundColor3 = Controls.charge >= 1 and RED or GOLD
	end

	local hasBall = State.hasBall()
	ballLabel.Visible = hasBall
	updateSlots(hasBall, resonance)
end

local function hookEvents()
	FxEvents.on("Countdown", function(data)
		local team = Config.Teams[data.team]
		local subtitle = team and (team.Name .. " KICKS OFF") or ""
		Hud.banner(tostring(data.n), subtitle, WHITE, 0.8)
	end)

	FxEvents.on("Goal", function(data)
		local team = Config.Teams[data.team]
		local subtitle = ""
		if data.scorerName and data.scorerName ~= "" then
			subtitle = data.scorerName
			local style = data.styleId and Styles.byId[data.styleId]
			if style and style.selectable ~= false then
				subtitle ..= "  ·  " .. style.name
			end
			if data.assistName and data.assistName ~= "" then
				subtitle ..= "   (assist: " .. data.assistName .. ")"
			end
		end
		Hud.banner("GOAL!", subtitle, team and team.Color or WHITE, 3.2)
	end)

	FxEvents.on("FullTime", function(data)
		local title = "DRAW"
		local color = WHITE
		local winner = Config.Teams[data.winner]
		if winner then
			title = winner.Name .. " WINS"
			color = winner.Color
		end
		Hud.banner(title, string.format("%d : %d", data.home or 0, data.away or 0), color, 6)
	end)

	Controls.onDenied = function(key, reason)
		flashSlot(key)
		Hud.hint(reason)
	end
end

function Hud.start()
	local playerGui = State.player:WaitForChild("PlayerGui")
	local gui = make("ScreenGui", {
		Name = "ResonanceHud",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 5,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, playerGui)

	root = make("Frame", {
		Name = "Root",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
	}, gui)
	rootScale = make("UIScale", { Scale = 1 }, root)

	buildScoreboard()
	buildBanner()
	buildBars()
	buildSlots()
	buildHelp()
	if STYLES_ON then
		buildStyleMenu()
	end
	hookEvents()

	local function press(fn: () -> ())
		return function(_, inputState: Enum.UserInputState)
			if inputState == Enum.UserInputState.Begin then
				fn()
			end
			return Enum.ContextActionResult.Pass
		end
	end
	local function keys(names: { string })
		local list = {}
		for _, name in ipairs(names) do
			local ok, key = pcall(function()
				return (Enum.KeyCode :: any)[name]
			end)
			if ok and key then
				table.insert(list, key)
			end
		end
		return list
	end
	if STYLES_ON then
		ContextActionService:BindAction(
			"RS_StyleMenu",
			press(function()
				setMenu(not menu.Visible)
			end),
			false,
			table.unpack(keys(Config.Controls.StyleMenu))
		)
	end
	ContextActionService:BindAction(
		"RS_Help",
		press(function()
			setHelp(not helpPanel.Visible)
		end),
		false,
		table.unpack(keys(Config.Controls.Help))
	)

	-- На телефоне подсказка по клавишам не нужна.
	setHelp(not UserInputService.TouchEnabled)
	if UserInputService.TouchEnabled then
		helpChip.Visible = false
	end

	RunService.RenderStepped:Connect(onRender)

	-- При первом входе сразу предлагаем выбрать стиль.
	if STYLES_ON then
		task.delay(1.5, function()
			setMenu(true)
		end)
	end
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="35">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Точка входа клиента.

local StarterGui = game:GetService("StarterGui")

local Client = script.Parent

local ProcAnimator = require(Client.ProcAnimator)
local Fx = require(Client.Fx)
local FxEvents = require(Client.FxEvents)
local BallVisuals = require(Client.BallVisuals)
local Controls = require(Client.Controls)
local Hud = require(Client.Hud)
local Cinematics = require(Client.Cinematics)

-- Рюкзак и полоска здоровья в футболе не нужны.
for _, coreGui in ipairs({ Enum.CoreGuiType.Backpack, Enum.CoreGuiType.Health, Enum.CoreGuiType.EmotesMenu }) do
	pcall(function()
		StarterGui:SetCoreGuiEnabled(coreGui, false)
	end)
end

ProcAnimator.start()
Fx.start()
FxEvents.start()
BallVisuals.start()
Controls.start()
Hud.start()
Cinematics.start()
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">ProcAnimator</string>
            <string name="Source"><![CDATA[-- Проигрывает анимации из Shared/Animations на персонажах R6 и R15.
-- Работает через Motor6D.Transform: каждый кадр (Stepped) мы подмешиваем свою позу
-- поверх того, что выставил стандартный Animator (бег, стойка).
--
-- Если в Config.AnimationIds для анимации указан ID (анимация, опубликованная в Roblox — например,
-- сделанная в Blender), вместо позы из кода играется она, через обычный Animator.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Animations = require(Shared.Animations)
local Config = require(Shared.Config)
local AnimSampler = require(Shared.AnimSampler)

local ProcAnimator = {}

local JOINTS = {
	R15 = {
		"Root",
		"Waist",
		"Neck",
		"RightShoulder",
		"RightElbow",
		"RightWrist",
		"LeftShoulder",
		"LeftElbow",
		"LeftWrist",
		"RightHip",
		"RightKnee",
		"RightAnkle",
		"LeftHip",
		"LeftKnee",
		"LeftAnkle",
	},
	R6 = { "RootJoint", "Neck", "Right Shoulder", "Left Shoulder", "Right Hip", "Left Hip" },
}

local rigs = {} -- [Model] = { kind, motors, frames, count, tracks, written }

-- Тип аватара определяем по Humanoid, а если его нет — по именам суставов.
local function detectKind(character: Model): string
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		return humanoid.RigType == Enum.HumanoidRigType.R6 and "R6" or "R15"
	end
	return character:FindFirstChild("Torso") and "R6" or "R15"
end

local function findMotors(character: Model, kind: string)
	local wanted = {}
	for _, name in ipairs(JOINTS[kind]) do
		wanted[name] = true
	end
	local motors, frames = {}, {}
	local count = 0
	for _, descendant in ipairs(character:GetDescendants()) do
		if descendant:IsA("Motor6D") and wanted[descendant.Name] and not motors[descendant.Name] then
			motors[descendant.Name] = descendant
			-- У суставов R6 оси повёрнуты (C0 с поворотом). Позы заданы в осях персонажа,
			-- поэтому перед записью в Transform переводим их в оси сустава.
			local rotation = descendant.C0.Rotation
			frames[descendant.Name] = { rotation = rotation, inverse = rotation:Inverse() }
			count += 1
		end
	end
	return motors, frames, count
end

local function getRig(character: Model)
	local rig = rigs[character]
	if not rig then
		rig = { kind = detectKind(character), motors = {}, frames = {}, count = 0, tracks = {}, written = {}, assets = {} }
		rigs[character] = rig
	end
	-- Персонаж мог быть уменьшен (Model:ScaleTo): смещения в позах масштабируем так же.
	local root = character:FindFirstChild("HumanoidRootPart")
	rig.scale = root and root:IsA("BasePart") and root.Size.Y / 2 or 1
	if rig.count < #JOINTS[rig.kind] - 3 then
		rig.kind = detectKind(character)
		rig.motors, rig.frames, rig.count = findMotors(character, rig.kind)
	end
	return rig
end

-- Анимация из Roblox по ID (Config.AnimationIds). Возвращает AnimationTrack или nil, если ID не задан
-- или анимацию не удалось загрузить — тогда играет встроенная поза.
local function assetTrack(rig, character: Model, name: string): AnimationTrack?
	local id = Config.AnimationIds[name]
	if type(id) ~= "string" or id == "" then
		return nil
	end
	local cached = rig.assets[name]
	if cached ~= nil then
		return cached or nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	local track = nil
	if animator then
		local animation = Instance.new("Animation")
		animation.AnimationId = id
		local ok, result = pcall(function()
			return animator:LoadAnimation(animation)
		end)
		if ok and result then
			track = result
			track.Priority = Enum.AnimationPriority.Action
		else
			warn(string.format("[Animations] could not load %s (%s): %s", name, id, tostring(result)))
		end
	end
	rig.assets[name] = track or false
	return track
end

-- options: speed, weight, fadeIn, fadeOut
function ProcAnimator.play(character: Model?, name: string, options: { [string]: number }?)
	if not character or not character.Parent then
		return nil
	end
	local rig = getRig(character)
	local anim = Animations.get(name, rig.kind)
	if not anim then
		return nil
	end
	local opts = options or {}

	local asset = assetTrack(rig, character, name)
	if asset then
		asset.Looped = anim.loop == true
		asset:Play(opts.fadeIn or anim.fadeIn or 0.08, opts.weight or 1, opts.speed or 1)
		return asset
	end

	for i = #rig.tracks, 1, -1 do
		if rig.tracks[i].name == name then
			table.remove(rig.tracks, i)
		end
	end
	local track = {
		name = name,
		anim = anim,
		time = 0,
		elapsed = 0,
		speed = opts.speed or 1,
		weight = 0,
		maxWeight = opts.weight or 1,
		fadeIn = math.max(0.001, opts.fadeIn or anim.fadeIn or 0.08),
		fadeOut = math.max(0.001, opts.fadeOut or anim.fadeOut or 0.15),
		priority = anim.priority or 1,
		loop = anim.loop == true,
		stopping = false,
		stopElapsed = 0,
		pose = {},
	}
	-- Вставляем по приоритету: более важные применяются последними.
	local index = #rig.tracks + 1
	for i, other in ipairs(rig.tracks) do
		if other.priority > track.priority then
			index = i
			break
		end
	end
	table.insert(rig.tracks, index, track)
	return track
end

function ProcAnimator.stop(character: Model?, name: string)
	local rig = character and rigs[character]
	if not rig then
		return
	end
	local asset = rig.assets[name]
	if asset then
		local anim = Animations.get(name, rig.kind)
		asset:Stop(anim and anim.fadeOut or 0.15)
	end
	for _, track in ipairs(rig.tracks) do
		if track.name == name then
			track.stopping = true
		end
	end
end

function ProcAnimator.isPlaying(character: Model?, name: string): boolean
	local rig = character and rigs[character]
	if not rig then
		return false
	end
	local asset = rig.assets[name]
	if asset and asset.IsPlaying then
		return true
	end
	for _, track in ipairs(rig.tracks) do
		if track.name == name and not track.stopping then
			return true
		end
	end
	return false
end

local function stepRig(rig, dt: number)
	-- Продвигаем дорожки и считаем их вес.
	for i = #rig.tracks, 1, -1 do
		local track = rig.tracks[i]
		local anim = track.anim
		track.elapsed += dt
		track.time += dt * track.speed
		local weight = math.min(1, track.elapsed / track.fadeIn)
		local done = false
		if track.loop then
			if track.time >= anim.length then
				track.time %= anim.length
			end
		else
			local remaining = anim.length - track.time
			if remaining <= 0 then
				done = true
			else
				weight *= math.clamp(remaining / track.fadeOut, 0, 1)
			end
		end
		if track.stopping then
			track.stopElapsed += dt
			local k = 1 - track.stopElapsed / track.fadeOut
			if k <= 0 then
				done = true
			else
				weight *= k
			end
		end
		if done then
			table.remove(rig.tracks, i)
		else
			track.weight = weight * track.maxWeight
			AnimSampler.sample(anim, track.time, track.pose)
		end
	end

	-- Смешиваем с тем, что выставил стандартный Animator.
	for name, motor in pairs(rig.motors) do
		local base = motor.Transform
		local last = rig.written[name]
		local driven = true
		if last and base == last then
			-- Animator в этом кадре сустав не трогал: исходим из нейтральной позы.
			base = CFrame.identity
			driven = false
		end
		local result = base
		local touched = false
		local frame = rig.frames[name]
		for _, track in ipairs(rig.tracks) do
			local value = track.pose[name]
			if value and track.weight > 0 then
				local pivots = track.anim.pivots
				local pivot = pivots and pivots[name]
				local s = rig.scale or 1
				if s ~= 1 then
					value = { value[1], value[2], value[3], value[4] * s, value[5] * s, value[6] * s }
					if pivot then
						pivot = { pivot[1] * s, pivot[2] * s, pivot[3] * s }
					end
				end
				local desired = AnimSampler.toCFrame(value, pivot)
				result = result:Lerp(frame.inverse * desired * frame.rotation, track.weight)
				touched = true
			end
		end
		if touched then
			motor.Transform = result
			rig.written[name] = result
		elseif last then
			if not driven then
				motor.Transform = CFrame.identity
			end
			rig.written[name] = nil
		end
	end
end

function ProcAnimator.start()
	RunService.Stepped:Connect(function(_, dt)
		for character, rig in pairs(rigs) do
			if not character.Parent then
				rigs[character] = nil
			elseif #rig.tracks > 0 or next(rig.written) ~= nil then
				stepRig(rig, dt)
			end
		end
	end)
end

return ProcAnimator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Sfx</string>
            <string name="Source"><![CDATA[-- Звуки. Список и громкость — в Config.Sounds.

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage:WaitForChild("Shared").Config)

local Sfx = {}

-- where: Vector3 (точка в мире), BasePart (звук едет с деталью) или nil (обычный 2D-звук).
function Sfx.play(name: string, where: any, options: { [string]: number }?)
	local def = Config.Sounds[name]
	if not def then
		return
	end
	local opts = options or {}

	local sound = Instance.new("Sound")
	sound.SoundId = def.Id
	sound.Volume = def.Volume * (opts.volume or 1)
	sound.PlaybackSpeed = def.Pitch * (opts.pitch or 1) * (0.96 + math.random() * 0.08)
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.RollOffMinDistance = 20
	sound.RollOffMaxDistance = 260

	if typeof(where) == "Vector3" then
		local holder = Instance.new("Part")
		holder.Name = "SoundPoint"
		holder.Anchored = true
		holder.CanCollide = false
		holder.CanQuery = false
		holder.CanTouch = false
		holder.Transparency = 1
		holder.Size = Vector3.new(0.2, 0.2, 0.2)
		holder.CFrame = CFrame.new(where)
		holder.Parent = Workspace
		sound.Parent = holder
		Debris:AddItem(holder, 4)
	elseif typeof(where) == "Instance" then
		sound.Parent = where
		Debris:AddItem(sound, 4)
	else
		sound.Parent = SoundService
		Debris:AddItem(sound, 4)
	end
	sound:Play()
end

return Sfx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[-- Короткие функции «что сейчас с моим игроком и матчем». Используются всеми клиентскими модулями.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Styles = require(Shared.Styles)

local State = {}

State.player = Players.LocalPlayer
State.remotes = ReplicatedStorage:WaitForChild("Remotes")
State.action = State.remotes:WaitForChild("Action") :: RemoteEvent
State.fx = State.remotes:WaitForChild("Fx") :: RemoteEvent
State.match = ReplicatedStorage:WaitForChild("MatchState")

function State.now(): number
	return Workspace:GetServerTimeNow()
end

function State.character(): Model?
	return State.player.Character
end

function State.root(): BasePart?
	local character = State.player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function State.humanoid(): Humanoid?
	local character = State.player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

function State.hasBall(): boolean
	local character = State.player.Character
	return character ~= nil and character:GetAttribute("HasBall") == true
end

function State.isStunned(): boolean
	local character = State.player.Character
	if not character then
		return true
	end
	local untilTime = character:GetAttribute("StunnedUntil")
	return type(untilTime) == "number" and State.now() < untilTime
end

function State.phase(): string
	return State.match:GetAttribute("Phase") or "Waiting"
end

function State.isLive(): boolean
	return State.phase() == "Playing"
end

function State.style()
	return Styles.get(State.player:GetAttribute("Style"))
end

function State.stamina(): number
	return State.player:GetAttribute("Stamina") or 0
end

function State.resonance(): number
	return State.player:GetAttribute("Resonance") or 0
end

-- Сколько секунд осталось до конца перезарядки.
function State.cooldown(key: string): number
	local ready = State.player:GetAttribute("CD_" .. key)
	if type(ready) ~= "number" then
		return 0
	end
	return math.max(0, ready - State.now())
end

function State.send(name: string, ...)
	State.action:FireServer(name, ...)
end

return State
]]></string>
          </Properties>
        </Item>
      </Item>
