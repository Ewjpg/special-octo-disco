				["Neck"] = { 0, 0, 0, 0.0069, 0, 0.0001, 1 },
				["Right Hip"] = { 0.107, 0.002, 0, 0.0038, 0.0002, -0.0203, 0.9998 },
				["Right Shoulder"] = { 0, -0.013, 0.004, -0.0131, 0, 0.0015, 0.9999 },
				["RootJoint"] = { 0.006, -0.011, -0.011, 0.0069, 0.0035, -0.0001, 1 },
			},
		},
		{
			t = 0.7667,
			pose = {
				["Left Hip"] = { -0.071, 0.004, 0, -0.0015, 0.0001, 0.0181, 0.9998 },
				["Left Shoulder"] = { 0, -0.004, 0.001, -0.0036, -0.0008, 0, 1 },
				["Neck"] = { 0, 0, 0, 0.0019, 0, 0, 1 },
				["Right Hip"] = { 0.045, 0, 0, 0.0011, 0, -0.0097, 1 },
				["Right Shoulder"] = { 0, -0.004, 0.001, -0.0036, 0, 0.0004, 1 },
				["RootJoint"] = { 0.002, -0.003, -0.003, 0.0019, 0.001, 0, 1 },
			},
		},
		{
			t = 0.8,
			pose = {
