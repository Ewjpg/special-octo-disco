				RightShoulder = { 88, 0, 8 },
				RightElbow = { 8, 0, 0 },
				LeftShoulder = { -30, 0, -24 },
				LeftElbow = { 50, 0, 0 },
				RightHip = { 16, 0, 10 },
				RightKnee = { -14, 0, 0 },
				LeftHip = { -18, 0, -10 },
				LeftKnee = { -16, 0, 0 },
			},
		},
		{ t = 0.55, ease = "quadInOut", pose = REST },
	},
}

-- Включение ульты: сжался — и раскрылся.
R15.PowerStance = {
	length = 0.95,
	fadeIn = 0.08,
	fadeOut = 0.22,
	priority = 5,
	keys = {
		{
			t = 0.12,
			ease = "quadOut",
			pose = {
