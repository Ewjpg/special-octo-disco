      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">FieldSpec</string>
          <string name="Source"><![CDATA[-- Размеры поля. Используется и сервером (постройка, голы), и клиентом (прицел, боты).
-- Поле лежит вдоль оси X: ворота HOME на -X, ворота AWAY на +X. Верх газона = Origin.Y.

local FieldSpec = {}

FieldSpec.Origin = Vector3.new(0, 0, 0)

FieldSpec.Length = 600
FieldSpec.Width = 380
FieldSpec.HalfLength = FieldSpec.Length / 2
FieldSpec.HalfWidth = FieldSpec.Width / 2

-- Зона за линиями до бортов: мяч не уходит в аут, а отскакивает от борта.
FieldSpec.EndMargin = 24
FieldSpec.SideMargin = 16
FieldSpec.WallHeight = 80

FieldSpec.GoalWidth = 60
FieldSpec.GoalHeight = 22
FieldSpec.GoalDepth = 14
FieldSpec.PostRadius = 0.9

FieldSpec.PenaltyDepth = 100
FieldSpec.PenaltyWidth = 210
FieldSpec.GoalAreaDepth = 36
FieldSpec.GoalAreaWidth = 124
FieldSpec.PenaltySpot = 66
FieldSpec.PenaltyArc = 45
FieldSpec.CenterRadius = 55
FieldSpec.LineWidth = 1.4

-- Центр линии ворот на уровне газона. side: -1 или 1.
function FieldSpec.goalCenter(side: number): Vector3
	return FieldSpec.Origin + Vector3.new(side * FieldSpec.HalfLength, 0, 0)
end

-- Куда атакует команда, которая защищает ворота side.
function FieldSpec.attackDir(side: number): Vector3
	return Vector3.new(-side, 0, 0)
end

-- Точка относительно своих ворот: forward — от ворот к центру, lateral — вбок.
function FieldSpec.fromOwnGoal(side: number, forward: number, lateral: number): Vector3
	return FieldSpec.Origin + Vector3.new(side * (FieldSpec.HalfLength - forward), 0, lateral)
end

-- Ограничить точку игровой зоной (внутри бортов).
function FieldSpec.clampToArena(pos: Vector3, pad: number?): Vector3
	local p = pad or 0
	local rel = pos - FieldSpec.Origin
	local maxX = FieldSpec.HalfLength + FieldSpec.EndMargin - p
	local maxZ = FieldSpec.HalfWidth + FieldSpec.SideMargin - p
	return FieldSpec.Origin + Vector3.new(math.clamp(rel.X, -maxX, maxX), rel.Y, math.clamp(rel.Z, -maxZ, maxZ))
end

-- Мяч в створе ворот? Возвращает сторону ворот (-1/1) или nil.
function FieldSpec.goalSideAt(pos: Vector3, ballRadius: number): number?
	local rel = pos - FieldSpec.Origin
	local ax = math.abs(rel.X)
	if ax < FieldSpec.HalfLength + ballRadius * 0.6 then
		return nil
	end
	if ax > FieldSpec.HalfLength + FieldSpec.GoalDepth + 4 then
		return nil
	end
	if math.abs(rel.Z) > FieldSpec.GoalWidth / 2 - FieldSpec.PostRadius then
		return nil
	end
	if rel.Y > FieldSpec.GoalHeight or rel.Y < -3 then
		return nil
	end
	return rel.X > 0 and 1 or -1
end

return FieldSpec
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Mover</string>
          <string name="Source"><![CDATA[-- Резкие перемещения персонажа: рывок и телепорт на короткую дистанцию.
-- Персонажем игрока управляет его клиент, поэтому игрок вызывает это у себя, а сервер — только для ботов.

local FieldSpec = require(script.Parent.FieldSpec)
local Util = require(script.Parent.Util)

local Mover = {}

-- Рывок по горизонтали с постоянной скоростью. Гравитация и прыжок не затрагиваются.
function Mover.dash(root: BasePart, direction: Vector3, speed: number, duration: number)
	local dir = Util.flatUnit(direction, root.CFrame.LookVector)

	for _, name in ipairs({ "DashVelocity", "DashAttachment" }) do
		local old = root:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end

	local attachment = Instance.new("Attachment")
	attachment.Name = "DashAttachment"
	attachment.Parent = root

	local velocity = Instance.new("LinearVelocity")
	velocity.Name = "DashVelocity"
	velocity.Attachment0 = attachment
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	velocity.PrimaryTangentAxis = Vector3.new(1, 0, 0)
	velocity.SecondaryTangentAxis = Vector3.new(0, 0, 1)
	velocity.PlaneVelocity = Vector2.new(dir.X, dir.Z) * speed
	velocity.MaxForce = 400000
	velocity.Parent = root

	task.delay(duration, function()
		velocity:Destroy()
		attachment:Destroy()
	end)
end

-- Мгновенный перенос вперёд, но не дальше бортов арены.
function Mover.blink(root: BasePart, direction: Vector3, distance: number)
	local dir = Util.flatUnit(direction, root.CFrame.LookVector)
	local target = FieldSpec.clampToArena(root.Position + dir * distance, 3)
	root.CFrame = CFrame.lookAt(target, target + dir)
end

return Mover
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source"><![CDATA[-- Простейший сигнал: Connect / Fire. Нужен, чтобы серверные модули не зависели друг от друга напрямую.

local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal:Connect(fn)
	table.insert(self._handlers, fn)
	local handlers = self._handlers
	return {
		Disconnect = function()
			local index = table.find(handlers, fn)
			if index then
				table.remove(handlers, index)
			end
		end,
	}
end

function Signal:Fire(...)
	for _, fn in ipairs(table.clone(self._handlers)) do
		task.spawn(fn, ...)
	end
end

return Signal
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Styles</string>
          <string name="Source"><![CDATA[-- Реестр стилей. Каждый модуль в этой папке — один стиль (один OC).
-- Чтобы добавить свой: скопируй _Template, переименуй, поменяй id/name/способности.
-- Модули, имя которых начинается с "_", не загружаются.

local Styles = {}

Styles.list = {} -- стили, доступные в меню выбора (по порядку order)
Styles.byId = {}

for _, child in ipairs(script:GetChildren()) do
	if child:IsA("ModuleScript") and string.sub(child.Name, 1, 1) ~= "_" then
		local style = require(child) :: any
		style.id = style.id or child.Name
		style.stats = style.stats or {}
		style.abilities = style.abilities or {}
		Styles.byId[style.id] = style
		if style.selectable ~= false then
			table.insert(Styles.list, style)
		end
	end
end

table.sort(Styles.list, function(a, b)
	return (a.order or 99) < (b.order or 99)
end)

-- Если выбираемых стилей нет, все играют базовым стилем без способностей,
-- а меню стилей, способности и Резонанс в интерфейсе скрыты.
Styles.enabled = #Styles.list > 0
Styles.default = Styles.enabled and Styles.list[1].id or "Base"

function Styles.get(id: string?)
	return Styles.byId[id or Styles.default] or Styles.byId[Styles.default]
end

return Styles
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Base</string>
            <string name="Source"><![CDATA[-- Базовый стиль: без способностей. Его получают все игроки, пока в игре нет ни одного выбираемого стиля.

return {
	id = "Base",
	selectable = false,
	name = "Player",
	role = "",
	color = Color3.fromRGB(255, 255, 255),
	color2 = Color3.fromRGB(220, 224, 232),
	stats = {},
	abilities = {},
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Keeper</string>
            <string name="Source"><![CDATA[-- Служебный стиль ботов-вратарей. В меню выбора не показывается.

return {
	id = "Keeper",
	selectable = false,
	name = "Goalkeeper",
	role = "Bot",
	color = Color3.fromRGB(240, 226, 90),
	color2 = Color3.fromRGB(255, 255, 255),
	stats = {},
	abilities = {},
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">_Template</string>
            <string name="Source"><![CDATA[-- ШАБЛОН СТИЛЯ (твой OC).
-- 1. Скопируй этот файл, назови без подчёркивания в начале (например Phoenix.luau).
-- 2. Поменяй id, name, цвета, характеристики и способности.
-- 3. Стиль сам появится в меню выбора. Модули с "_" в начале имени игра не загружает.
-- Готовые примеры стилей лежат в папке archive/styles (сейчас отключены).
--
-- У каждой способности три функции:
--   predict(me, input) — выполняется СРАЗУ на клиенте игрока (рывок, анимация). Необязательна.
--   server(ctx)        — настоящая логика на сервере. Вернёт false — способность не сработала, перезарядки нет.
--   client(fx, data)   — эффекты у всех игроков. data.stage — то, что сервер передал в ctx.fx("stage", {...}).
--
-- Что есть в ctx (сервер):
--   ctx.actor, ctx.root, ctx.character, ctx.player
--   ctx.aim       — куда смотрит камера (по горизонтали), ctx.aimLook — то же с наклоном
--   ctx.move      — куда игрок идёт (или нулевой вектор)
--   ctx.now       — серверное время
--   ctx.enemyGoal / ctx.ownGoal — центры ворот
--   ctx.Ball      — kick(actor, velocity, opts), addForce(time, fn), knockLoose(v, actor), attach(actor),
--                   position(), velocity(), holder, lock(time), setFx(color, time)
--   ctx.Actors    — setImmune, addSpeedMod, setFlag, stun, inRadius, isImmune...
--   ctx.fx(stage, data)      — запустить client(...) у всех
--   ctx.after(sec, fn)       — выполнить позже (если игрок жив и матч идёт)
--   ctx.loop(sec, step, fn)  — повторять fn каждые step секунд
--   ctx.slide{ duration, radius, take, stun, dir } — «окно отбора», как у подката
--
-- Что есть в fx (клиент): sphere, disc, pillar, burst, light, beam, zone, aura, orbit, afterimage,
--   charTrail, ghostBall, shake, flash, sound, anim, every, ground, ball, rootOf, isLocal.
-- Что есть в me (predict): me.dash(dir, speed, time), me.blink(dir, distance), me.anim(name).
-- Имена анимаций — в Shared/Animations.

local COLOR = Color3.fromRGB(255, 255, 255)
local COLOR2 = Color3.fromRGB(200, 200, 200)

return {
	id = "Template",
	order = 50,
	name = "Название",
	role = "Роль",
	tagline = "Коронная фраза.",
	description = "Пара предложений о стиле.",
	color = COLOR,
	color2 = COLOR2,

	-- 1.0 = обычное значение. speed — бег, shot — сила удара, stamina — запас выносливости,
	-- tackle — дальность отбора, trap — насколько быстрый мяч можно принять, dribble — скорость с мячом (по умолчанию 0.94).
	stats = { speed = 1.0, shot = 1.0, stamina = 1.0, tackle = 1.0, trap = 1.0 },

	abilities = {
		{
			id = "ExampleShot",
			name = "Пример удара",
			desc = "Быстрый удар туда, куда смотрит камера.",
			cooldown = 8,
			needsBall = true, -- needsNoBall = true — наоборот, только без мяча

			predict = function(me)
				me.anim("Shoot")
			end,

			server = function(ctx)
				local dir = ctx.Util.withElevation(ctx.aim, 10)
				ctx.Ball.kick(ctx.actor, dir * 170, { kind = "Shot", untrappable = 0.4, color = COLOR, colorTime = 1.5 })
				ctx.fx("shot", { position = ctx.Ball.position() })
			end,

			client = function(fx, data)
				if not fx.isLocal(data.character) then
					fx.anim(data.character, "Shoot")
				end
				fx.sphere(data.position, COLOR, { from = 2, to = 14, time = 0.3 })
				fx.sound("PowerKick", data.position)
			end,
		},
		-- вторая способность...
		-- третья — ульта: добавь ultimate = true, она требует полный Резонанс.
	},
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[-- Мелкая математика, общая для сервера и клиента.

local Util = {}

local FORWARD = Vector3.new(0, 0, -1)

function Util.flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

function Util.unit(v: Vector3, fallback: Vector3?): Vector3
	if v.Magnitude > 1e-4 then
		return v.Unit
	end
	return fallback or FORWARD
end

function Util.flatUnit(v: Vector3, fallback: Vector3?): Vector3
	return Util.unit(Util.flat(v), fallback)
end

function Util.lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

-- Проверка вектора, пришедшего от клиента.
function Util.isVector(v: any): boolean
	if typeof(v) ~= "Vector3" then
		return false
	end
	local m = v.Magnitude
	return m == m and m < 1e6
end

-- Горизонтальное направление + подъём в градусах.
function Util.withElevation(flatDir: Vector3, degrees: number): Vector3
	local rad = math.rad(degrees)
	local dir = Util.flatUnit(flatDir)
	return (dir * math.cos(rad) + Vector3.new(0, math.sin(rad), 0)).Unit
end

function Util.elevationOf(dir: Vector3): number
	return math.deg(math.asin(math.clamp(Util.unit(dir).Y, -1, 1)))
end

-- Угол между двумя направлениями в градусах.
function Util.angleBetween(a: Vector3, b: Vector3): number
	return math.deg(math.acos(math.clamp(Util.unit(a):Dot(Util.unit(b)), -1, 1)))
end

-- Ближайшая к p точка на отрезке a-b.
function Util.closestOnSegment(a: Vector3, b: Vector3, p: Vector3): Vector3
	local ab = b - a
	local len2 = ab:Dot(ab)
	if len2 < 1e-6 then
		return a
	end
	local t = math.clamp((p - a):Dot(ab) / len2, 0, 1)
	return a + ab * t
end

-- Повернуть горизонтальный вектор вокруг вертикали (градусы, + = влево).
function Util.rotateY(v: Vector3, degrees: number): Vector3
	local rad = math.rad(degrees)
	local c, s = math.cos(rad), math.sin(rad)
	return Vector3.new(v.X * c + v.Z * s, v.Y, -v.X * s + v.Z * c)
end

-- Вектор вправо от направления движения (на плоскости).
function Util.rightOf(dir: Vector3): Vector3
	local d = Util.flatUnit(dir)
	return Vector3.new(-d.Z, 0, d.X)
end

-- Расстояние от центра HumanoidRootPart до земли. У R6 HipHeight равен 0, поэтому берётся длина ноги
-- (2 студа у обычного персонажа, меньше у уменьшенного через Model:ScaleTo).
function Util.groundOffset(root: BasePart, humanoid: Humanoid): number
	local legs = humanoid.HipHeight
	if humanoid.RigType == Enum.HumanoidRigType.R6 then
		local character = humanoid.Parent
		local leg = character and character:FindFirstChild("Right Leg")
		legs = leg and leg:IsA("BasePart") and leg.Size.Y or 2
	end
	return root.Size.Y / 2 + legs
end

-- Верхний регистр с поддержкой кириллицы (string.upper понимает только латиницу).
function Util.upper(text: string): string
	local out = {}
	for _, code in utf8.codes(text) do
		if code >= 0x430 and code <= 0x44F then
			code -= 0x20
		elseif code == 0x451 then
			code = 0x401 -- ё -> Ё
		elseif code >= 97 and code <= 122 then
			code -= 32
		end
		table.insert(out, utf8.char(code))
	end
	return table.concat(out)
end

function Util.easeOutQuad(t: number): number
	return 1 - (1 - t) * (1 - t)
end

return Util
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="14">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="15">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">ActionService</string>
          <string name="Source"><![CDATA[-- Принимает действия игроков (RemoteEvent "Action"), проверяет их и выполняет:
-- удар, пас, навес, подкат, рывок, способности стиля, выбор стиля.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local F = require(Shared.FieldSpec)
local Styles = require(Shared.Styles)
local Util = require(Shared.Util)
local Actors = require(script.Parent.Actors)
local Ball = require(script.Parent.BallService)
local Match = require(script.Parent.MatchService)
local Net = require(script.Parent.Net)

local SHOT, PASS, LOB = Config.Shot, Config.Pass, Config.Lob
local TACKLE, DASH, DRIBBLE, RES = Config.Tackle, Config.Dash, Config.Dribble, Config.Resonance

local Actions = {}

local handlers = {}
local budgets = {} -- [Player] = { tokens, time } — защита от спама событиями

local function ready(actor, t: number): boolean
	return Match.isLive() and Actors.canAct(actor, t)
end

-- Направление от клиента -> безопасное горизонтальное направление (или nil).
local function flatDir(value: any, fallback: Vector3): Vector3?
	if value == nil then
		return fallback
	end
	if not Util.isVector(value) then
		return nil
	end
	return Util.flatUnit(value, fallback)
end

local function setCharging(actor, on: boolean)
	if actor.charging == on then
		return
	end
	actor.charging = on
	if actor.character.Parent then
		actor.character:SetAttribute("Charging", on)
	end
	Net.fx("Charge", { character = actor.character, on = on })
end

-- Лучший партнёр для паса в конусе по направлению dir.
function Actions.findPassTarget(actor, dir: Vector3, maxAngle: number, maxRange: number)
	local origin = actor.root.Position
	local best, bestScore
	for _, other in pairs(Actors.byCharacter) do
		if other ~= actor and other.alive and other.team == actor.team then
			local to = Util.flat(other.root.Position - origin)
			local distance = to.Magnitude
			if distance > 6 and distance <= maxRange then
				local angle = Util.angleBetween(dir, to)
				if angle <= maxAngle then
					local score = angle * 1.5 + distance * 0.08
					if not bestScore or score < bestScore then
						best, bestScore = other, score
					end
				end
			end
		end
	end
	return best
end

local function kickFx(actor, kind: string, power: number)
	Net.fx("Kick", { character = actor.character, kind = kind, power = power, position = Ball.position() })
end

---------------------------------------------------------------------------
-- Базовые действия
---------------------------------------------------------------------------

function handlers.Sprint(actor, on)
	actor.sprinting = on == true
end

function handlers.Charge(actor, on)
	local t = Actors.now()
	setCharging(actor, on == true and actor.hasBall and ready(actor, t))
end

function handlers.Shoot(actor, direction, charge)
	local t = Actors.now()
	setCharging(actor, false)
	if not ready(actor, t) or not actor.hasBall or not Util.isVector(direction) then
		return
	end
	local power01 = math.clamp(tonumber(charge) or 0, 0, 1)
	local flat = Util.flatUnit(direction, actor.root.CFrame.LookVector)
	local elevation = math.clamp(Util.elevationOf(direction), SHOT.MinElevation, SHOT.MaxElevation)
	local power = Util.lerp(SHOT.MinPower, SHOT.MaxPower, power01) * (actor.style.stats.shot or 1)
	Ball.kick(actor, Util.withElevation(flat, elevation) * power, { kind = "Shot" })
	kickFx(actor, "Shot", power01)
end

function handlers.Pass(actor, direction)
	local t = Actors.now()
	setCharging(actor, false)
	if not ready(actor, t) or not actor.hasBall then
		return
	end
	local dir = flatDir(direction, actor.root.CFrame.LookVector)
	if not dir then
		return
	end
	local target = Actions.findPassTarget(actor, dir, PASS.AssistAngle, PASS.MaxRange)
	local speed = PASS.MinSpeed + 14
	if target then
		local origin = actor.root.Position
		local to = Util.flat(target.root.Position - origin)
		speed = math.clamp(PASS.MinSpeed + to.Magnitude * 0.5, PASS.MinSpeed, PASS.MaxSpeed)
		-- Упреждение: бьём туда, где партнёр будет, когда мяч долетит.
		local lead = Util.flat(target.root.AssemblyLinearVelocity) * (to.Magnitude / speed) * 0.85
		dir = Util.flatUnit(to + lead, dir)
	end
	speed *= actor.style.stats.pass or 1
	Ball.kick(actor, Util.withElevation(dir, PASS.Elevation) * speed, {
		kind = "Pass",
		noPickup = 0.5,
		passTarget = target,
	})
	kickFx(actor, "Pass", 0.3)
end

function handlers.Lob(actor, direction)
	local t = Actors.now()
	setCharging(actor, false)
	if not ready(actor, t) or not actor.hasBall then
		return
	end
	local dir = flatDir(direction, actor.root.CFrame.LookVector)
	if not dir then
		return
	end
	local speed = LOB.DefaultSpeed
	local target = Actions.findPassTarget(actor, dir, PASS.AssistAngle, PASS.MaxRange)
	if target then
		local to = Util.flat(target.root.Position - actor.root.Position)
		local flightGuess = to.Magnitude / (LOB.DefaultSpeed * math.cos(math.rad(LOB.Elevation)))
		local aimAt = to + Util.flat(target.root.AssemblyLinearVelocity) * flightGuess * 0.8
		dir = Util.flatUnit(aimAt, dir)
		-- Скорость, при которой мяч упадёт на нужной дистанции.
		local gravity = Ball.gravity()
		local needed = math.sqrt(aimAt.Magnitude * gravity / math.sin(math.rad(LOB.Elevation * 2)))
		speed = math.clamp(needed, LOB.MinSpeed, LOB.MaxSpeed)
	end
	Ball.kick(actor, Util.withElevation(dir, LOB.Elevation) * speed, {
		kind = "Pass",
		noPickup = 0.6,
		passTarget = target,
	})
	kickFx(actor, "Lob", 0.5)
end

function handlers.Tackle(actor, direction)
	local t = Actors.now()
	if not ready(actor, t) or actor.hasBall or not Actors.cooldownReady(actor, "Tackle", t) then
		return
	end
	local dir = flatDir(direction, actor.root.CFrame.LookVector)
	if not dir or not Actors.spendStamina(actor, TACKLE.Stamina) then
		return
	end
	Actors.setCooldown(actor, "Tackle", TACKLE.Cooldown)
	actor.slide = {
		expires = t + TACKLE.Duration,
		radius = TACKLE.Radius * (actor.style.stats.tackle or 1),
		dir = dir,
		take = false,
		stun = TACKLE.StunTime,
		done = false,
	}
	Net.fx("Slide", { character = actor.character, duration = TACKLE.Duration })
end

function handlers.Dash(actor, direction)
	local t = Actors.now()
	if not ready(actor, t) or not Actors.cooldownReady(actor, "Dash", t) then
		return
	end
	local dir = flatDir(direction, actor.root.CFrame.LookVector)
	if not dir or not Actors.spendStamina(actor, DASH.Stamina) then
		return
	end
	Actors.setCooldown(actor, "Dash", DASH.Cooldown)
	Net.fx("Dash", { character = actor.character, hasBall = actor.hasBall })
end

-- Дриблинг: финт с мячом. На короткое время игрока нельзя обокрасть подкатом.
function handlers.Dribble(actor, direction)
	local t = Actors.now()
	if not ready(actor, t) or not actor.hasBall or not Actors.cooldownReady(actor, "Dribble", t) then
		return
	end
	local dir = flatDir(direction, actor.root.CFrame.LookVector)
	if not dir or not Actors.spendStamina(actor, DRIBBLE.Stamina) then
		return
	end
	setCharging(actor, false)
	Actors.setCooldown(actor, "Dribble", DRIBBLE.Cooldown)
	Actors.setImmune(actor, DRIBBLE.ImmuneTime)
	Net.fx("Dribble", { character = actor.character })
end

---------------------------------------------------------------------------
-- Способности стиля
---------------------------------------------------------------------------

local function makeContext(actor, slot: number, aimLook: Vector3, move: Vector3, t: number)
	local ctx = {
		actor = actor,
		character = actor.character,
		root = actor.root,
		humanoid = actor.humanoid,
		player = actor.player,
		slot = slot,
		aim = Util.flatUnit(aimLook, actor.root.CFrame.LookVector),
		aimLook = aimLook,
		move = move,
		hasBall = actor.hasBall,
		now = t,
		enemyGoal = F.goalCenter(-actor.side),
		ownGoal = F.goalCenter(actor.side),
		Ball = Ball,
		Actors = Actors,
		Config = Config,
		Field = F,
		Util = Util,
	}

	function ctx.fx(stage: string, data: { [string]: any }?)
		local payload = data or {}
		payload.character = actor.character
		payload.style = actor.style.id
		payload.slot = slot
		payload.stage = stage
		Net.fx("Ability", payload)
	end

	function ctx.after(delay: number, fn: () -> ())
		task.delay(delay, function()
			if actor.alive and Match.isLive() then
				local ok, err = pcall(fn)
				if not ok then
					warn("[Ability] " .. tostring(err))
				end
			end
		end)
	end

	function ctx.loop(duration: number, interval: number, fn: (number) -> ())
		task.spawn(function()
			local elapsed = 0
			while elapsed < duration and actor.alive and Match.isLive() do
				local ok, err = pcall(fn, elapsed)
				if not ok then
					warn("[Ability] " .. tostring(err))
					return
				end
				elapsed += task.wait(interval)
			end
		end)
	end

	function ctx.slide(options: { [string]: any })
		actor.slide = {
			expires = Actors.now() + (options.duration or TACKLE.Duration),
			radius = options.radius or TACKLE.Radius,
			dir = Util.flatUnit(options.dir or ctx.aim, ctx.aim),
			take = options.take == true,
			stun = options.stun or TACKLE.StunTime,
			done = false,
		}
	end

	return ctx
end

function handlers.Ability(actor, slotValue, aimValue, moveValue)
	local t = Actors.now()
	local slot = tonumber(slotValue)
	if not slot or not ready(actor, t) then
		return
	end
	local ability = actor.style.abilities[slot]
	if not ability then
		return
	end
	local key = "A" .. slot
	if not Actors.cooldownReady(actor, key, t) then
		return
	end
	if ability.needsBall and not actor.hasBall then
		return
	end
	if ability.needsNoBall and actor.hasBall then
		return
	end
	if ability.ultimate and actor.data.resonance < RES.Max then
		return
	end

	local look = actor.root.CFrame.LookVector
	local aimLook = Util.isVector(aimValue) and Util.unit(aimValue, look) or look
	local move = Vector3.zero
	if Util.isVector(moveValue) and Util.flat(moveValue).Magnitude > 0.1 then
		move = Util.flatUnit(moveValue)
	end

	setCharging(actor, false)
	local ctx = makeContext(actor, slot, aimLook, move, t)
	local ok, result = pcall(ability.server, ctx)
	if not ok then
		warn(string.format("[Ability] %s.%s: %s", actor.style.id, tostring(ability.id), tostring(result)))
		return
	end
	if result == false then
		return
	end
	Actors.setCooldown(actor, key, ability.cooldown or 8)
	if ability.ultimate then
		actor.data.resonance = 0
	end
end

function handlers.SelectStyle(actor, styleId)
	if type(styleId) ~= "string" then
		return
	end
	local style = Styles.byId[styleId]
	if not style or style.selectable == false or style.id == actor.style.id then
		return
	end
	Actors.applyStyle(actor, style.id)
	-- Чтобы сменой стиля нельзя было обнулять перезарядки.
	for slot = 1, 3 do
		Actors.setCooldown(actor, "A" .. slot, 4)
	end
	actor.data.resonance = 0
	if actor.player then
		actor.player:SetAttribute("Style", style.id)
	end
	Net.fx("StyleChanged", { character = actor.character, style = style.id })
end

---------------------------------------------------------------------------
-- Отбор мяча
---------------------------------------------------------------------------

local function steal(actor, holder, slide, t: number)
	if slide.take then
		Ball.attach(actor)
	else
		Ball.knockLoose(slide.dir * TACKLE.KnockSpeed + Vector3.new(0, 14, 0), actor)
		actor.noPickupUntil = t + 0.15
	end
	holder.noPickupUntil = t + 1
	Actors.stun(holder, slide.stun)
	Actors.addResonance(actor, RES.Steal)
	Net.fx("Steal", { character = actor.character, victim = holder.character, position = Ball.position() })
end

-- Каждый кадр: проверяем активные подкаты/тараны.
function Actions.step()
	if not Match.isLive() then
		return
	end
	local t = Actors.now()
	local holder = Ball.holder
	if holder and not holder.alive then
		holder = nil -- владелец только что вышел или погиб: мяч освободит BallService
	end
	for _, actor in pairs(Actors.byCharacter) do
		local slide = actor.slide
		if slide then
			if t >= slide.expires or not actor.alive then
				actor.slide = nil
			elseif not slide.done and holder and holder ~= actor and holder.team ~= actor.team then
				local origin = actor.root.Position
				local toBall = Util.flat(Ball.position() - origin).Magnitude
				local toHolder = Util.flat(holder.root.Position - origin).Magnitude
				if math.min(toBall, toHolder) <= slide.radius then
					slide.done = true
					if Actors.isImmune(holder, t) then
						Actors.addResonance(holder, RES.Dodge)
						Net.fx("Dodge", { character = holder.character, by = actor.character })
					else
						steal(actor, holder, slide, t)
						holder = Ball.holder
					end
				end
			end
		end
	end
end

---------------------------------------------------------------------------

local function allow(player: Player): boolean
	local now = os.clock()
	local budget = budgets[player]
	if not budget then
		budget = { tokens = 40, time = now }
		budgets[player] = budget
	end
	budget.tokens = math.min(40, budget.tokens + (now - budget.time) * 30)
	budget.time = now
	if budget.tokens < 1 then
		return false
	end
	budget.tokens -= 1
	return true
end

function Actions.init()
	Net.Action.OnServerEvent:Connect(function(player: Player, name: any, ...)
		if type(name) ~= "string" or not allow(player) then
			return
		end
		local handler = handlers[name]
		local actor = Actors.ofPlayer(player)
		if handler and actor and actor.alive then
			handler(actor, ...)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		budgets[player] = nil
	end)

	-- Резонанс за удачные действия.
	Ball.Possessed:Connect(function(actor, _previous, shot)
		if shot and shot.kind == "Pass" and shot.kicker ~= actor and shot.team == actor.team then
			Actors.addResonance(actor, RES.PassDone)
			Actors.addResonance(shot.kicker, RES.PassDone)
		end
	end)
	Ball.Blocked:Connect(function(actor, shot)
		if shot and shot.team ~= actor.team then
			Actors.addResonance(actor, RES.Block)
		end
	end)
end

return Actions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Actors</string>
          <string name="Source"><![CDATA[-- «Актёр» — любой персонаж на поле: игрок или бот.
-- Здесь живёт всё его игровое состояние: выносливость, оглушение, бафы скорости, перезарядки.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Signal = require(Shared.Signal)
local Styles = require(Shared.Styles)
local Util = require(Shared.Util)
local Net = require(script.Parent.Net)

local P = Config.Player
local RES = Config.Resonance

local Actors = {}

Actors.byCharacter = {} -- [Model] = actor
Actors.live = false -- идёт ли игра (ставит MatchService)
Actors.Added = Signal.new()
Actors.Removed = Signal.new()

function Actors.now(): number
	return Workspace:GetServerTimeNow()
end

function Actors.get(character: Model?)
	if character then
		return Actors.byCharacter[character]
	end
	return nil
end

function Actors.ofPlayer(player: Player)
	return Actors.get(player.Character)
end

-- info: { team = "Home"|"Away", player?, data?, isBot?, isKeeper?, styleId? }
function Actors.register(character: Model, info)
	local humanoid = character:FindFirstChildOfClass("Humanoid") :: Humanoid?
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not humanoid or not root then
		return nil
	end

	local data = info.data or { styleId = info.styleId or Styles.default, resonance = 0, cooldowns = {} }
	local style = Styles.get(data.styleId)
	local staminaMax = P.MaxStamina * (style.stats.stamina or 1)

	local actor = {
		character = character,
		humanoid = humanoid,
		root = root,
		player = info.player,
		data = data,
		isBot = info.isBot == true,
		isKeeper = info.isKeeper == true,
		team = info.team,
		side = Config.Teams[info.team].Side,
		style = style,
		alive = true,
		groundOffset = Util.groundOffset(root, humanoid),

		stamina = staminaMax,
		staminaMax = staminaMax,
		lastStaminaUse = 0,
		exhausted = false,

		hasBall = false,
		sprinting = false,
		isSprinting = false,
		charging = false,
		frozen = false,
		stunnedUntil = 0,
		immuneUntil = 0,
		noPickupUntil = 0,

		speedMods = {},
		flags = {},
		slide = nil,
		baseSpeed = nil, -- боты: фиксированная скорость
		trapRadius = nil,
		trapMaxSpeed = nil,

		jumpPower = humanoid.JumpPower,
		jumpHeight = humanoid.JumpHeight,
		jumpLocked = false,
		repStamina = -1,
		repResonance = -1,
	}

	Actors.byCharacter[character] = actor
	character:SetAttribute("Team", info.team)
	character:SetAttribute("Style", style.id)
	character:SetAttribute("HasBall", false)
	character:SetAttribute("Charging", false)
	character:SetAttribute("StunnedUntil", 0)
	if actor.player then
		actor.player:SetAttribute("MaxStamina", math.floor(staminaMax + 0.5))
	end

	Actors.Added:Fire(actor)
	return actor
end

function Actors.unregister(character: Model)
	local actor = Actors.byCharacter[character]
	if not actor then
		return
	end
	actor.alive = false
	Actors.byCharacter[character] = nil
	Actors.Removed:Fire(actor)
end

-- Сменить стиль на лету.
function Actors.applyStyle(actor, styleId: string)
	local style = Styles.get(styleId)
	actor.style = style
	actor.data.styleId = style.id
	actor.staminaMax = P.MaxStamina * (style.stats.stamina or 1)
	actor.stamina = math.min(actor.stamina, actor.staminaMax)
	table.clear(actor.speedMods)
	table.clear(actor.flags)
	if actor.character.Parent then
		actor.character:SetAttribute("Style", style.id)
	end
	if actor.player then
		actor.player:SetAttribute("MaxStamina", math.floor(actor.staminaMax + 0.5))
	end
end

---------------------------------------------------------------------------
-- Состояния
---------------------------------------------------------------------------

function Actors.isStunned(actor, t: number?): boolean
	return (t or Actors.now()) < actor.stunnedUntil
end

-- Нельзя отобрать мяч: рывок, ульта или вратарь с мячом в руках.
function Actors.isImmune(actor, t: number?): boolean
	local now = t or Actors.now()
	if now < actor.immuneUntil then
		return true
	end
	if actor.flags.unstoppableUntil and now < actor.flags.unstoppableUntil then
		return true
	end
	return actor.isKeeper and actor.hasBall
end

function Actors.setImmune(actor, duration: number)
	actor.immuneUntil = math.max(actor.immuneUntil, Actors.now() + duration)
end

function Actors.canAct(actor, t: number?): boolean
	local now = t or Actors.now()
	return actor.alive and not actor.frozen and now >= actor.stunnedUntil
end

function Actors.stun(actor, duration: number): boolean
	local t = Actors.now()
	if actor.flags.unstoppableUntil and t < actor.flags.unstoppableUntil then
		return false
	end
	actor.stunnedUntil = math.max(actor.stunnedUntil, t + duration)
	actor.noPickupUntil = math.max(actor.noPickupUntil, t + duration + 0.25)
	actor.charging = false
	actor.slide = nil
	if actor.character.Parent then
		actor.character:SetAttribute("Charging", false)
		actor.character:SetAttribute("StunnedUntil", actor.stunnedUntil)
	end
	Net.fx("Stun", { character = actor.character, duration = duration })
	return true
end

function Actors.setFrozen(actor, frozen: boolean)
	actor.frozen = frozen
	if frozen then
		actor.charging = false
		actor.slide = nil
		if actor.character.Parent then
			actor.character:SetAttribute("Charging", false)
		end
	end
end

function Actors.addSpeedMod(actor, key: string, mult: number, duration: number)
	actor.speedMods[key] = { mult = mult, expires = Actors.now() + duration }
end

function Actors.removeSpeedMod(actor, key: string)
	actor.speedMods[key] = nil
end

function Actors.setFlag(actor, key: string, duration: number)
	actor.flags[key] = Actors.now() + duration
end

function Actors.hasFlag(actor, key: string, t: number?): boolean
	local expires = actor.flags[key]
	return expires ~= nil and (t or Actors.now()) < expires
end

---------------------------------------------------------------------------
-- Ресурсы
---------------------------------------------------------------------------

function Actors.spendStamina(actor, amount: number): boolean
	if actor.stamina < amount then
		return false
	end
	actor.stamina -= amount
	actor.lastStaminaUse = Actors.now()
	return true
end

function Actors.addResonance(actor, amount: number)
	if not actor then
		return
	end
	local data = actor.data
	data.resonance = math.clamp(data.resonance + amount, 0, RES.Max)
end

function Actors.cooldownReady(actor, key: string, t: number?): boolean
	local ready = actor.data.cooldowns[key]
	return ready == nil or (t or Actors.now()) >= ready
end

function Actors.setCooldown(actor, key: string, seconds: number)
	local ready = Actors.now() + seconds
	actor.data.cooldowns[key] = ready
	if actor.player then
		actor.player:SetAttribute("CD_" .. key, ready)
	end
end

---------------------------------------------------------------------------
-- Перемещение
---------------------------------------------------------------------------

function Actors.teleport(actor, position: Vector3, lookDir: Vector3?)
	local feet = Vector3.new(position.X, position.Y + actor.groundOffset + 0.1, position.Z)
	local dir = Util.flatUnit(lookDir or Vector3.new(-actor.side, 0, 0))
	actor.character:PivotTo(CFrame.lookAt(feet, feet + dir))
	actor.root.AssemblyLinearVelocity = Vector3.zero
end

function Actors.feetPosition(actor): Vector3
	return actor.root.Position - Vector3.new(0, actor.groundOffset, 0)
end

-- Все живые актёры в радиусе. filter(actor) -> boolean (необязательно).
function Actors.inRadius(position: Vector3, radius: number, filter: ((any) -> boolean)?)
	local result = {}
	for _, actor in pairs(Actors.byCharacter) do
		if actor.alive and Util.flat(actor.root.Position - position).Magnitude <= radius then
			if not filter or filter(actor) then
				table.insert(result, actor)
			end
		end
	end
	return result
end

function Actors.teamList(team: string, includeKeepers: boolean?)
	local result = {}
	for _, actor in pairs(Actors.byCharacter) do
		if actor.alive and actor.team == team and (includeKeepers or not actor.isKeeper) then
			table.insert(result, actor)
		end
	end
	return result
end

local function computeSpeed(actor, t: number): number
	if actor.frozen or t < actor.stunnedUntil then
		return 0
	end
	local stats = actor.style.stats
	local speed
	if actor.baseSpeed then
		speed = actor.baseSpeed
	else
		speed = (actor.isSprinting and P.SprintSpeed or P.WalkSpeed) * (stats.speed or 1)
		if actor.hasBall then
			speed *= stats.dribble or P.DribbleMult
		end
		if actor.charging then
			speed *= Config.Shot.ChargeMoveMult
		end
	end
	for key, mod in pairs(actor.speedMods) do
		if t >= mod.expires then
			actor.speedMods[key] = nil
		else
			speed *= mod.mult
		end
	end
	return speed
end

-- Вызывается каждый кадр сервера.
function Actors.step(dt: number)
	local t = Actors.now()
	for character, actor in pairs(Actors.byCharacter) do
		if not character.Parent or actor.humanoid.Health <= 0 then
			actor.alive = false
			continue
		end

		-- Выносливость.
		local moving = Util.flat(actor.root.AssemblyLinearVelocity).Magnitude > 3
		local canMove = not actor.frozen and t >= actor.stunnedUntil
		local sprint = actor.sprinting and moving and canMove and not actor.charging and not actor.exhausted
		if sprint then
			actor.stamina = math.max(0, actor.stamina - P.SprintDrain * dt)
			actor.lastStaminaUse = t
			if actor.stamina <= 0 then
				actor.exhausted = true
			end
		elseif t - actor.lastStaminaUse >= P.StaminaRegenDelay then
			actor.stamina = math.min(actor.staminaMax, actor.stamina + P.StaminaRegen * dt)
			if actor.exhausted and actor.stamina >= P.ExhaustedThreshold then
				actor.exhausted = false
			end
		end
		actor.isSprinting = sprint

		-- Резонанс копится сам, пока идёт игра.
		if Actors.live and not actor.isBot then
			actor.data.resonance = math.min(RES.Max, actor.data.resonance + RES.Passive * dt)
		end

		-- Скорость и прыжок.
		local speed = computeSpeed(actor, t)
		if math.abs(actor.humanoid.WalkSpeed - speed) > 0.05 then
			actor.humanoid.WalkSpeed = speed
		end
		local lockJump = speed <= 0
		if lockJump ~= actor.jumpLocked then
			actor.jumpLocked = lockJump
			actor.humanoid.JumpPower = lockJump and 0 or actor.jumpPower
			actor.humanoid.JumpHeight = lockJump and 0 or actor.jumpHeight
		end

		-- Атрибуты для интерфейса.
		local player = actor.player
		if player then
			local stamina = math.floor(actor.stamina + 0.5)
			if stamina ~= actor.repStamina then
				actor.repStamina = stamina
				player:SetAttribute("Stamina", stamina)
			end
			local resonance = math.floor(actor.data.resonance + 0.5)
			if resonance ~= actor.repResonance then
				actor.repResonance = resonance
				player:SetAttribute("Resonance", resonance)
			end
		end
	end
end

return Actors
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">BallService</string>
          <string name="Source"><![CDATA[-- Мяч. Сервер решает всё: у кого мяч, куда он летит, принят он или отбит, был ли гол.
--
-- Два состояния:
--   у игрока  — мяч приварен (Motor6D) к HumanoidRootPart и едет вместе с персонажем;
--   свободен  — обычная физика Roblox, владелец физики — сервер.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local F = require(Shared.FieldSpec)
local Signal = require(Shared.Signal)
local Util = require(Shared.Util)
local Actors = require(script.Parent.Actors)
local Net = require(script.Parent.Net)
local Physics = require(script.Parent.Physics)

local BALL = Config.Ball
local R = BALL.Radius
local UP = Vector3.new(0, 1, 0)

local Ball = {}

Ball.part = nil :: Part?
Ball.holder = nil -- актёр с мячом
Ball.active = false -- можно ли подбирать мяч и забивать
Ball.lastTouch = nil -- { actor, team, time, kind }
Ball.prevTouch = nil
Ball.shot = nil -- сведения о последнем ударе: { kicker, team, kind, time, untrappableUntil, speed, passTarget }
Ball.lockedUntil = 0 -- до этого времени мяч никто не может тронуть

Ball.Possessed = Signal.new() -- (actor, previousHolder, shotInfo)
Ball.Blocked = Signal.new() -- (actor, shotInfo)
Ball.Goal = Signal.new() -- (scoringTeam, scorer, assist, goalSide)

local joint: Motor6D? = nil
local lift: VectorForce = nil :: any
local ballMass = 1
local gravityScale = BALL.GravityScale
local gravityKickTime = 0 -- когда включили особую гравитацию удара
local gravityRestoreAt = 0 -- когда вернуть обычную
local forces = {} -- { fn = function(dt, part, t), expires = number }
local needOwner = false
local prevPos = Vector3.zero

local function createBall(): Part
	local part = Instance.new("Part")
	part.Name = "Ball"
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.new(R * 2, R * 2, R * 2)
	part.Material = Enum.Material.SmoothPlastic
	part.Color = Color3.fromRGB(246, 246, 250)
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CustomPhysicalProperties = PhysicalProperties.new(0.4, 0.45, 0.62, 1, 1)
	part.CollisionGroup = Physics.BALL
	part.RootPriority = -100 -- при ведении корнем сборки должен остаться персонаж
	part.CFrame = CFrame.new(F.Origin + Vector3.new(0, R + 0.05, 0))

	-- Тёмные «заплатки» по вершинам икосаэдра, чтобы было видно вращение.
	local phi = (1 + math.sqrt(5)) / 2
	local directions = {}
	for _, a in ipairs({ -1, 1 }) do
		for _, b in ipairs({ -phi, phi }) do
			table.insert(directions, Vector3.new(0, a, b).Unit)
			table.insert(directions, Vector3.new(a, b, 0).Unit)
			table.insert(directions, Vector3.new(b, 0, a).Unit)
		end
	end
	for _, dir in ipairs(directions) do
		local patch = Instance.new("Part")
		patch.Name = "Patch"
		patch.Shape = Enum.PartType.Cylinder
		patch.Size = Vector3.new(0.12, R * 0.82, R * 0.82)
		patch.Material = Enum.Material.SmoothPlastic
		patch.Color = Color3.fromRGB(28, 30, 40)
		patch.CanCollide = false
		patch.CanTouch = false
		patch.CanQuery = false
		patch.Massless = true
		patch.CastShadow = false
		patch.RootPriority = -127
		patch.CollisionGroup = Physics.BALL
		local position = part.Position + dir * (R - 0.03)
		patch.CFrame = CFrame.lookAt(position, position + dir) * CFrame.Angles(0, math.rad(90), 0)
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = part
		weld.Part1 = patch
		weld.Parent = patch
		patch.Parent = part
	end

	local center = Instance.new("Attachment")
	center.Name = "Center"
	center.Parent = part

	local force = Instance.new("VectorForce")
	force.Name = "Lift"
	force.Attachment0 = center
	force.RelativeTo = Enum.ActuatorRelativeTo.World
	force.ApplyAtCenterOfMass = true
	force.Force = Vector3.zero
	force.Enabled = false
	force.Parent = part
	lift = force

	part:SetAttribute("Held", false)
	part.Parent = Workspace
	ballMass = part.Mass
	return part
end

-- Подъёмная сила компенсирует часть гравитации: мяч летит дальше и «аниме-шнее».
local function refreshLift()
	local part = Ball.part :: Part
	if Ball.holder or part.Anchored then
		lift.Enabled = false
		return
	end
	lift.Force = Vector3.new(0, ballMass * Workspace.Gravity * (1 - gravityScale), 0)
	lift.Enabled = true
end

-- Физикой свободного мяча всегда владеет сервер.
local function claimOwnership()
	local part = Ball.part :: Part
	if part.Anchored then
		needOwner = false
		return
	end
	if part.AssemblyRootPart ~= part then
		needOwner = true
		return
	end
	local ok = pcall(function()
		part:SetNetworkOwner(nil)
	end)
	needOwner = not ok
end

local function releaseHolder()
	local actor = Ball.holder
	if joint then
		joint:Destroy()
		joint = nil
	end
	Ball.holder = nil
	if actor then
		actor.hasBall = false
		if actor.character.Parent then
			actor.character:SetAttribute("HasBall", false)
		end
	end
	local part = Ball.part :: Part
	part.Massless = false
	part.CanCollide = true
	part:SetAttribute("Held", false)
	claimOwnership()
	refreshLift()
end

function Ball.position(): Vector3
	return (Ball.part :: Part).Position
end

function Ball.velocity(): Vector3
	return (Ball.part :: Part).AssemblyLinearVelocity
end

function Ball.gravity(): number
	return Workspace.Gravity * gravityScale
end

function Ball.setGravityScale(scale: number)
	gravityScale = scale
	refreshLift()
end

-- Запомнить касание (нужно для авторства гола и передач).
function Ball.touch(actor, kind: string?)
	local last = Ball.lastTouch
	if last and last.actor ~= actor then
		Ball.prevTouch = last
	end
	Ball.lastTouch = { actor = actor, team = actor.team, time = Actors.now(), kind = kind or "hold" }
end

function Ball.lock(duration: number)
	Ball.lockedUntil = Actors.now() + duration
end

-- Дополнительная сила на мяч (подкрутка, притяжение...). fn(dt, part, t) вызывается каждый кадр.
function Ball.addForce(duration: number, fn)
	table.insert(forces, { fn = fn, expires = Actors.now() + duration })
end

-- Подсветка следа мяча на клиентах.
function Ball.setFx(color: Color3, duration: number)
	local part = Ball.part :: Part
	part:SetAttribute("FxColor", color)
	part:SetAttribute("FxUntil", Actors.now() + duration)
end

function Ball.attach(actor)
	local part = Ball.part :: Part
	if Ball.holder == actor then
		return
	end
	local previous = Ball.holder
	local shot = Ball.shot
	if previous then
		releaseHolder()
	end
	Ball.shot = nil
	table.clear(forces)

	part.Anchored = false
	part.AssemblyLinearVelocity = Vector3.zero
	part.AssemblyAngularVelocity = Vector3.zero
	part.CanCollide = false
	part.Massless = true
	lift.Enabled = false
	gravityScale = BALL.GravityScale

	local motor = Instance.new("Motor6D")
	motor.Name = "BallJoint"
	motor.Part0 = actor.root
	motor.Part1 = part
	motor.C0 = CFrame.new(0, -actor.groundOffset + R, -BALL.HoldDistance)
	motor.Parent = part
	joint = motor

	Ball.holder = actor
	actor.hasBall = true
	actor.character:SetAttribute("HasBall", true)
	part:SetAttribute("Held", true)
	part:SetAttribute("FxUntil", 0)
	Ball.touch(actor, "hold")
	Ball.Possessed:Fire(actor, previous, shot)
end

-- Удар по мячу. Работает и для игрока с мячом, и для свободного мяча (вторая фаза способностей).
-- opts: kind, noPickup, untrappable, gravityScale, gravityTime, passTarget, color, colorTime
-- gravityScale действует временно: до первого касания газона или gravityTime секунд (по умолчанию 1.2).
function Ball.kick(actor, velocity: Vector3, opts: { [string]: any }?)
	local options = opts or {}
	local part = Ball.part :: Part
	local t = Actors.now()

	if Ball.holder then
		local wasHolder = Ball.holder == actor
		releaseHolder()
		if wasHolder then
			local dir = Util.flatUnit(velocity, actor.root.CFrame.LookVector)
			local feet = actor.root.Position - Vector3.new(0, actor.groundOffset - R - 0.05, 0)
			local start = F.clampToArena(feet + dir * BALL.HoldDistance, R + 0.5)
			part.CFrame = CFrame.new(start)
		end
	end
	part.Anchored = false

	local speed = math.min(velocity.Magnitude, BALL.MaxSpeed)
	local direction = Util.unit(velocity, actor.root.CFrame.LookVector)
	part.AssemblyLinearVelocity = direction * speed
	part.AssemblyAngularVelocity = UP:Cross(Util.flatUnit(direction)) * (speed / R) * 0.35

	actor.noPickupUntil = t + (options.noPickup or BALL.KickNoPickup)
	Ball.touch(actor, "kick")
	Ball.shot = {
		kicker = actor,
		team = actor.team,
		kind = options.kind or "Shot",
		time = t,
		untrappableUntil = t + (options.untrappable or 0),
		speed = speed,
		passTarget = options.passTarget,
	}
	table.clear(forces)
	gravityScale = options.gravityScale or BALL.GravityScale
	gravityKickTime = t
	gravityRestoreAt = t + (options.gravityTime or 1.2)
	claimOwnership()
	refreshLift()
	if options.color then
		Ball.setFx(options.color, options.colorTime or 1.5)
	end
	prevPos = part.Position
end

-- Выбить мяч у владельца (подкат).
function Ball.knockLoose(velocity: Vector3, byActor)
	local part = Ball.part :: Part
	if Ball.holder then
		releaseHolder()
	end
	Ball.shot = nil
	table.clear(forces)
	part.AssemblyLinearVelocity = velocity
	if byActor then
		Ball.touch(byActor, "tackle")
	end
end

-- Поставить мяч в точку. frozen = true — закрепить (перед розыгрышем).
function Ball.reset(position: Vector3, frozen: boolean)
	local part = Ball.part :: Part
	if Ball.holder then
		releaseHolder()
	end
	Ball.shot = nil
	Ball.lastTouch = nil
	Ball.prevTouch = nil
	Ball.lockedUntil = 0
	table.clear(forces)
	gravityScale = BALL.GravityScale
	part.Anchored = frozen
	part.AssemblyLinearVelocity = Vector3.zero
	part.AssemblyAngularVelocity = Vector3.zero
	part.CFrame = CFrame.new(position)
	part:SetAttribute("FxUntil", 0)
	prevPos = position
	if not frozen then
		claimOwnership()
	end
	refreshLift()
end

function Ball.setFrozen(frozen: boolean)
	local part = Ball.part :: Part
	part.Anchored = frozen
	if not frozen then
		claimOwnership()
	end
	refreshLift()
end

---------------------------------------------------------------------------
-- Контакт мяча с игроками
---------------------------------------------------------------------------

-- Отбить мяч, который нельзя принять.
local function block(actor, pos: Vector3, vel: Vector3, speed: number, t: number)
	local toActor = Util.flat(actor.root.Position - pos)
	if vel:Dot(toActor) <= 0 then
		return -- мяч уже улетает от игрока
	end
	local part = Ball.part :: Part
	local normal = Util.flatUnit(pos - actor.root.Position, -Util.flatUnit(vel))
	local reflected = vel - normal * (2 * vel:Dot(normal))
	local out = reflected * BALL.BlockDamping + Vector3.new(0, 10 + speed * 0.05, 0)
	part.AssemblyLinearVelocity = out

	local shot = Ball.shot
	if shot then
		shot.untrappableUntil = 0
	end
	table.clear(forces)
	gravityScale = BALL.GravityScale
	refreshLift()
	part:SetAttribute("FxUntil", 0)
	actor.noPickupUntil = t + 0.35
	Ball.touch(actor, "block")
	Net.fx("Block", { character = actor.character, position = pos, speed = speed })
	Ball.Blocked:Fire(actor, shot)
end

local function resolveContact(actor, pos: Vector3, vel: Vector3, speed: number, t: number)
	if Actors.hasFlag(actor, "autoTrapUntil", t) then
		Ball.attach(actor)
		return
	end
	local shot = Ball.shot
	local sameTeam = shot ~= nil and shot.team == actor.team
	if shot and t < shot.untrappableUntil then
		if not sameTeam then
			block(actor, pos, vel, speed, t)
		end
		return
	end
	local limit = (actor.trapMaxSpeed or BALL.TrapMaxSpeed) * (actor.style.stats.trap or 1)
	if sameTeam then
		limit *= BALL.TeammateTrapBonus
	end
	if speed > limit then
		block(actor, pos, vel, speed, t)
		return
	end
	Ball.attach(actor)
end

local function checkContacts(pos: Vector3, vel: Vector3, t: number)
	local best, bestDist
	for _, actor in pairs(Actors.byCharacter) do
		if actor.alive and not actor.frozen and t >= actor.noPickupUntil and t >= actor.stunnedUntil then
			local rootPos = actor.root.Position
			local closest = Util.closestOnSegment(prevPos, pos, rootPos)
			local dist = Util.flat(closest - rootPos).Magnitude
			local height = closest.Y - (rootPos.Y - actor.groundOffset)
			local radius = actor.trapRadius or BALL.PickupRadius
			if actor.flags.reach and Actors.hasFlag(actor, "reachUntil", t) then
				radius = math.max(radius, actor.flags.reach)
			end
			if dist <= radius and height >= -1.5 and height <= BALL.PickupHeight then
				if not bestDist or dist < bestDist then
					best, bestDist = actor, dist
				end
			end
		end
	end
	if best then
		resolveContact(best, pos, vel, vel.Magnitude, t)
	end
end

local function checkGoal(pos: Vector3)
	local side = F.goalSideAt(pos, R)
	if not side then
		return
	end
	local holder = Ball.holder
	if holder and holder.isKeeper and holder.side == side then
		return -- вратарь с мячом зашёл в свои ворота: не гол
	end
	Ball.active = false

	local scoringTeam = side == Config.Teams.Home.Side and "Away" or "Home"
	local scorer, assist
	local last, prev = Ball.lastTouch, Ball.prevTouch
	if last then
		if last.team == scoringTeam then
			scorer = last.actor
			if prev and prev.team == scoringTeam and prev.actor ~= last.actor and last.time - prev.time < 12 then
				assist = prev.actor
			end
		elseif prev and prev.team == scoringTeam and last.time - prev.time < 4 then
			scorer = prev.actor -- рикошет от защитника: гол записываем бившему
		end
	end
	Ball.Goal:Fire(scoringTeam, scorer, assist, side)
end

-- Каждый кадр сервера.
function Ball.step(dt: number)
	local part = Ball.part
	if not part or not part.Parent then
		return
	end
	local t = Actors.now()

	local holder = Ball.holder
	if holder then
		local valid = holder.alive
			and holder.character.Parent ~= nil
			and joint ~= nil
			and joint.Parent == part
			and joint.Part0 == holder.root
		if not valid then
			releaseHolder()
		elseif Ball.active then
			checkGoal(part.Position)
		end
		prevPos = part.Position
		return
	end

	if needOwner then
		claimOwnership()
	end
	if part.Anchored then
		prevPos = part.Position
		return
	end

	local pos = part.Position
	local rel = pos - F.Origin

	-- Страховка: мяч как-то вылетел из арены.
	if
		rel.Y < -12
		or rel.Y > F.WallHeight + 30
		or math.abs(rel.X) > F.HalfLength + F.EndMargin + 12
		or math.abs(rel.Z) > F.HalfWidth + F.SideMargin + 12
	then
		local safe = F.clampToArena(pos, 8)
		Ball.reset(Vector3.new(safe.X, F.Origin.Y + 5, safe.Z), false)
		return
	end

	for i = #forces, 1, -1 do
		local force = forces[i]
		if t >= force.expires then
			table.remove(forces, i)
		else
			force.fn(dt, part, t)
		end
	end

	-- Сопротивление: по земле мяч тормозит сильнее, чем в воздухе.
	local vel = part.AssemblyLinearVelocity
	local grounded = rel.Y <= R + 0.35

	-- Особая гравитация спец-удара заканчивается по времени или при первом касании газона.
	if gravityScale ~= BALL.GravityScale then
		if t >= gravityRestoreAt or (grounded and t - gravityKickTime > 0.15) then
			Ball.setGravityScale(BALL.GravityScale)
		end
	end
	local factor = math.max(0, 1 - (grounded and BALL.GroundDrag or BALL.AirDrag) * dt)
	local horizontal = Vector3.new(vel.X * factor, 0, vel.Z * factor)
	if grounded and horizontal.Magnitude < 0.6 then
		horizontal = Vector3.zero
	end
	vel = Vector3.new(horizontal.X, vel.Y, horizontal.Z)
	if vel.Magnitude > BALL.MaxSpeed then
		vel = vel.Unit * BALL.MaxSpeed
	end
	part.AssemblyLinearVelocity = vel
	if grounded then
		part.AssemblyAngularVelocity *= math.max(0, 1 - 0.9 * dt)
	end

	if Ball.active then
		if t >= Ball.lockedUntil then
			checkContacts(pos, vel, t)
		end
		if Ball.active and not Ball.holder then
			checkGoal(pos)
		end
	end
	prevPos = pos
end

function Ball.init()
	Ball.part = createBall()
	prevPos = Ball.part.Position
	Ball.reset(F.Origin + Vector3.new(0, R + 0.05, 0), true)
end

return Ball
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">BotService</string>
          <string name="Source"><![CDATA[-- Боты-вратари. По одному на команду: держат позицию, прыгают за ударами, выбивают мяч партнёрам.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local F = require(Shared.FieldSpec)
local Mover = require(Shared.Mover)
local Util = require(Shared.Util)
local Actions = require(script.Parent.ActionService)
local Actors = require(script.Parent.Actors)
local Ball = require(script.Parent.BallService)
local Match = require(script.Parent.MatchService)
local Net = require(script.Parent.Net)
local Physics = require(script.Parent.Physics)
local PlayerService = require(script.Parent.PlayerService)

local BOTS = Config.Bots

local Bots = {}

local keepers = {} -- [teamKey] = { actor, tracks, running, releaseAt, diveReadyAt, reactAt, lastShot }
local spawning = {} -- [teamKey] = true, пока бот создаётся
local thinkTimer = 0

-- Стандартные анимации Roblox (доступны в любой игре) для каждого типа аватара.
local ANIMATION_IDS = {
	R6 = { idle = "rbxassetid://180435571", run = "rbxassetid://180426354" },
	R15 = { idle = "rbxassetid://507766666", run = "rbxassetid://507767714" },
}
local RIG_NAME = Config.Avatar.RigType == "R15" and "R15" or "R6"
local RIG_TYPE = RIG_NAME == "R15" and Enum.HumanoidRigType.R15 or Enum.HumanoidRigType.R6

local function createRig(teamKey: string): Model?
	local team = Config.Teams[teamKey]
	local kit = team.Color:Lerp(Color3.fromRGB(255, 236, 90), 0.6)
	local dark = Color3.fromRGB(30, 32, 42)

	local description = Instance.new("HumanoidDescription")
	description.HeadColor = Color3.fromRGB(234, 196, 160)
	description.TorsoColor = kit
	description.LeftArmColor = kit
	description.RightArmColor = kit
	description.LeftLegColor = dark
	description.RightLegColor = dark

	local ok, result = pcall(function()
		return Players:CreateHumanoidModelFromDescription(description, RIG_TYPE)
	end)
	if not ok or typeof(result) ~= "Instance" then
		warn("[Bots] could not create a goalkeeper: " .. tostring(result))
		return nil
	end
	return result :: Model
end

local function spawnKeeper(teamKey: string)
	if spawning[teamKey] then
		return
	end
	spawning[teamKey] = true

	local model = createRig(teamKey)
	local humanoid = model and model:FindFirstChildOfClass("Humanoid") :: Humanoid?
	local root = model and model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not model or not humanoid or not root then
		if model then
			model:Destroy()
		end
		spawning[teamKey] = nil
		return
	end

	local team = Config.Teams[teamKey]
	model.Name = team.Name .. " Goalkeeper"
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.AutoRotate = false
	local animate = model:FindFirstChild("Animate")
	if animate then
		animate:Destroy()
	end

	if Config.Player.Scale ~= 1 then
		model:ScaleTo(Config.Player.Scale)
	end
	local spot = F.fromOwnGoal(team.Side, 5, 0) + Vector3.new(0, 4, 0)
	model:PivotTo(CFrame.lookAt(spot, spot + F.attackDir(team.Side)))
	model.Parent = Workspace
	Physics.tagCharacter(model)
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	task.wait(0.2)

	local actor = Actors.register(model, { team = teamKey, isBot = true, isKeeper = true, styleId = "Keeper" })
	if not actor then
		model:Destroy()
		spawning[teamKey] = nil
		return
	end
	actor.baseSpeed = BOTS.KeeperSpeed
	actor.trapRadius = BOTS.KeeperReach
	actor.trapMaxSpeed = BOTS.KeeperCatchSpeed
	PlayerService.addKit(actor, "GOALKEEPER")

	local animator = humanoid:FindFirstChildOfClass("Animator") :: Animator?
	if not animator then
		local created = Instance.new("Animator")
		created.Parent = humanoid
		animator = created
	end
	local tracks = {}
	for name, id in pairs(ANIMATION_IDS[RIG_NAME]) do
		local animation = Instance.new("Animation")
		animation.AnimationId = id
		local ok, track = pcall(function()
			return (animator :: Animator):LoadAnimation(animation)
		end)
		if ok and track then
			track.Looped = true
			tracks[name] = track
		end
	end
	if tracks.idle then
		tracks.idle:Play()
	end

	keepers[teamKey] = {
		actor = actor,
		tracks = tracks,
		running = false,
		releaseAt = 0,
		diveReadyAt = 0,
		reactAt = 0,
		lastShot = nil,
	}
	Match.placeLate(actor)
	spawning[teamKey] = nil
end

local function dive(keeper, lateral: number, heightAtLine: number, t: number)
	local actor = keeper.actor
	keeper.diveReadyAt = t + BOTS.KeeperDiveCooldown
	local dir = Vector3.new(0, 0, lateral > 0 and 1 or -1)
	actor.flags.reach = BOTS.KeeperDiveReach
	Actors.setFlag(actor, "reachUntil", 0.6)
	Mover.dash(actor.root, dir, BOTS.KeeperDiveSpeed, 0.3)
	if heightAtLine > 5.5 then
		actor.humanoid.Jump = true
	end
	Net.fx("KeeperDive", { character = actor.character, right = dir:Dot(actor.root.CFrame.RightVector) > 0 })
end

-- Вратарь с мячом выбивает его: партнёру, если тот открыт, иначе просто вперёд.
local function distribute(keeper)
	local actor = keeper.actor
	if not Match.isLive() then
		return
	end
	local forward = F.attackDir(actor.side)
	local target = Actions.findPassTarget(actor, forward, 85, 170)
	local elevation = 34
	local velocity
	if target then
		local to = Util.flat(target.root.Position - actor.root.Position)
		local needed = math.sqrt(to.Magnitude * Ball.gravity() / math.sin(math.rad(elevation * 2)))
		velocity = Util.withElevation(to, elevation) * math.clamp(needed, 50, 125)
	else
		local dir = Util.rotateY(forward, (math.random() * 2 - 1) * 28)
		velocity = Util.withElevation(dir, elevation) * 108
	end
	Ball.kick(actor, velocity, { kind = "Pass", noPickup = 0.8, passTarget = target })
	Net.fx("Kick", { character = actor.character, kind = "Lob", power = 0.6, position = Ball.position() })
end

local function think(keeper, t: number)
	local actor = keeper.actor
	local humanoid, root = actor.humanoid, actor.root
	local goal = F.goalCenter(actor.side)
	local inward = -actor.side -- направление от ворот в поле по оси X
	local half = F.GoalWidth / 2
	local rootPos = root.Position
	local ballPos, ballVel = Ball.position(), Ball.velocity()

	if actor.frozen or Actors.isStunned(actor, t) then
		return
	end

	-- Всегда лицом к мячу.
	local face = Util.flatUnit(ballPos - rootPos, Vector3.new(inward, 0, 0))
	root.CFrame = CFrame.lookAt(rootPos, rootPos + face)

	if actor.hasBall then
		if t >= keeper.releaseAt then
			distribute(keeper)
		else
			humanoid:MoveTo(Vector3.new(goal.X + inward * 9, rootPos.Y, goal.Z))
		end
		return
	end
	if not Match.isLive() then
		return
	end

	local shot = Ball.shot
	if shot and shot ~= keeper.lastShot then
		keeper.lastShot = shot
		keeper.reactAt = t + BOTS.KeeperReaction
	end

	local holder = Ball.holder
	local ahead = (ballPos.X - goal.X) * inward -- насколько мяч впереди линии ворот
	local approach = -ballVel.X * inward -- скорость мяча к линии ворот
	local target: Vector3? = nil

	-- Удар в створ: идём в точку, где мяч пересечёт линию, и при необходимости прыгаем.
	if not holder and approach > 12 and ahead > 0 and t >= keeper.reactAt then
		local eta = ahead / approach
		if eta < 1.6 then
			local zAtLine = ballPos.Z + ballVel.Z * eta
			local yAtLine = ballPos.Y + ballVel.Y * eta - 0.5 * Ball.gravity() * eta * eta
			if math.abs(zAtLine - goal.Z) < half + 5 and yAtLine < F.GoalHeight + 5 then
				local z = math.clamp(zAtLine, goal.Z - half + 1.5, goal.Z + half - 1.5)
				target = Vector3.new(goal.X + inward * 2.5, rootPos.Y, z)
				local lateral = zAtLine - rootPos.Z
				if eta < 0.6 and math.abs(lateral) > 3.2 and math.abs(lateral) < 17 and t >= keeper.diveReadyAt then
					dive(keeper, lateral, yAtLine, t)
				end
			end
		end
	end

	if not target then
		local loose = not holder
			and ahead < 30
			and ahead > -8
			and math.abs(ballPos.Z - goal.Z) < F.PenaltyWidth * 0.35
			and ballVel.Magnitude < 45
		if loose then
			-- Ничейный мяч рядом с воротами: забираем.
			target = Vector3.new(ballPos.X, rootPos.Y, ballPos.Z)
		else
			-- Обычная позиция: на линии «мяч — центр ворот», чуть выходя вперёд, когда мяч близко.
			local out = 4 + math.clamp(1 - ahead / 120, 0, 1) * 5
			local toBall = Util.flatUnit(ballPos - goal, Vector3.new(inward, 0, 0))
			local point = goal + toBall * out
			local x = goal.X + inward * math.max(2.5, (point.X - goal.X) * inward)
			target = Vector3.new(x, rootPos.Y, math.clamp(point.Z, goal.Z - half + 2, goal.Z + half - 2))
		end
	end
	humanoid:MoveTo(target :: Vector3)
end

local function updateAnimation(keeper)
	local tracks = keeper.tracks
	if not tracks.run then
		return
	end
	local moving = Util.flat(keeper.actor.root.AssemblyLinearVelocity).Magnitude > 2
	if moving ~= keeper.running then
		keeper.running = moving
		if moving then
			tracks.run:Play(0.15)
		else
			tracks.run:Stop(0.15)
		end
	end
end

function Bots.step(dt: number)
	thinkTimer += dt
	if thinkTimer < 0.05 then
		return
	end
	thinkTimer = 0
	local t = Actors.now()
	for teamKey, keeper in pairs(keepers) do
		local actor = keeper.actor
		if not actor.alive or not actor.character.Parent then
			-- Вратарь пропал (например, упал за карту) — создаём нового.
			keepers[teamKey] = nil
			Actors.unregister(actor.character)
			if actor.character.Parent then
				actor.character:Destroy()
			end
			task.delay(2, spawnKeeper, teamKey)
		else
			think(keeper, t)
			updateAnimation(keeper)
		end
	end
end

function Bots.init()
	if not BOTS.Goalkeepers then
		return
	end

	Ball.Possessed:Connect(function(actor, _previous, shot)
		for _, keeper in pairs(keepers) do
			if keeper.actor == actor then
				keeper.releaseAt = Actors.now() + BOTS.KeeperHoldTime
				if shot and shot.team ~= actor.team and shot.kind == "Shot" then
					Net.fx("Save", { character = actor.character, position = Ball.position() })
				end
			end
		end
	end)

	for teamKey in pairs(Config.Teams) do
		task.spawn(spawnKeeper, teamKey)
	end
end

return Bots
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">FieldBuilder</string>
          <string name="Source"><![CDATA[-- Строит весь стадион из деталей при запуске сервера: газон, разметку, ворота, борта, трибуны, крышу, небо и свет.
-- Размеры берутся из Shared/FieldSpec, цвета команд — из Shared/Config.
-- Вид — дневной: яркий газон в полоску, светлая чаша стадиона с двумя ярусами и крышей, облачное небо.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Teams = game:GetService("Teams")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local F = require(Shared.FieldSpec)

local FieldBuilder = {}

-- Надписи табло, которые обновляет MatchService.
FieldBuilder.scoreLabels = {}
FieldBuilder.timeLabels = {}

local O = F.Origin
local HL, HW = F.HalfLength, F.HalfWidth
local ARENA_X = HL + F.EndMargin
local ARENA_Z = HW + F.SideMargin

local WHITE = Color3.fromRGB(244, 246, 250)
local STEEL = Color3.fromRGB(74, 80, 94)
local WALKWAY = Color3.fromRGB(152, 158, 170)

local HOME = Config.Teams.Home
local AWAY = Config.Teams.Away

local function newPart(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = material or Enum.Material.SmoothPlastic
	part.Color = color
	part.Size = size
	part.CFrame = cframe
	part.Parent = parent
	return part
end

local function decor(part: Part): Part
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	return part
end

local function invisible(part: Part): Part
	part.Transparency = 1
	part.CastShadow = false
	part.CanQuery = false
	return part
end

local function at(x: number, y: number, z: number): CFrame
	return CFrame.new(O + Vector3.new(x, y, z))
end

local function folder(parent: Instance, name: string): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

-- Плоская линия разметки между двумя точками поля.
local LINE_Y = 0.04
local function line(parent: Instance, x1: number, z1: number, x2: number, z2: number, width: number?)
	local dx, dz = x2 - x1, z2 - z1
	local length = math.sqrt(dx * dx + dz * dz)
	if length < 0.01 then
		return
	end
	local yaw = math.atan2(-dz, dx)
	local cf = at((x1 + x2) / 2, LINE_Y, (z1 + z2) / 2) * CFrame.Angles(0, yaw, 0)
	local p = newPart(parent, "Line", Vector3.new(length + 0.05, 0.08, width or F.LineWidth), cf, WHITE)
	decor(p)
end

-- Дуга окружности из коротких отрезков. Углы в градусах, 0 = +X, 90 = +Z.
local function arc(parent: Instance, cx: number, cz: number, radius: number, fromDeg: number, toDeg: number, segments: number)
	local prevX, prevZ
	for i = 0, segments do
		local a = math.rad(fromDeg + (toDeg - fromDeg) * i / segments)
		local x, z = cx + math.cos(a) * radius, cz + math.sin(a) * radius
		if prevX then
			line(parent, prevX, prevZ, x, z)
		end
		prevX, prevZ = x, z
	end
end

local function spot(parent: Instance, x: number, z: number, radius: number)
	local cf = at(x, LINE_Y, z) * CFrame.Angles(0, 0, math.rad(90))
	local p = newPart(parent, "Spot", Vector3.new(0.08, radius * 2, radius * 2), cf, WHITE)
	p.Shape = Enum.PartType.Cylinder
	decor(p)
end

local function buildPitch(root: Instance)
	local pitch = folder(root, "Pitch")

	-- Площадь вокруг стадиона.
	local ground = newPart(
		pitch,
		"Ground",
		Vector3.new(F.Length + 900, 6, F.Width + 900),
		at(0, -3.06, 0),
		Color3.fromRGB(176, 180, 188),
		Enum.Material.Concrete
	)
	ground.CastShadow = false

	-- Газон: покос «в клетку» — широкие полосы поперёк поля и более мягкая смена тона вдоль него.
	local stripes, bands = 20, 8
	local stripeWidth = F.Length / stripes
	local bandWidth = F.Width / bands
	local light, dark = Color3.fromRGB(70, 132, 58), Color3.fromRGB(58, 114, 48)
	for i = 0, stripes - 1 do
		for j = 0, bands - 1 do
			local x = -HL + stripeWidth * (i + 0.5)
			local z = -HW + bandWidth * (j + 0.5)
			local base = i % 2 == 0 and light or dark
			local color = j % 2 == 0 and base or base:Lerp(Color3.new(0, 0, 0), 0.05)
			local tile = newPart(pitch, "Grass", Vector3.new(stripeWidth, 1, bandWidth), at(x, -0.5, z), color, Enum.Material.Grass)
			tile.CastShadow = false
		end
	end

	-- Газон за линиями до бортов.
	local apronColor = Color3.fromRGB(52, 98, 44)
	for _, s in ipairs({ -1, 1 }) do
		local endApron = newPart(
			pitch,
			"Apron",
			Vector3.new(F.EndMargin, 1, ARENA_Z * 2),
			at(s * (HL + F.EndMargin / 2), -0.5, 0),
			apronColor,
			Enum.Material.Grass
		)
		endApron.CastShadow = false
		local sideApron = newPart(
			pitch,
			"Apron",
			Vector3.new(F.Length, 1, F.SideMargin),
			at(0, -0.5, s * (HW + F.SideMargin / 2)),
			apronColor,
			Enum.Material.Grass
		)
		sideApron.CastShadow = false
	end
end

local function buildLines(root: Instance)
	local lines = folder(root, "Lines")

	line(lines, -HL, -HW, HL, -HW)
	line(lines, -HL, HW, HL, HW)
	line(lines, -HL, -HW, -HL, HW)
	line(lines, HL, -HW, HL, HW)
	line(lines, 0, -HW, 0, HW)

	arc(lines, 0, 0, F.CenterRadius, 0, 360, 72)
	spot(lines, 0, 0, 1.4)

	for _, s in ipairs({ -1, 1 }) do
		local goalX = s * HL
		local boxX = s * (HL - F.PenaltyDepth)
		local halfBox = F.PenaltyWidth / 2
		line(lines, goalX, -halfBox, boxX, -halfBox)
		line(lines, goalX, halfBox, boxX, halfBox)
		line(lines, boxX, -halfBox, boxX, halfBox)

		local areaX = s * (HL - F.GoalAreaDepth)
		local halfArea = F.GoalAreaWidth / 2
		line(lines, goalX, -halfArea, areaX, -halfArea)
		line(lines, goalX, halfArea, areaX, halfArea)
		line(lines, areaX, -halfArea, areaX, halfArea)

		local spotX = s * (HL - F.PenaltySpot)
		spot(lines, spotX, 0, 1.1)

		-- Дуга у штрафной: только та часть, что снаружи площади.
		local half = math.deg(math.acos((F.PenaltyDepth - F.PenaltySpot) / F.PenaltyArc))
		local centerAngle = s == 1 and 180 or 0
		arc(lines, spotX, 0, F.PenaltyArc, centerAngle - half, centerAngle + half, 20)

		-- Угловые дуги.
		for _, zs in ipairs({ -1, 1 }) do
			local from
			if s == 1 then
				from = zs == 1 and 180 or 90
			else
				from = zs == 1 and 270 or 0
			end
			arc(lines, goalX, zs * HW, 5, from, from + 90, 6)
		end
	end
end

local function cylinder(parent: Instance, name: string, length: number, radius: number, cframe: CFrame, color: Color3): Part
	local p = newPart(parent, name, Vector3.new(length, radius * 2, radius * 2), cframe, color, Enum.Material.Metal)
	p.Shape = Enum.PartType.Cylinder
	return p
end

local function buildGoal(root: Instance, side: number)
	local goal = folder(root, side == HOME.Side and "GoalHome" or "GoalAway")
	local gx = side * HL
	local backX = side * (HL + F.GoalDepth)
	local midX = side * (HL + F.GoalDepth / 2)
	local halfW = F.GoalWidth / 2
	local h = F.GoalHeight
	local r = F.PostRadius
	local vertical = CFrame.Angles(0, 0, math.rad(90))
	local alongZ = CFrame.Angles(0, math.rad(90), 0)

	-- Каркас.
	for _, zs in ipairs({ -1, 1 }) do
		cylinder(goal, "Post", h, r, at(gx, h / 2, zs * halfW) * vertical, WHITE)
		decor(cylinder(goal, "BackPost", h, r * 0.5, at(backX, h / 2, zs * halfW) * vertical, WHITE))
		decor(cylinder(goal, "TopRail", F.GoalDepth, r * 0.5, at(midX, h, zs * halfW), WHITE))
	end
	cylinder(goal, "Crossbar", F.GoalWidth + r * 2, r, at(gx, h, 0) * alongZ, WHITE)
	decor(cylinder(goal, "BackBar", F.GoalWidth, r * 0.5, at(backX, h, 0) * alongZ, WHITE))

	-- Сетка: тонкие нити без столкновений.
	local netColor = Color3.fromRGB(246, 247, 250)
	local function strand(size: Vector3, cf: CFrame)
		local p = newPart(goal, "Net", size, cf, netColor)
		p.Transparency = 0.1
		decor(p)
	end
	local t = 0.16
	local step = 1.6
	for z = -halfW + step, halfW - step, step do
		strand(Vector3.new(t, h, t), at(backX, h / 2, z))
		strand(Vector3.new(F.GoalDepth, t, t), at(midX, h, z))
	end
	for y = step, h - 1, step do
		strand(Vector3.new(t, t, F.GoalWidth), at(backX, y, 0))
		for _, zs in ipairs({ -1, 1 }) do
			strand(Vector3.new(F.GoalDepth, t, t), at(midX, y, zs * halfW))
		end
	end
	for d = step, F.GoalDepth - 1, step do
		local x = side * (HL + d)
		strand(Vector3.new(t, t, F.GoalWidth), at(x, h, 0))
		for _, zs in ipairs({ -1, 1 }) do
			strand(Vector3.new(t, h, t), at(x, h / 2, zs * halfW))
		end
	end

	-- Невидимые стенки сетки: останавливают мяч.
	local thick = 3
	invisible(
		newPart(
			goal,
			"NetBack",
			Vector3.new(thick, h + thick, F.GoalWidth + thick * 2),
			at(backX + side * thick / 2, (h + thick) / 2, 0),
			WHITE
		)
	)
	invisible(newPart(goal, "NetTop", Vector3.new(F.GoalDepth, thick, F.GoalWidth + thick * 2), at(midX, h + thick / 2 + r, 0), WHITE))
	for _, zs in ipairs({ -1, 1 }) do
		invisible(
			newPart(
				goal,
				"NetSide",
				Vector3.new(F.GoalDepth - r * 2, h, thick),
				at(midX + side * r, h / 2, zs * (halfW + thick / 2)),
				WHITE
			)
		)
	end
end

-- Борта вокруг поля (мяч от них отскакивает) и невидимые стены до потолка арены.
local function buildWalls(root: Instance)
	local walls = folder(root, "Walls")
	local boardH = 4.5
	local boardT = 2
	local wallT = 6
	local wallH = F.WallHeight

	-- Борт: тёмный корпус и LED-экран со своей графикой — градиент цвета команды, шевроны и её название.
	local boardIndex = 0
	local function board(length: number, cf: CFrame, color: Color3)
		newPart(walls, "Board", Vector3.new(length, boardH, boardT), cf, Color3.fromRGB(26, 30, 42), Enum.Material.Metal)
		local faceCf = cf * CFrame.new(0, -0.2, -boardT / 2 - 0.08)
		local face = newPart(walls, "BoardFace", Vector3.new(length - 0.6, boardH - 1.4, 0.2), faceCf, Color3.fromRGB(12, 14, 22))
		decor(face)
		boardIndex += 1
		local team = color == HOME.Color and HOME or AWAY
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
		gui.CanvasSize = Vector2.new(math.floor(length * 40), 124)
		gui.LightInfluence = 0.15
		gui.Brightness = 1.4
		gui.Parent = face
		local back = Instance.new("Frame")
		back.Size = UDim2.fromScale(1, 1)
		back.BorderSizePixel = 0
		back.BackgroundColor3 = Color3.new(1, 1, 1)
		back.Parent = gui
		local gradient = Instance.new("UIGradient")
		gradient.Color = ColorSequence.new(color:Lerp(Color3.new(0, 0, 0), 0.55), color)
		gradient.Rotation = boardIndex % 2 == 0 and 0 or 180
		gradient.Parent = back
		-- Шевроны вдоль экрана.
		for k = 0, 5 do
			local chevron = Instance.new("Frame")
			chevron.AnchorPoint = Vector2.new(0.5, 0.5)
			chevron.Position = UDim2.fromScale(0.06 + k * 0.035, 0.5)
			chevron.Size = UDim2.fromScale(0.012, 1.4)
			chevron.Rotation = 25
			chevron.BorderSizePixel = 0
			chevron.BackgroundColor3 = Color3.new(1, 1, 1)
			chevron.BackgroundTransparency = 0.25 + k * 0.12
			chevron.Parent = back
		end
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Position = UDim2.fromScale(0.3, 0.08)
		label.Size = UDim2.fromScale(0.62, 0.84)
		label.Font = Enum.Font.GothamBlack
		label.TextScaled = true
		label.TextColor3 = Color3.new(1, 1, 1)
		label.TextXAlignment = Enum.TextXAlignment.Right
		label.Text = team.Name
		label.Parent = back
	end

	local segment = 24
	-- Боковые борта. Лицевая сторона смотрит на поле (локальная -Z детали).
	for _, zs in ipairs({ -1, 1 }) do
		local z = zs * (ARENA_Z + boardT / 2)
		local count = math.floor((ARENA_X * 2 - 32) / segment)
		local span = (ARENA_X * 2 - 32) / count
		for i = 0, count - 1 do
			local x = -ARENA_X + 16 + span * (i + 0.5)
			local cf = CFrame.lookAt(O + Vector3.new(x, boardH / 2, z), O + Vector3.new(x, boardH / 2, 0))
			board(span - 0.4, cf, x < 0 and HOME.Color or AWAY.Color)
		end
		invisible(
			newPart(walls, "Wall", Vector3.new(ARENA_X * 2 + wallT * 2, wallH, wallT), at(0, wallH / 2, zs * (ARENA_Z + wallT / 2)), WHITE)
		)
	end

	-- Торцевые борта.
	for _, team in ipairs({ HOME, AWAY }) do
		local s = team.Side
		local x = s * (ARENA_X + boardT / 2)
		local count = math.floor((ARENA_Z * 2 - 32) / segment)
		local span = (ARENA_Z * 2 - 32) / count
		for i = 0, count - 1 do
			local z = -ARENA_Z + 16 + span * (i + 0.5)
			local cf = CFrame.lookAt(O + Vector3.new(x, boardH / 2, z), O + Vector3.new(0, boardH / 2, z))
			board(span - 0.4, cf, team.Color)
		end
		invisible(
			newPart(walls, "Wall", Vector3.new(wallT, wallH, ARENA_Z * 2 + wallT * 2), at(s * (ARENA_X + wallT / 2), wallH / 2, 0), WHITE)
		)
	end

	-- Скошенные углы, чтобы мяч не застревал.
	local cut = 16
	for _, xs in ipairs({ -1, 1 }) do
		for _, zs in ipairs({ -1, 1 }) do
			local length = cut * math.sqrt(2) + 2
			local cf = at(xs * (ARENA_X - cut / 2), 0, zs * (ARENA_Z - cut / 2)) * CFrame.Angles(0, math.rad(xs * zs * 45), 0)
			newPart(walls, "CornerBoard", Vector3.new(length, boardH, boardT), cf * CFrame.new(0, boardH / 2, 0), WHITE)
			invisible(newPart(walls, "CornerWall", Vector3.new(length, wallH, 4), cf * CFrame.new(0, wallH / 2, 0), WHITE))
		end
	end

	invisible(newPart(walls, "Ceiling", Vector3.new(ARENA_X * 2 + 20, 6, ARENA_Z * 2 + 20), at(0, wallH + 3, 0), WHITE))
end

---------------------------------------------------------------------------
-- Трибуны: высокая закрытая чаша — два крутых яруса, плотная мозаика зрителей,
-- синие светящиеся линии по ярусам и крыша-кольцо с открытым небом над полем.
---------------------------------------------------------------------------

local STAND_GAP = 7 -- проход между бортом и первым рядом
local LOWER_ROWS, LOWER_RISE = 12, 2.8
local UPPER_ROWS, UPPER_RISE = 14, 3.8
local ROW_DEPTH = 4.5
local LOWER_BASE = 4.5
local LOWER_TOP = LOWER_BASE + LOWER_ROWS * LOWER_RISE
local UPPER_BASE = LOWER_TOP + 8
local UPPER_TOP = UPPER_BASE + UPPER_ROWS * UPPER_RISE
local FASCIA_DEPTH = 4
local UPPER_FRONT = LOWER_ROWS * ROW_DEPTH + FASCIA_DEPTH
local BACK = UPPER_FRONT + UPPER_ROWS * ROW_DEPTH
local STAND_DEPTH = BACK + 3
local ROOF_Y = UPPER_TOP + 14
local ROOF_INNER = -12 -- крыша нависает над проходом перед трибуной

local LED_BLUE = Color3.fromRGB(120, 140, 170)
local STRUCTURE_BLUE = Color3.fromRGB(34, 66, 156)
local STRUCTURE_DARK = Color3.fromRGB(24, 44, 104)
local TIER_LIGHT = Color3.fromRGB(198, 206, 224)
local TIER_SHADE = Color3.fromRGB(182, 191, 212)

-- Зрители: каждый ряд — цепочка коротких цветных отрезков. Издалека это читается как плотная толпа.
local CROWD_SEGMENT_MIN, CROWD_SEGMENT_MAX = 3, 8
local CROWD_NEUTRAL = {
	{ Color3.fromRGB(246, 247, 252), 30 },
	{ Color3.fromRGB(30, 40, 86), 12 },
	{ Color3.fromRGB(150, 160, 186), 8 },
}

local function rival(team)
	return team == HOME and AWAY or HOME
end

local function crowdColor(rng: Random, team): Color3
	-- Почти половина мест — цвет команды этой трибуны, примерно каждое восьмое — цвет соперника.
	local roll = rng:NextNumber() * 100
	if roll < 46 then
		return team.Color:Lerp(Color3.new(1, 1, 1), rng:NextNumber() * 0.25)
	elseif roll < 58 then
		return rival(team).Color:Lerp(Color3.new(1, 1, 1), rng:NextNumber() * 0.25)
	end
	roll = rng:NextNumber() * 50
	for _, entry in ipairs(CROWD_NEUTRAL) do
		roll -= entry[2]
		if roll <= 0 then
			return entry[1]
		end
	end
	return CROWD_NEUTRAL[1][1]
end

-- Одна сторона чаши. frame — система координат стороны: X вдоль трибуны, Z — от поля наружу,
-- начало — у переднего края первого ряда на уровне газона.
local function buildStandSide(parent: Instance, frame: CFrame, length: number, team, rng: Random, withTunnel: boolean)
	local stands = folder(parent, "Stand")
	local crowd = folder(stands, "Crowd")

	local function local_(x: number, y: number, z: number): CFrame
		return frame * CFrame.new(x, y, z)
	end

	local function crowdRow(top: number, z: number, gap: number?)
		local x = -length / 2 + 1
		while x < length / 2 - 1 do
			local segment = math.min(CROWD_SEGMENT_MIN + rng:NextNumber() * (CROWD_SEGMENT_MAX - CROWD_SEGMENT_MIN), length / 2 - 1 - x)
			local mid = x + segment / 2
			if not (gap and math.abs(mid) < gap) then
				local height = 2 + rng:NextNumber() * 0.5
				local size = Vector3.new(segment - 0.15, height, 1.8)
				decor(newPart(crowd, "Fans", size, local_(mid, top + height / 2, z - 0.6), crowdColor(rng, team)))
			end
			x += segment
		end
	end

	local function tier(rows: number, rise: number, base: number, front: number, gapRows: number?, gap: number?)
		for row = 0, rows - 1 do
			local top = base + row * rise
			local z = front + ROW_DEPTH * (row + 0.5)
			local shade = row % 2 == 0 and TIER_LIGHT or TIER_SHADE
			newPart(stands, "Tier", Vector3.new(length, top, ROW_DEPTH), local_(0, top / 2, z), shade, Enum.Material.Concrete)
			crowdRow(top, z, (gapRows and row < gapRows) and gap or nil)
		end
	end

	-- Проход перед трибуной и низкая стенка с синей светящейся линией.
	local walkway = newPart(
		stands,
		"Walkway",
		Vector3.new(length, 0.4, STAND_GAP + 1),
		local_(0, 0.2, -STAND_GAP / 2 - 0.5),
		WALKWAY,
		Enum.Material.Concrete
	)
	decor(walkway)
	newPart(stands, "FrontWall", Vector3.new(length, LOWER_BASE, 1.2), local_(0, LOWER_BASE / 2, 0.6), STRUCTURE_DARK)
	decor(
		newPart(stands, "FrontLed", Vector3.new(length, 0.5, 0.3), local_(0, LOWER_BASE - 0.6, -0.1), LED_BLUE, Enum.Material.SmoothPlastic)
	)

	-- Туннель выхода игроков в середине нижнего яруса.
	local tunnelRows, tunnelHalf = 5, 14
	if withTunnel then
		tier(LOWER_ROWS, LOWER_RISE, LOWER_BASE, 0, tunnelRows, tunnelHalf)
		local depth = tunnelRows * ROW_DEPTH
		local height = LOWER_BASE + tunnelRows * LOWER_RISE + 1
		decor(
			newPart(
				stands,
				"Tunnel",
				Vector3.new(tunnelHalf * 2, height, depth),
				local_(0, height / 2, depth / 2 - 0.4),
				Color3.fromRGB(14, 20, 44)
			)
		)
		for _, xs in ipairs({ -1, 1 }) do
			decor(
				newPart(
					stands,
					"TunnelLed",
					Vector3.new(0.5, height, 0.5),
					local_(xs * tunnelHalf, height / 2, -0.7),
					LED_BLUE,
					Enum.Material.SmoothPlastic
				)
			)
		end
		decor(
			newPart(
				stands,
				"TunnelLed",
				Vector3.new(tunnelHalf * 2 + 0.5, 0.5, 0.5),
				local_(0, height, -0.7),
				LED_BLUE,
				Enum.Material.SmoothPlastic
			)
		)
	else
		tier(LOWER_ROWS, LOWER_RISE, LOWER_BASE, 0)
	end

	-- Пояс между ярусами: синий, со светящимися линиями.
	local fasciaZ = LOWER_ROWS * ROW_DEPTH + FASCIA_DEPTH / 2
	local fasciaFace = fasciaZ - FASCIA_DEPTH / 2 - 0.15
	newPart(stands, "Fascia", Vector3.new(length, UPPER_BASE, FASCIA_DEPTH), local_(0, UPPER_BASE / 2, fasciaZ), STRUCTURE_BLUE)
	decor(
		newPart(
			stands,
			"FasciaLed",
			Vector3.new(length, 0.9, 0.3),
			local_(0, UPPER_BASE - 1.6, fasciaFace),
			LED_BLUE,
			Enum.Material.SmoothPlastic
		)
	)
	decor(
		newPart(
			stands,
			"FasciaLed",
			Vector3.new(length, 0.5, 0.3),
			local_(0, LOWER_TOP + 1.2, fasciaFace),
			WHITE,
			Enum.Material.SmoothPlastic
		)
	)

	tier(UPPER_ROWS, UPPER_RISE, UPPER_BASE, UPPER_FRONT)

	-- Растяжки болельщиков на верхнем ярусе: полотна в цвет команды, лежат по склону трибуны.
	local slope = math.atan2(UPPER_RISE, ROW_DEPTH)
	local banners = math.max(2, math.floor(length / 70))
	for i = 1, banners do
		local x = -length / 2 + length * (i - 0.5) / banners + (rng:NextNumber() - 0.5) * 20
		local row = rng:NextInteger(3, UPPER_ROWS - 4)
		local y = UPPER_BASE + row * UPPER_RISE + 3.2
		local z = UPPER_FRONT + ROW_DEPTH * (row + 0.5)
		local cf = local_(x, y, z) * CFrame.Angles(-slope, 0, 0)
		local color = rng:NextNumber() < 0.75 and team.Color or rival(team).Color
		decor(newPart(stands, "Banner", Vector3.new(16, 0.3, 11), cf, color))
		decor(newPart(stands, "Banner", Vector3.new(16, 0.32, 2.4), cf, WHITE))
	end

	-- Задняя стена до крыши.
	newPart(stands, "BackWall", Vector3.new(length, ROOF_Y, 3), local_(0, ROOF_Y / 2, BACK + 1.5), STRUCTURE_BLUE, Enum.Material.Metal)

	-- Крыша: панели (белые и голубые, как стекло) на синих фермах, по краю — светящаяся линия.
	local roofDepth = STAND_DEPTH - ROOF_INNER + 2
	local roofZ = ROOF_INNER + roofDepth / 2
	local panels = math.max(2, math.floor(length / 14))
	for i = 0, panels - 1 do
		local x = -length / 2 + length * (i + 0.5) / panels
		local color = i % 2 == 0 and Color3.fromRGB(236, 242, 252) or Color3.fromRGB(196, 220, 252)
		local panel = newPart(stands, "RoofPanel", Vector3.new(length / panels - 0.3, 1.2, roofDepth), local_(x, ROOF_Y, roofZ), color)
		panel.CanCollide = false
	end
	for i = 0, panels do
		local x = -length / 2 + length * i / panels
		decor(
			newPart(
				stands,
				"RoofTruss",
				Vector3.new(1.2, 3.4, roofDepth),
				local_(x, ROOF_Y - 2.2, roofZ),
				STRUCTURE_BLUE,
				Enum.Material.Metal
			)
		)
	end
	decor(
		newPart(
			stands,
			"RoofEdge",
			Vector3.new(length + 2, 4.5, 1.6),
			local_(0, ROOF_Y - 1.4, ROOF_INNER),
			STRUCTURE_BLUE,
			Enum.Material.Metal
		)
	)
	decor(
		newPart(
			stands,
			"RoofLed",
			Vector3.new(length + 2, 0.7, 0.3),
			local_(0, ROOF_Y - 2.6, ROOF_INNER - 0.9),
			LED_BLUE,
			Enum.Material.SmoothPlastic
		)
	)
	local lights = newPart(
		stands,
		"RoofLights",
		Vector3.new(length * 0.94, 0.7, 1),
		local_(0, ROOF_Y - 4.2, ROOF_INNER + 2),
		Color3.fromRGB(255, 250, 236),
		Enum.Material.Neon
	)
	decor(lights)
end

local function buildStands(root: Instance)
	local stands = folder(root, "Stands")
	local rng = Random.new(20241)
	local sideFront = ARENA_Z + STAND_GAP
	local endFront = ARENA_X + STAND_GAP
	-- Боковые трибуны тянутся через углы до задних стен торцов — чаша получается сплошной, без пустых углов.
	local sideLength = (endFront + STAND_DEPTH) * 2
	local endLength = sideFront * 2

	-- Боковые трибуны: одна болеет за HOME, другая за AWAY. Туннель — на трибуне HOME.
	for _, zs in ipairs({ -1, 1 }) do
		local origin = O + Vector3.new(0, 0, zs * sideFront)
		local out = Vector3.new(0, 0, zs)
		local frame = CFrame.lookAt(origin, origin - out)
		buildStandSide(stands, frame, sideLength, zs == 1 and HOME or AWAY, rng, zs == 1)
	end
	-- Торцевые трибуны: за воротами каждой команды — её болельщики.
	for _, team in ipairs({ HOME, AWAY }) do
		local origin = O + Vector3.new(team.Side * endFront, 0, 0)
		local out = Vector3.new(team.Side, 0, 0)
		local frame = CFrame.lookAt(origin, origin - out)
		buildStandSide(stands, frame, endLength, team, rng, false)
	end
end

-- Большие экраны под крышей за каждыми воротами: HOME — счёт — AWAY и время.
local function buildScoreboard(root: Instance, side: number)
	local screens = folder(root, side == HOME.Side and "ScreenHome" or "ScreenAway")
	local x = side * (ARENA_X + STAND_GAP + UPPER_FRONT - 8)
	local y = ROOF_Y - 19
	local width, height = 78, 26
	local frame = newPart(screens, "Frame", Vector3.new(2.4, height + 3, width + 3), at(x + side * 0.6, y, 0), STEEL, Enum.Material.Metal)
	frame.CanCollide = false
	for _, zs in ipairs({ -1, 1 }) do
		local cable = newPart(
			screens,
			"Cable",
			Vector3.new(0.5, ROOF_Y - y - height / 2, 0.5),
			at(x, (ROOF_Y + y + height / 2) / 2, zs * width * 0.4),
			STEEL
		)
		decor(cable)
	end
	local screen = newPart(screens, "Screen", Vector3.new(0.4, height, width), at(x - side * 1, y, 0), Color3.fromRGB(12, 14, 22))
	decor(screen)

	local gui = Instance.new("SurfaceGui")
	gui.Face = side == 1 and Enum.NormalId.Left or Enum.NormalId.Right
	gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	gui.CanvasSize = Vector2.new(1200, 400)
	gui.LightInfluence = 0
	gui.Parent = screen

	local function label(text: string, position: UDim2, size: UDim2, color: Color3): TextLabel
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Font = Enum.Font.GothamBlack
		l.Text = text
		l.TextColor3 = color
		l.TextScaled = true
		l.Position = position
		l.Size = size
		l.Parent = gui
		return l
	end

	local function band(team, position: UDim2)
		local block = Instance.new("Frame")
		block.BackgroundColor3 = team.Color
		block.BorderSizePixel = 0
		block.Position = position
		block.Size = UDim2.fromScale(0.26, 0.42)
		block.Parent = gui
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Font = Enum.Font.GothamBlack
		l.Text = team.Name
		l.TextColor3 = Color3.new(1, 1, 1)
		l.TextScaled = true
		l.Size = UDim2.fromScale(1, 1)
		l.Parent = block
	end

	band(HOME, UDim2.fromScale(0.04, 0.12))
	band(AWAY, UDim2.fromScale(0.7, 0.12))
	local score = label("0 : 0", UDim2.fromScale(0.32, 0.08), UDim2.fromScale(0.36, 0.5), WHITE)
	local clock = label("5:00", UDim2.fromScale(0.36, 0.64), UDim2.fromScale(0.28, 0.26), Color3.fromRGB(255, 221, 120))
	table.insert(FieldBuilder.scoreLabels, score)
	table.insert(FieldBuilder.timeLabels, clock)
end

local function buildSpawns(root: Instance)
	local spawns = folder(root, "Spawns")
	for key, team in pairs(Config.Teams) do
		local spawn = Instance.new("SpawnLocation")
		spawn.Name = "Spawn" .. key
		spawn.Anchored = true
		spawn.CanCollide = false
		spawn.CanTouch = false
		spawn.Transparency = 1
		spawn.Size = Vector3.new(18, 1, 18)
		spawn.CFrame = CFrame.new(F.fromOwnGoal(team.Side, 80, 0) + Vector3.new(0, -0.5, 0))
		spawn.Neutral = false
		spawn.TeamColor = BrickColor.new(team.Color)
		spawn.AllowTeamChangeOnTouch = false
		spawn.Duration = 0
		spawn.Parent = spawns
	end
end

-- Дневной свет: высокое солнце, мягкие тени, яркие чуть голубоватые тона, облака над открытой крышей.
local function setupLighting()
	Lighting.ClockTime = 14.4
	Lighting.GeographicLatitude = 32
	Lighting.Brightness = 2.6
	Lighting.Ambient = Color3.fromRGB(128, 136, 162)
	Lighting.OutdoorAmbient = Color3.fromRGB(166, 178, 208)
	Lighting.ColorShift_Top = Color3.fromRGB(236, 243, 255)
	Lighting.ColorShift_Bottom = Color3.fromRGB(0, 0, 0)
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 0.7
	Lighting.ExposureCompensation = 0.1
	Lighting.ShadowSoftness = 0.3
	Lighting.GlobalShadows = true
	Lighting.FogEnd = 100000

	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA("PostEffect") or child:IsA("Atmosphere") or child:IsA("Sky") then
			child:Destroy()
		end
	end

	local sky = Instance.new("Sky")
	sky.SunAngularSize = 14
	sky.Parent = Lighting

	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.08
	atmosphere.Offset = 0
	atmosphere.Color = Color3.fromRGB(184, 196, 214)
	atmosphere.Decay = Color3.fromRGB(104, 118, 146)
	atmosphere.Glare = 0.2
	atmosphere.Haze = 0.3
	atmosphere.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.25
	bloom.Size = 24
	bloom.Threshold = 1.7
	bloom.Parent = Lighting

	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.05
	rays.Spread = 0.6
	rays.Parent = Lighting

	local grade = Instance.new("ColorCorrectionEffect")
	grade.Brightness = 0.03
	grade.Contrast = 0.1
	grade.Saturation = 0.06
	grade.TintColor = Color3.fromRGB(240, 242, 248)
	grade.Parent = Lighting

	-- Облака живут в Terrain.
	local terrain = Workspace:FindFirstChildOfClass("Terrain")
	if terrain then
		local old = terrain:FindFirstChildOfClass("Clouds")
		if old then
			old:Destroy()
		end
		local clouds = Instance.new("Clouds")
		clouds.Cover = 0.55
		clouds.Density = 0.6
		clouds.Color = Color3.fromRGB(255, 255, 255)
		clouds.Parent = terrain
	end
end

-- Создаёт две команды в сервисе Teams (если их ещё нет).
function FieldBuilder.ensureTeams()
	local result = {}
	for key, info in pairs(Config.Teams) do
		local team = Teams:FindFirstChild(info.Name) :: Team?
		if not team then
			local created = Instance.new("Team")
			created.Name = info.Name
			created.TeamColor = BrickColor.new(info.Color)
			created.AutoAssignable = false
			created.Parent = Teams
			team = created
		end
		result[key] = team
	end
	return result
end

-- An imported stadium (StadiumMesh) arrives from Import 3D as plain meshes. Parts whose names start
-- with neon_<colour> become Neon in that colour, and nothing in the stands collides or casts
-- needless shadows. Safe to run more than once.
function FieldBuilder.prepareStadiumMesh(): number
	local mesh = Workspace:FindFirstChild("StadiumMesh")
	if not mesh then
		return 0
	end
	local neon = 0
	for _, part in ipairs(mesh:GetDescendants()) do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
			part.CanTouch = false
			part.CanQuery = false
			local colour = string.match(string.lower(part.Name), "^neon_(%a+)")
			if colour then
				local sa = part:FindFirstChildOfClass("SurfaceAppearance")
				if sa then
					sa:Destroy() -- a texture would hide the neon glow
				end
				part.Material = Enum.Material.Neon
				part.Color = Config.Neon[colour] or Config.Neon.white
				part.CastShadow = false
				neon += 1
			end
		end
	end
	return neon
end

function FieldBuilder.build()
	local old = Workspace:FindFirstChild("Stadium")
	if old then
		old:Destroy()
	end
	table.clear(FieldBuilder.scoreLabels)
	table.clear(FieldBuilder.timeLabels)

	local root = Instance.new("Model")
	root.Name = "Stadium"

	buildPitch(root)
	buildLines(root)
	buildGoal(root, -1)
	buildGoal(root, 1)
	buildWalls(root)
	-- A stadium mesh made in Blender (tools/stadium), imported into Workspace as StadiumMesh,
	-- replaces the part-built stands and their hanging screens.
	if not Workspace:FindFirstChild("StadiumMesh") then
		buildStands(root)
		buildScoreboard(root, -1)
		buildScoreboard(root, 1)
	end
	buildSpawns(root)
	FieldBuilder.prepareStadiumMesh()
	setupLighting()

	root.Parent = Workspace
	return root
end

return FieldBuilder
]]></string>
