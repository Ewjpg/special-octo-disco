				RightHip = { 34, 0, 8 },
				RightKnee = { -64, 0, 0 },
				LeftHip = { 34, 0, -8 },
				LeftKnee = { -64, 0, 0 },
			},
		},
		{
			t = 0.32,
			ease = "backOut",
			pose = {
				Root = { 12, 0, 0 },
				Waist = { 14, 0, 0 },
				Neck = { 22, 0, 0 },
				RightShoulder = { -24, 0, 64 },
				RightElbow = { 40, 0, 0 },
				LeftShoulder = { -24, 0, -64 },
				LeftElbow = { 40, 0, 0 },
				RightHip = { 6, 0, 14 },
