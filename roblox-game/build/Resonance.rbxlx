-- Прыжок вратаря вправо (влево — зеркально).
R15.DiveRight = {
	length = 0.75,
	fadeIn = 0.06,
	fadeOut = 0.25,
	priority = 4,
	keys = {
		{
			t = 0.12,
			ease = "quadOut",
			pose = {
				Root = { 0, 0, -68, 0, -0.4, 0 },
				Waist = { 0, 0, -12 },
				Neck = { 0, 0, 20 },
				RightShoulder = { 0, 0, 150 },
				RightElbow = { 6, 0, 0 },
				LeftShoulder = { 30, 0, 110 },
				LeftElbow = { 10, 0, 0 },
				RightHip = { 0, 0, 14 },
				RightKnee = { -10, 0, 0 },
				LeftHip = { 10, 0, -16 },
				LeftKnee = { -30, 0, 0 },
			},
		},
		{
			t = 0.5,
			pose = {
				Root = { 0, 0, -74, 0, -0.9, 0 },
				Waist = { 0, 0, -12 },
				Neck = { 0, 0, 20 },
				RightShoulder = { 0, 0, 156 },
				RightElbow = { 6, 0, 0 },
				LeftShoulder = { 30, 0, 116 },
				LeftElbow = { 10, 0, 0 },
				RightHip = { 0, 0, 14 },
				RightKnee = { -10, 0, 0 },
				LeftHip = { 10, 0, -16 },
				LeftKnee = { -30, 0, 0 },
			},
		},
		{ t = 0.75, ease = "quadInOut", pose = REST },
	},
}
R15.DiveLeft = mirror(R15.DiveRight)

---------------------------------------------------------------------------
-- Подготовка: в каждом ключе должны быть все суставы анимации.
---------------------------------------------------------------------------

local ZERO = { 0, 0, 0, 0, 0, 0 }

local function compile(name: string, anim)
	anim.name = name
	local joints = {}
	local seen = {}
	for _, key in ipairs(anim.keys) do
		for joint in pairs(key.pose) do
			if not seen[joint] then
				seen[joint] = true
				table.insert(joints, joint)
			end
		end
	end
	table.sort(joints)
	anim.joints = joints
	table.sort(anim.keys, function(a, b)
		return a.t < b.t
	end)
	for _, key in ipairs(anim.keys) do
		local full = {}
		for _, joint in ipairs(joints) do
			local v = key.pose[joint] or ZERO
			full[joint] = { v[1] or 0, v[2] or 0, v[3] or 0, v[4] or 0, v[5] or 0, v[6] or 0 }
		end
		key.pose = full
	end
end

---------------------------------------------------------------------------
-- R6: шесть суставов. Корпус цельный, локтей и коленей нет.
---------------------------------------------------------------------------

-- Корпус R6 вращаем вокруг линии бёдер (на 1 студ ниже центра), а не вокруг центра —
-- иначе при наклоне ноги «уезжали» бы назад.
local R6_PIVOTS = { RootJoint = { 0, -1, 0 } }

-- Поза R15 -> поза R6.
--   корпус   = таз + поясница
--   плечо    = плечо + половина сгиба локтя
--   бедро    = бедро + часть сгиба колена, минус поворот поясницы (в R6 ноги растут из цельного корпуса)
-- Ноги R6 не гнутся, поэтому замах ограничен, а приседать можно только настолько, насколько ноги наклонены.
local LEG_LENGTH = 2

local function retargetPose(pose)
	local function get(name: string)
		return pose[name] or ZERO
	end
	local root, waist = get("Root"), get("Waist")
	local torso = { root[1] + waist[1], root[2] + waist[2], root[3] + waist[3], root[4], root[5], root[6] }
	local out = {}
	if pose.Neck then
		out.Neck = table.clone(pose.Neck)
	end

	-- Насколько можно опустить корпус, чтобы самая «вертикальная» нога не ушла под газон.
	local straightest = 1
	local hasLegs = false
	for _, side in ipairs({ "Right", "Left" }) do
		local shoulder = pose[side .. "Shoulder"]
		if shoulder then
			local elbow = get(side .. "Elbow")
			out[side .. " Shoulder"] = { shoulder[1] + elbow[1] * 0.5, shoulder[2], shoulder[3], 0, 0, 0 }
		end
		local hip = pose[side .. "Hip"]
		if hip then
			local knee = get(side .. "Knee")
			local rx = math.clamp(hip[1] + knee[1] * 0.2 - waist[1], -62, 112)
			local ry, rz = hip[2] - waist[2], hip[3] - waist[3]
			out[side .. " Hip"] = { rx, ry, rz, 0, 0, 0 }
			local vertical = math.cos(math.rad(torso[1] + rx)) * math.cos(math.rad(torso[3] + rz))
			if not hasLegs then
				straightest = vertical
				hasLegs = true
			else
				straightest = math.max(straightest, vertical)
			end
		end
	end
	if pose.Root or pose.Waist then
		local lowest = LEG_LENGTH * math.max(straightest, 0) - LEG_LENGTH
		torso[5] = math.max(torso[5], lowest)
		out.RootJoint = torso
	end
	return out
end

local function retarget(anim)
	local copy = table.clone(anim)
	copy.r6 = nil
	copy.pivots = R6_PIVOTS
	copy.keys = {}
	local source = anim.r6 and anim.r6.keys or nil
	if source then
		-- Позы R6 заданы вручную.
		for i, key in ipairs(source) do
			copy.keys[i] = { t = key.t, ease = key.ease, pose = key.pose }
		end
	else
		for i, key in ipairs(anim.keys) do
			copy.keys[i] = { t = key.t, ease = key.ease, pose = retargetPose(key.pose) }
		end
	end
	return copy
end

local R6 = {}
for name, anim in pairs(R15) do
	compile(name, anim)
end
for name, anim in pairs(R15) do
	local converted = retarget(anim)
	compile(name, converted)
	R6[name] = converted
end

local Animations = { R15 = R15, R6 = R6 }

-- Анимация по имени для нужного типа аватара ("R6" или "R15").
function Animations.get(name: string, rig: string?)
	local set = rig == "R6" and R6 or R15
	return set[name]
end

return Animations
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Все настройки баланса в одном месте.
-- Меняй числа здесь — код трогать не нужно.

local Config = {}

-- Side: -1 = ворота на стороне -X, 1 = ворота на стороне +X.
Config.Teams = {
	Home = { Name = "HOME", Color = Color3.fromRGB(52, 120, 255), Side = -1 },
	Away = { Name = "AWAY", Color = Color3.fromRGB(240, 62, 72), Side = 1 },
}

-- Тип аватара. Анимации есть для обоих, основной — R6.
-- Light-emitting parts of the stadium mesh: parts named neon_<colour>_N become Neon in that colour
-- at runtime (Import 3D does not carry emission over). Only the floodlight faces use it.
Config.Neon = {
	white = Color3.fromRGB(235, 240, 255), -- floodlight faces
}

Config.Avatar = {
	RigType = "R6", -- "R6" или "R15"
	ForceRig = true, -- если Roblox выдал аватар другого типа, сервер пересоберёт персонажа в нужный
}

Config.Match = {
	Duration = 300, -- длина матча, секунды
	KickoffCountdown = 3, -- отсчёт перед розыгрышем
	GoalPause = 5.5, -- пауза после гола
	FullTimePause = 10, -- пауза после финального свистка
}

Config.Player = {
	Scale = 1, -- size of every character (players and goalkeepers), 1 = normal Roblox size
	WalkSpeed = 22,
	SprintSpeed = 32,
	DribbleMult = 0.94, -- скорость с мячом
	MaxStamina = 100,
	SprintDrain = 13, -- расход выносливости в секунду
	StaminaRegen = 17,
	StaminaRegenDelay = 0.8,
	ExhaustedThreshold = 14, -- после нуля спринт вернётся только с этого запаса
}

Config.Ball = {
	Radius = 0.8,
	GravityScale = 0.5, -- 1 = обычная гравитация Roblox, меньше = мяч летит дальше
	GroundDrag = 0.55,
	AirDrag = 0.1,
	MaxSpeed = 330,
	PickupRadius = 3.4,
	PickupHeight = 6,
	TrapMaxSpeed = 108, -- мяч быстрее этого нельзя принять, только отбить
	TeammateTrapBonus = 1.4, -- партнёр принимает более быстрые мячи
	HoldDistance = 2.3, -- на сколько мяч впереди игрока при ведении
	KickNoPickup = 0.4,
	BlockDamping = 0.34,
}

Config.Shot = {
	MinPower = 80,
	MaxPower = 200,
	ChargeTime = 0.85,
	ChargeMoveMult = 0.55,
	BaseElevation = 15, -- градусы, добавляются к наклону камеры
	MinElevation = 1,
	MaxElevation = 50,
}

Config.Pass = {
	MinSpeed = 70,
	MaxSpeed = 175,
	AssistAngle = 32, -- конус автонаведения на партнёра
	MaxRange = 340,
	Elevation = 3,
}

Config.Lob = {
	Elevation = 40,
	DefaultSpeed = 105,
	MinSpeed = 48,
	MaxSpeed = 180,
}

Config.Tackle = {
	Cooldown = 2.6,
	Stamina = 16,
	Duration = 0.5,
	Speed = 46,
	Radius = 4.6,
	StunTime = 0.75,
	KnockSpeed = 30,
}

Config.Dash = {
	Cooldown = 3,
	Stamina = 14,
	Duration = 0.2,
	Speed = 64,
}

-- Дриблинг: короткий финт с мячом. Пока он длится, подкат по игроку не проходит.
Config.Dribble = {
	Cooldown = 2.4,
	Stamina = 10,
	Duration = 0.2,
	Speed = 54,
	ImmuneTime = 0.5,
}

Config.Resonance = {
	Max = 100,
	Passive = 0.7, -- в секунду
	Goal = 45,
	Assist = 25,
	Steal = 16,
	Dodge = 14,
	Block = 10,
	PassDone = 6,
}

Config.Bots = {
	Goalkeepers = true,
	KeeperSpeed = 23,
	KeeperReach = 4.6, -- радиус, в котором вратарь ловит мяч
	KeeperDiveReach = 6.2,
	KeeperCatchSpeed = 150, -- быстрее — только отбивает (сильный заряженный удар вратарь не ловит)
	KeeperDiveSpeed = 40,
	KeeperDiveCooldown = 1.5,
	KeeperReaction = 0.2,
	KeeperHoldTime = 1.1,
}

-- Анимации из Roblox (например, сделанные в Blender или Moon Animator и опубликованные в Roblox).
-- Впиши ID — и игра будет проигрывать её вместо встроенной анимации из кода. Пусто — встроенная.
-- Имена: ChargeHold, Shoot, PowerShot, Pass, Lob, Slide, Dribble, Dash, Ram, Stun, Cast,
--        PowerStance, Celebrate, DiveLeft, DiveRight.
Config.AnimationIds = {
	-- Shoot = "rbxassetid://1234567890",
}

-- Клавиши. Имена — из Enum.KeyCode / Enum.UserInputType.
Config.Controls = {
	Shoot = { "MouseButton1", "ButtonR2" },
	Action = { "E", "ButtonB" }, -- без мяча — подкат, с мячом — дриблинг
	Pass = { "F", "ButtonX" },
	Lob = { "R", "ButtonY" },
	Dash = { "Q", "ButtonL1" },
	Sprint = { "LeftShift", "ButtonL2" },
	Ability1 = { "Z", "DPadLeft" },
	Ability2 = { "X", "DPadUp" },
	Ability3 = { "C", "DPadRight" },
	StyleMenu = { "M" },
	Help = { "H" },
	ShiftLock = "LeftControl", -- Shift занят спринтом, блокировку камеры переносим сюда
}

-- Встроенные звуки Roblox. Можно заменить на свои rbxassetid://...
Config.Sounds = {
	Kick = { Id = "rbxasset://sounds/snap.wav", Volume = 0.9, Pitch = 0.75 },
	PowerKick = { Id = "rbxasset://sounds/Rocket shot.wav", Volume = 0.7, Pitch = 1.25 },
	Pass = { Id = "rbxasset://sounds/snap.wav", Volume = 0.55, Pitch = 1.1 },
	Bounce = { Id = "rbxasset://sounds/bass.wav", Volume = 0.25, Pitch = 1.6 },
	Dash = { Id = "rbxasset://sounds/swordlunge.wav", Volume = 0.5, Pitch = 1.6 },
	Slide = { Id = "rbxasset://sounds/swordslash.wav", Volume = 0.45, Pitch = 0.7 },
	Steal = { Id = "rbxasset://sounds/swordlunge.wav", Volume = 0.6, Pitch = 1 },
	Block = { Id = "rbxasset://sounds/collide.wav", Volume = 0.7, Pitch = 0.9 },
	Whistle = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.6, Pitch = 1.9 },
	Tick = { Id = "rbxasset://sounds/switch.wav", Volume = 0.6, Pitch = 1 },
	Goal = { Id = "rbxasset://sounds/victory.wav", Volume = 0.8, Pitch = 1 },
	Ability = { Id = "rbxasset://sounds/unsheath.wav", Volume = 0.6, Pitch = 1 },
	Ultimate = { Id = "rbxasset://sounds/Rocket whoosh 01.wav", Volume = 0.8, Pitch = 0.8 },
	Click = { Id = "rbxasset://sounds/button.wav", Volume = 0.5, Pitch = 1 },
}

return Config
]]></string>
