				RightKnee = { -10, 0, 0 },
				LeftHip = { 6, 0, -14 },
				LeftKnee = { -10, 0, 0 },
			},
		},
		{ t = 0.95, ease = "quadInOut", pose = REST },
	},
}

-- Празднование гола: присел и выпрыгнул с руками вверх.
R15.Celebrate = {
	length = 1.9,
	fadeIn = 0.1,
	fadeOut = 0.3,
	priority = 4,
	keys = {
